<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GlpiNg.Modules.Inventory</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Permet d'utiliser les types ASP.NET Core (ControllerBase, ApiController, composants
      Razor...) dans cette bibliothèque de classes sans dépendre du projet hôte GlpiNg.Web.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Uniquement les abstractions EF Core (DbContext, DbSet<T>) : ce module ne
      connaît pas le fournisseur (Sqlite/SqlServer) ni le DbContext concret, qui
      restent la responsabilité du projet hôte. Voir Import/GlpiMySqlImportService.cs.
    -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Lextm.SharpSnmpLib" Version="12.5.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <!-- AsSplitQuery() (Components/Pages/Computers/Detail.razor.cs) vit dans le provider
         relationnel plutôt que dans le paquet EF Core de base. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="QuestPDF" Version="2026.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GlpiNg.Modules.Abstractions\GlpiNg.Modules.Abstractions.csproj" />
  </ItemGroup>

</Project>
