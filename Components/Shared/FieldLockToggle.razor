@using GlpiNg.Modules.Inventory.Services

@* Cadenas d'un champ, à poser à côté de son libellé. Verrouillé, l'inventaire n'écrit plus ce
   champ : la valeur saisie à la main fait foi (voir LockedField et InventoryImportService).

   Affiché même déverrouillé, en discret : c'est ce qui fait savoir qu'un champ est alimenté par
   l'agent — donc qu'une correction manuelle y sera écrasée si on ne le verrouille pas. Un cadenas
   qui n'apparaîtrait qu'une fois posé ne l'apprendrait à personne. *@

<button type="button"
        class="btn btn-icon btn-sm glping-field-lock @(IsLocked ? "text-warning" : "text-secondary")"
        title="@(IsLocked
                   ? $"Champ verrouillé : l'inventaire ne met plus à jour « {ComputerLockableFields.Label(Field)} ». Cliquer pour déverrouiller."
                   : $"Champ alimenté par l'inventaire. Cliquer pour le verrouiller et conserver la valeur saisie.")"
        @onclick="() => OnToggle.InvokeAsync(Field)">
    <i class="ti @(IsLocked ? "ti-lock" : "ti-lock-open")"></i>
</button>

@code {
    [Parameter, EditorRequired]
    public string Field { get; set; } = null!;

    [Parameter, EditorRequired]
    public bool IsLocked { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<string> OnToggle { get; set; }
}
