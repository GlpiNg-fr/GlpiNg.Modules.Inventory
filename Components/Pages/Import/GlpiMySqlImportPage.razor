@page "/admin/import/glpi"
@rendermode InteractiveServer

<PageTitle>GlpiNg — Import GLPI</PageTitle>

<div class="page-header d-flex align-items-center justify-content-between mb-3">
    <h2 class="page-title mb-0">Import depuis une base GLPI MySQL</h2>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title"><i class="ti ti-plug-connected me-1"></i>Connexion à la base GLPI source</h3>
    </div>
    <div class="glpi-config">
        <div class="glpi-config-body">
            <EditForm Model="State" OnValidSubmit="AnalyzeAsync" class="glpi-config-form glpi-config-form-wide">
                <div class="glpi-config-field">
                    <label for="glpi-import-server">Adresse du serveur</label>
                    <input id="glpi-import-server" type="text" placeholder="ex. glpi-mysql.exemple.local"
                           @bind="State.Server" disabled="@(State.IsRunning || State.IsAnalyzing)" />
                </div>

                <div class="glpi-config-field">
                    <label for="glpi-import-database">Base de données</label>
                    <input id="glpi-import-database" type="text" placeholder="glpi"
                           @bind="State.Database" disabled="@(State.IsRunning || State.IsAnalyzing)" />
                </div>

                <div class="glpi-config-field">
                    <label for="glpi-import-username">Utilisateur</label>
                    <input id="glpi-import-username" type="text" autocomplete="off"
                           @bind="State.Username" disabled="@(State.IsRunning || State.IsAnalyzing)" />
                </div>

                <div class="glpi-config-field">
                    <label for="glpi-import-password">Mot de passe</label>
                    <input id="glpi-import-password" type="password" autocomplete="off"
                           @bind="State.Password" disabled="@(State.IsRunning || State.IsAnalyzing)" />
                </div>

                <p class="hint">
                    Un compte MySQL en lecture seule est recommandé : ni l'analyse ni l'import ne font
                    d'écriture sur la base GLPI source.
                </p>

                <button type="submit" class="glpi-config-save" disabled="@(!State.CanAnalyze)">
                    @if (State.IsAnalyzing)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Analyse en cours…</span>
                    }
                    else
                    {
                        <span>Analyser</span>
                    }
                </button>
            </EditForm>
        </div>
    </div>
</div>

@if (State.AnalysisError is not null)
{
    <div class="alert alert-danger">
        <i class="ti ti-alert-circle me-1"></i>@State.AnalysisError
    </div>
}

@if (State.Analysis is { } analysis && State.AdminAnalysis is { } adminAnalysis)
{
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title"><i class="ti ti-list-check me-1"></i>Éléments trouvés — que faut-il importer ?</h3>
        </div>
        <div class="card-body">
            @{
                GlpiNg.Modules.Inventory.Import.GlpiInventoryPluginInfo plugin = analysis.InventoryPlugin;
            }

            @* Trois onglets pour trois services d'import distincts (parc, administration, plugin
               d'inventaire), chacun avec son propre interrupteur de titre. Sans lui, cocher une
               dizaine d'éléments un par un est le passage obligé de chaque import. *@
            @{
                (int Selected, int Available) parcTally = ParcTally(analysis);
                (int Selected, int Available) adminTally = AdminTally(adminAnalysis);
                (int Selected, int Available) pluginTally = PluginTally(plugin);
            }

            <ul class="nav nav-tabs glpi-import-tabs mb-3">
                <li class="nav-item">
                    <span class="nav-link @(_tab == ImportTab.Parc ? "active" : "")" role="button" @onclick="() => _tab = ImportTab.Parc">
                        <i class="ti ti-device-desktop"></i>
                        <span>Parc</span>
                        <span class="badge bg-secondary-lt">@parcTally.Selected / @parcTally.Available</span>
                        <label class="glpi-switch" title="Tout activer ou désactiver dans cet onglet"
                               @onclick="() => { }" @onclick:stopPropagation="true">
                            <input type="checkbox" checked="@(parcTally.Available > 0 && parcTally.Selected == parcTally.Available)"
                                   disabled="@(State.IsRunning || parcTally.Available == 0)"
                                   @onchange="@((ChangeEventArgs e) => SetAllParc(analysis, (bool)(e.Value ?? false)))" />
                            <span class="glpi-switch-slider"></span>
                        </label>
                    </span>
                </li>
                <li class="nav-item">
                    <span class="nav-link @(_tab == ImportTab.Administration ? "active" : "")" role="button" @onclick="() => _tab = ImportTab.Administration">
                        <i class="ti ti-users-group"></i>
                        <span>Administration</span>
                        <span class="badge bg-secondary-lt">@adminTally.Selected / @adminTally.Available</span>
                        <label class="glpi-switch" title="Tout activer ou désactiver dans cet onglet"
                               @onclick="() => { }" @onclick:stopPropagation="true">
                            <input type="checkbox" checked="@(adminTally.Available > 0 && adminTally.Selected == adminTally.Available)"
                                   disabled="@(State.IsRunning || adminTally.Available == 0)"
                                   @onchange="@((ChangeEventArgs e) => SetAllAdmin(adminAnalysis, (bool)(e.Value ?? false)))" />
                            <span class="glpi-switch-slider"></span>
                        </label>
                    </span>
                </li>
                <li class="nav-item">
                    <span class="nav-link @(_tab == ImportTab.Plugin ? "active" : "")" role="button" @onclick="() => _tab = ImportTab.Plugin">
                        <i class="ti ti-plug"></i>
                        <span>Plugin d'inventaire</span>
                        @if (plugin.IsPresent)
                        {
                            <span class="badge bg-secondary-lt">@pluginTally.Selected / @pluginTally.Available</span>
                            <label class="glpi-switch" title="Tout activer ou désactiver dans cet onglet"
                                   @onclick="() => { }" @onclick:stopPropagation="true">
                                <input type="checkbox" checked="@(pluginTally.Available > 0 && pluginTally.Selected == pluginTally.Available)"
                                       disabled="@(State.IsRunning || pluginTally.Available == 0)"
                                       @onchange="@((ChangeEventArgs e) => SetAllPlugin(plugin, (bool)(e.Value ?? false)))" />
                                <span class="glpi-switch-slider"></span>
                            </label>
                        }
                        else
                        {
                            <span class="badge bg-secondary-lt">absent</span>
                        }
                    </span>
                </li>
            </ul>

            @if (_tab == ImportTab.Parc)
            {
                <div class="glpi-config-field-grid">
                    <div class="glpi-config-field checkbox">
                        <label for="glpi-import-sel-computers"><i class="ti ti-device-desktop me-2"></i>Ordinateurs (@analysis.ComputersCount)</label>
                        <label class="glpi-switch">
                            <input id="glpi-import-sel-computers" type="checkbox" @bind="State.Selection.ImportComputers"
                                   disabled="@(State.IsRunning || analysis.ComputersCount == 0)" />
                            <span class="glpi-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glpi-config-field checkbox">
                        <label for="glpi-import-sel-monitors"><i class="ti ti-device-tv me-2"></i>Moniteurs (@analysis.MonitorsCount)</label>
                        <label class="glpi-switch">
                            <input id="glpi-import-sel-monitors" type="checkbox" @bind="State.Selection.ImportMonitors"
                                   disabled="@(State.IsRunning || analysis.MonitorsCount == 0)" />
                            <span class="glpi-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glpi-config-field checkbox">
                        <label for="glpi-import-sel-agents"><i class="ti ti-robot me-2"></i>Agents (@analysis.AgentsCount)</label>
                        <label class="glpi-switch">
                            <input id="glpi-import-sel-agents" type="checkbox" @bind="State.Selection.ImportAgents"
                                   disabled="@(State.IsRunning || analysis.AgentsCount == 0)" />
                            <span class="glpi-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glpi-config-field checkbox">
                        <label for="glpi-import-sel-components"><i class="ti ti-cpu me-2"></i>Composants matériels (@analysis.ComponentsCount)</label>
                        <label class="glpi-switch">
                            <input id="glpi-import-sel-components" type="checkbox" @bind="State.Selection.ImportComponents"
                                   disabled="@(State.IsRunning || analysis.ComponentsCount == 0)" />
                            <span class="glpi-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glpi-config-field checkbox">
                        <label for="glpi-import-sel-softwares"><i class="ti ti-apps me-2"></i>Logiciels (@analysis.SoftwaresCount)</label>
                        <label class="glpi-switch">
                            <input id="glpi-import-sel-softwares" type="checkbox" @bind="State.Selection.ImportSoftwares"
                                   disabled="@(State.IsRunning || analysis.SoftwaresCount == 0)" />
                            <span class="glpi-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glpi-config-field checkbox">
                        <label for="glpi-import-sel-printers"><i class="ti ti-printer me-2"></i>Imprimantes (@analysis.PrintersCount)</label>
                        <label class="glpi-switch">
                            <input id="glpi-import-sel-printers" type="checkbox" @bind="State.Selection.ImportPrinters"
                                   disabled="@(State.IsRunning || analysis.PrintersCount == 0)" />
                            <span class="glpi-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glpi-config-field checkbox">
                        <label for="glpi-import-sel-peripherals"><i class="ti ti-mouse me-2"></i>Périphériques (@analysis.PeripheralsCount)</label>
                        <label class="glpi-switch">
                            <input id="glpi-import-sel-peripherals" type="checkbox" @bind="State.Selection.ImportPeripherals"
                                   disabled="@(State.IsRunning || analysis.PeripheralsCount == 0)" />
                            <span class="glpi-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glpi-config-field checkbox">
                        <label for="glpi-import-sel-volumes"><i class="ti ti-server-2 me-2"></i>Volumes (@analysis.VolumesCount)</label>
                        <label class="glpi-switch">
                            <input id="glpi-import-sel-volumes" type="checkbox" @bind="State.Selection.ImportVolumes"
                                   disabled="@(State.IsRunning || analysis.VolumesCount == 0)" />
                            <span class="glpi-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glpi-config-field checkbox">
                        <label for="glpi-import-sel-batteries"><i class="ti ti-battery me-2"></i>Batteries (@analysis.BatteriesCount)</label>
                        <label class="glpi-switch">
                            <input id="glpi-import-sel-batteries" type="checkbox" @bind="State.Selection.ImportBatteries"
                                   disabled="@(State.IsRunning || analysis.BatteriesCount == 0)" />
                            <span class="glpi-switch-slider"></span>
                        </label>
                    </div>
                </div>

                <p class="hint mt-2">
                    CPU : @analysis.CpuCount · RAM : @analysis.RamCount · Disques : @analysis.DiskCount ·
                    Cartes réseau : @analysis.NetworkCardCount
                </p>
            }

            @if (_tab == ImportTab.Administration)
            {
                <div class="glpi-config-field-grid">
                    <div class="glpi-config-field checkbox">
                        <label for="glpi-import-sel-entities"><i class="ti ti-building me-2"></i>Entités (@adminAnalysis.EntitiesCount)</label>
                        <label class="glpi-switch">
                            <input id="glpi-import-sel-entities" type="checkbox" @bind="State.AdminSelection.ImportEntities"
                                   disabled="@(State.IsRunning || adminAnalysis.EntitiesCount == 0)" />
                            <span class="glpi-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glpi-config-field checkbox">
                        <label for="glpi-import-sel-groups"><i class="ti ti-users me-2"></i>Groupes (@adminAnalysis.GroupsCount)</label>
                        <label class="glpi-switch">
                            <input id="glpi-import-sel-groups" type="checkbox" @bind="State.AdminSelection.ImportGroups"
                                   disabled="@(State.IsRunning || adminAnalysis.GroupsCount == 0)" />
                            <span class="glpi-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glpi-config-field checkbox">
                        <label for="glpi-import-sel-profiles"><i class="ti ti-shield-lock me-2"></i>Profils (@adminAnalysis.ProfilesCount)</label>
                        <label class="glpi-switch">
                            <input id="glpi-import-sel-profiles" type="checkbox" @bind="State.AdminSelection.ImportProfiles"
                                   disabled="@(State.IsRunning || adminAnalysis.ProfilesCount == 0)" />
                            <span class="glpi-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glpi-config-field checkbox">
                        <label for="glpi-import-sel-users"><i class="ti ti-user me-2"></i>Utilisateurs (@adminAnalysis.UsersCount)</label>
                        <label class="glpi-switch">
                            <input id="glpi-import-sel-users" type="checkbox" @bind="State.AdminSelection.ImportUsers"
                                   disabled="@(State.IsRunning || adminAnalysis.UsersCount == 0)" />
                            <span class="glpi-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glpi-config-field checkbox">
                        <label for="glpi-import-sel-config"><i class="ti ti-settings me-2"></i>Configuration générale</label>
                        <label class="glpi-switch">
                            <input id="glpi-import-sel-config" type="checkbox" @bind="State.AdminSelection.ImportGeneralConfig"
                                   disabled="@(State.IsRunning || !adminAnalysis.GeneralConfigAvailable)" />
                            <span class="glpi-switch-slider"></span>
                        </label>
                    </div>
                </div>

                <p class="hint mt-2">
                    Profils : seuls le nom, le commentaire et le statut par défaut sont importés (les droits fins par
                    module ne le sont pas — à configurer manuellement). Configuration générale : uniquement les
                    réglages ayant un équivalent direct dans "Configuration générale" &gt; "Général".
                </p>
            }

            @if (_tab == ImportTab.Plugin)
            {
                @* Le plugin porte, côté GLPI, le domaine que GlpiNg réimplémente en propre
                   (déploiement, découverte réseau). L'onglet dit d'abord ce qui a été trouvé, puis
                   propose de le reprendre — dans cet ordre, parce qu'on ne choisit pas avant de
                   savoir ce qu'il y a. *@
                @if (!plugin.IsPresent)
                {
                    <div class="glpi-config-placeholder">
                        <i class="ti ti-plug-off"></i>
                        <p class="mb-0">Aucun plugin d'inventaire (GLPI Inventory ou FusionInventory) sur cette base.</p>
                    </div>
                }
                else
                {
                    <div class="glpi-import-plugin-head">
                        <i class="ti ti-plug"></i>
                        <div>
                            <div class="glpi-import-plugin-name">
                                @(plugin.Name ?? plugin.Directory)
                                @if (plugin.Version is { Length: > 0 } version)
                                {
                                    <span class="badge bg-blue-lt">@version</span>
                                }
                                @if (plugin.State is not null && !plugin.IsActive)
                                {
                                    <span class="badge bg-orange-lt" title="Installé mais désactivé côté GLPI : ses données restent en base.">désactivé</span>
                                }
                            </div>
                            <div class="text-secondary small">
                                @plugin.TableCount table(s) <code>@plugin.TablePrefix*</code> dans la base source.
                            </div>
                        </div>
                    </div>

                    @if (plugin.IsRegisteredWithoutTables)
                    {
                        <p class="text-secondary">
                            Déclaré dans <code>glpi_plugins</code> mais aucune de ses tables n'est présente :
                            plugin désinstallé, ou export partiel de la base. Rien à reprendre.
                        </p>
                    }
                    else
                    {
                        <p class="hint" style="margin-left:0;">
                            GlpiNg gère ce domaine en propre (Outils &gt; Déploiements). Rien n'est repris sans
                            choix explicite, contrairement au parc et à l'administration.
                        </p>

                        @* Les quatre catégories d'un bloc, sans rien qui les sépare : la liste doit se
                           lire d'un coup d'œil. Ce que la sélection des paquets ouvre en plus vient
                           après, dans sa propre section. *@
                        <div class="glpi-config-field-grid">
                            <div class="glpi-config-field checkbox">
                                <label for="glpi-import-sel-ipranges"><i class="ti ti-network me-2"></i>Plages IP (@plugin.IpRangesCount)</label>
                                <label class="glpi-switch">
                                    <input id="glpi-import-sel-ipranges" type="checkbox" @bind="State.PluginSelection.ImportIpRanges"
                                           disabled="@(State.IsRunning || plugin.IpRangesCount == 0)" />
                                    <span class="glpi-switch-slider"></span>
                                </label>
                            </div>

                            <div class="glpi-config-field checkbox">
                                <label for="glpi-import-sel-snmp"><i class="ti ti-key me-2"></i>Identifiants SNMP (@plugin.SnmpCredentialsCount)</label>
                                <label class="glpi-switch">
                                    <input id="glpi-import-sel-snmp" type="checkbox" @bind="State.PluginSelection.ImportSnmpCredentials"
                                           disabled="@(State.IsRunning || plugin.SnmpCredentialsCount == 0)" />
                                    <span class="glpi-switch-slider"></span>
                                </label>
                            </div>

                            <div class="glpi-config-field checkbox">
                                <label for="glpi-import-sel-packages"><i class="ti ti-package me-2"></i>Paquets de déploiement (@plugin.DeployPackagesCount)</label>
                                <label class="glpi-switch">
                                    <input id="glpi-import-sel-packages" type="checkbox" @bind="State.PluginSelection.ImportDeployPackages"
                                           disabled="@(State.IsRunning || plugin.DeployPackagesCount == 0)" />
                                    <span class="glpi-switch-slider"></span>
                                </label>
                            </div>

                            <div class="glpi-config-field checkbox">
                                <label for="glpi-import-sel-unmanaged"><i class="ti ti-help me-2"></i>Actifs non gérés (@plugin.UnmanagedDevicesCount)</label>
                                <label class="glpi-switch">
                                    <input id="glpi-import-sel-unmanaged" type="checkbox" @bind="State.PluginSelection.ImportUnmanagedDevices"
                                           disabled="@(State.IsRunning || plugin.UnmanagedDevicesCount == 0)" />
                                    <span class="glpi-switch-slider"></span>
                                </label>
                            </div>
                        </div>

                        @if (State.PluginSelection.ImportDeployPackages)
                        {
                            @* Section à part, et non deux champs glissés dans la grille des
                               interrupteurs : ce ne sont pas des catégories à cocher mais le
                               réglage d'une seule d'entre elles, et les mêler couperait la liste
                               en deux. *@
                            <div class="glpi-config-divider">
                                <span><i class="ti ti-file-download"></i> Contenu des fichiers de paquets</span>
                            </div>

                            <p class="hint" style="margin-left:0;">
                                Les octets d'un fichier de paquet ne sont pas dans la base GLPI : ils vivent sur le
                                disque de son serveur. Sans l'une de ces deux sources, les fichiers sont seulement
                                déclarés, et le paquet reste non déployable tant qu'ils n'ont pas été téléversés
                                depuis sa fiche.
                            </p>

                            <div class="glpi-config-field">
                                <label for="glpi-import-files-path">Répertoire des fichiers du plugin</label>
                                <input id="glpi-import-files-path" type="text" class="glpi-config-input"
                                       placeholder="\\serveur-glpi\glpi\files\_plugins\glpiinventory\files"
                                       @bind="State.DeployFilesPath" disabled="@State.IsRunning" />
                            </div>
                            <p class="hint">Chemin local ou partage réseau, vu depuis la machine GlpiNg. Route principale.</p>

                            @* Optionnels : un partage déjà accessible au compte sous lequel tourne
                               GlpiNg n'en a pas besoin. Ils ne servent qu'aux chemins UNC — sur un
                               chemin local ils sont simplement ignorés. *@
                            <div class="glpi-config-field">
                                <label for="glpi-import-files-user">Identifiant du partage <span class="text-secondary">(optionnel)</span></label>
                                <input id="glpi-import-files-user" type="text" class="glpi-config-input"
                                       placeholder="DOMAINE\utilisateur"
                                       @bind="State.DeployFilesUserName" disabled="@State.IsRunning" />
                            </div>

                            <div class="glpi-config-field">
                                <label for="glpi-import-files-password">Mot de passe du partage</label>
                                <input id="glpi-import-files-password" type="password" class="glpi-config-input"
                                       autocomplete="new-password"
                                       @bind="State.DeployFilesPassword" disabled="@State.IsRunning" />
                            </div>
                            <p class="hint">
                                À renseigner seulement si le compte sous lequel tourne GlpiNg n'a pas accès au
                                partage. Utilisés le temps de l'import et jamais enregistrés.
                            </p>

                            <div class="glpi-config-field">
                                <label for="glpi-import-base-url">URL de GLPI</label>
                                <input id="glpi-import-base-url" type="text" class="glpi-config-input"
                                       placeholder="https://glpi.exemple.local"
                                       @bind="State.GlpiBaseUrl" disabled="@State.IsRunning" />
                            </div>
                            <p class="hint">
                                @if (plugin.UrlBase is { Length: > 0 })
                                {
                                    @* Dire d'où vient la valeur : un champ pré-rempli sans explication laisse
                                       douter de ce qu'il contient. *@
                                    <text>Pré-remplie depuis la base source (<code>glpi_configs.url_base</code>), modifiable. </text>
                                }
                                Essayée en repli, fichier par fichier, quand le répertoire ne rend rien.
                            </p>

                            @* Le point d'accès qui rend un fichier entier (front/deployfile_download.php)
                               vérifie un droit GLPI : sans compte, la route HTTP ne peut rien récupérer
                               d'autre que ce qu'un miroir statique expose. *@
                            <div class="glpi-config-field">
                                <label for="glpi-import-web-user">Compte GLPI <span class="text-secondary">(optionnel)</span></label>
                                <input id="glpi-import-web-user" type="text" class="glpi-config-input"
                                       placeholder="compte ayant le droit de lecture sur les paquets"
                                       @bind="State.GlpiUserName" disabled="@State.IsRunning" />
                            </div>

                            <div class="glpi-config-field">
                                <label for="glpi-import-web-password">Mot de passe GLPI</label>
                                <input id="glpi-import-web-password" type="password" class="glpi-config-input"
                                       autocomplete="new-password"
                                       @bind="State.GlpiPassword" disabled="@State.IsRunning" />
                            </div>
                            <p class="hint">
                                Ouvre une session web le temps de l'import. Sans lui, l'URL ci-dessus ne sert qu'aux
                                miroirs. Utilisés le temps de l'import et jamais enregistrés.
                            </p>

                            @if (plugin.MirrorUrls.Count > 0)
                            {
                                <p class="hint">
                                    <i class="ti ti-server me-1"></i>
                                    @plugin.MirrorUrls.Count serveur(s) de miroir déclaré(s) dans le plugin, essayé(s)
                                    avant la session GLPI : @string.Join(", ", plugin.MirrorUrls.Take(3))@(plugin.MirrorUrls.Count > 3 ? ", …" : "").
                                </p>
                            }

                            <p class="hint">
                                Chaque contenu récupéré, par quelque route que ce soit, est vérifié par son empreinte
                                avant d'être enregistré.
                            </p>
                        }

                        <div class="glpi-config-divider">
                            <span><i class="ti ti-ban"></i> Non repris</span>
                        </div>

                        <p class="hint" style="margin-left:0;">
                            Tâches du plugin (@plugin.TasksCount) : sans équivalent direct, à recréer dans
                            Outils &gt; Déploiements. Agents (@plugin.AgentsCount) : déjà couverts par la catégorie
                            « Agents » de l'onglet Parc (<code>glpi_agents</code>, table du cœur de GLPI).
                        </p>
                    }
                }
            }

            <button type="button" class="glpi-config-save mt-2" disabled="@(!State.CanRun)" @onclick="RunImportAsync">
                @if (State.IsRunning)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>Import en cours…</span>
                }
                else
                {
                    <i class="ti ti-database-import me-1"></i>
                    <span>Lancer l'import</span>
                }
            </button>
        </div>
    </div>
}

<div class="card">
    <div class="card-body">
        <p class="text-secondary">
            L'import est en lecture seule et idempotent : un poste déjà importé (identifié par son
            <code>glpi_computers.id</code> d'origine) est mis à jour plutôt que dupliqué.
        </p>

        @if (State.IsRunning)
        {
            <div class="alert alert-info">
                <i class="ti ti-info-circle me-1"></i>
                Un import est en cours (peut-être déclenché par un autre administrateur) — cette page se
                mettra à jour automatiquement pour tous les admins connectés dès qu'il sera terminé.
            </div>

            <div class="d-flex justify-content-between align-items-baseline mb-1">
                <span class="fw-medium text-truncate">
                    <i class="ti ti-loader-2 glpi-spin me-1"></i>@(State.CurrentPhase ?? "Préparation…")
                    @if (State.CurrentDetail is { Length: > 0 } detail)
                    {
                        @* Ce qui se passe quand le compteur, lui, ne bouge pas — le téléchargement
                           d'un fichier de paquet peut durer des minutes. *@
                        <span class="text-secondary fw-normal ms-1">— @detail</span>
                    }
                </span>
                @if (State.ProgressTotal > 0)
                {
                    <span class="text-secondary small">
                        @State.ProgressCompleted.ToString("N0") / @State.ProgressTotal.ToString("N0") élément(s) — @State.ProgressPercent&nbsp;%
                    </span>
                }
            </div>

            @* Barre déterminée tant que l'analyse a pu chiffrer le travail, indéterminée sinon : une
               barre qui affiche un pourcentage inventé serait pire qu'une barre qui ne promet rien. *@
            <div class="progress mb-3" style="height: 0.75rem;">
                @if (State.ProgressTotal > 0)
                {
                    <div class="progress-bar" role="progressbar" style="width: @(State.ProgressPercent)%"
                         aria-valuenow="@State.ProgressPercent" aria-valuemin="0" aria-valuemax="100"></div>
                }
                else
                {
                    <div class="progress-bar glpi-progress-indeterminate"></div>
                }
            </div>
        }

        @if (State.LastError is not null)
        {
            <div class="alert alert-danger">
                <i class="ti ti-alert-circle me-1"></i>@State.LastError
            </div>
        }

        @if (State.LastResult is { } result)
        {
            <div class="alert alert-success">
                <i class="ti ti-check me-1"></i>
                Dernier import terminé en @result.Duration.TotalSeconds.ToString("0.0") s
                @if (State.LastRunAt is { } lastRunAt)
                {
                    <span>(le @lastRunAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</span>
                }
            </div>

            <div class="row row-cards mb-3">
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@result.ComputersCreated</div>
                            <div class="text-secondary">Postes créés</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@result.ComputersUpdated</div>
                            <div class="text-secondary">Postes mis à jour</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@result.MonitorsImported</div>
                            <div class="text-secondary">Moniteurs importés</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@(result.AgentsCreated + result.AgentsUpdated)</div>
                            <div class="text-secondary">Agents (@result.AgentsCreated créés)</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@result.ComponentsImported</div>
                            <div class="text-secondary">Composants importés</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@result.SoftwaresImported</div>
                            <div class="text-secondary">Logiciels importés</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@result.PrintersImported</div>
                            <div class="text-secondary">Imprimantes importées</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@result.PeripheralsImported</div>
                            <div class="text-secondary">Périphériques importés</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@result.VolumesImported</div>
                            <div class="text-secondary">Volumes importés</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@result.BatteriesImported</div>
                            <div class="text-secondary">Batteries importées</div>
                        </div>
                    </div>
                </div>
            </div>

            @if (result.Warnings.Count > 0)
            {
                <div class="glpi-fiche-block-title"><i class="ti ti-alert-triangle"></i>Avertissements</div>
                <ul>
                    @foreach (string warning in result.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            }
        }

        @if (State.LastAdminError is not null)
        {
            <div class="alert alert-danger">
                <i class="ti ti-alert-circle me-1"></i>@State.LastAdminError
            </div>
        }

        @if (State.LastAdminResult is { } adminResult)
        {
            <div class="row row-cards mb-3">
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@(adminResult.EntitiesCreated + adminResult.EntitiesUpdated)</div>
                            <div class="text-secondary">Entités (@adminResult.EntitiesCreated créées)</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@(adminResult.GroupsCreated + adminResult.GroupsUpdated)</div>
                            <div class="text-secondary">Groupes (@adminResult.GroupsCreated créés)</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@(adminResult.ProfilesCreated + adminResult.ProfilesUpdated)</div>
                            <div class="text-secondary">Profils (@adminResult.ProfilesCreated créés)</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@(adminResult.UsersCreated + adminResult.UsersUpdated)</div>
                            <div class="text-secondary">Utilisateurs (@adminResult.UsersCreated créés)</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@adminResult.GeneralConfigKeysImported</div>
                            <div class="text-secondary">Réglages généraux importés</div>
                        </div>
                    </div>
                </div>
            </div>

            @if (adminResult.Warnings.Count > 0)
            {
                <div class="glpi-fiche-block-title"><i class="ti ti-alert-triangle"></i>Avertissements (Administration)</div>
                <ul>
                    @foreach (string warning in adminResult.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            }
        }

        @if (State.LastPluginError is not null)
        {
            <div class="alert alert-danger">
                <i class="ti ti-alert-circle me-1"></i>@State.LastPluginError
            </div>
        }

        @if (State.LastPluginResult is { } pluginResult)
        {
            <div class="row row-cards mb-3">
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@(pluginResult.IpRangesCreated + pluginResult.IpRangesUpdated)</div>
                            <div class="text-secondary">Plages IP (@pluginResult.IpRangesCreated créées)</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@(pluginResult.SnmpCredentialsCreated + pluginResult.SnmpCredentialsUpdated)</div>
                            <div class="text-secondary">Identifiants SNMP (@pluginResult.SnmpCredentialsCreated créés)</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@(pluginResult.DeployPackagesCreated + pluginResult.DeployPackagesUpdated)</div>
                            <div class="text-secondary">Paquets (@pluginResult.DeployPackagesCreated créés)</div>
                            @* Le contenu repris compte autant que le nombre de paquets : c'est lui
                               qu'on ne veut pas ressaisir. *@
                            <div class="text-secondary small mt-1">
                                @pluginResult.DeployPackageChecksImported vérification(s), @pluginResult.DeployPackageActionsImported action(s)
                            </div>
                            @if (pluginResult.DeployPackageFilesCreated + pluginResult.DeployPackageFilesUpdated > 0)
                            {
                                <div class="text-secondary small">
                                    @(pluginResult.DeployPackageFilesCreated + pluginResult.DeployPackageFilesUpdated) fichier(s)
                                </div>
                            }
                            @if (pluginResult.DeployPackageFilesDownloaded > 0)
                            {
                                <div class="text-success small">
                                    <i class="ti ti-download me-1"></i>@pluginResult.DeployPackageFilesDownloaded contenu(s) récupéré(s)
                                </div>
                            }
                            @if (pluginResult.DeployPackageFilesPending > 0)
                            {
                                <div class="text-warning small">
                                    <i class="ti ti-upload me-1"></i>@pluginResult.DeployPackageFilesPending sans contenu
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@(pluginResult.UnmanagedDevicesCreated + pluginResult.UnmanagedDevicesUpdated)</div>
                            <div class="text-secondary">Actifs non gérés (@pluginResult.UnmanagedDevicesCreated créés)</div>
                        </div>
                    </div>
                </div>
            </div>

            @if (pluginResult.Warnings.Count > 0)
            {
                <div class="glpi-fiche-block-title"><i class="ti ti-alert-triangle"></i>Avertissements (plugin d'inventaire)</div>
                <ul>
                    @foreach (string warning in pluginResult.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            }
        }
    </div>
</div>
