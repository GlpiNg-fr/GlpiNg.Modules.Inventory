@page "/admin/import/glpi"
@rendermode InteractiveServer

<PageTitle>@T("Import GLPI — GlpiNg")</PageTitle>

<div class="page-header d-flex align-items-center justify-content-between mb-3">
    <h2 class="page-title mb-0">@T("Import depuis une base GLPI MySQL")</h2>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title"><i class="ti ti-plug-connected me-1"></i>@T("Connexion à la base GLPI source")</h3>
    </div>
    <div class="glping-config">
        <div class="glping-config-body">
            <EditForm Model="State" OnValidSubmit="AnalyzeAsync" class="glping-config-form glping-config-form-wide">
                <div class="glping-config-field">
                    <label for="glping-import-server">@T("Adresse du serveur")</label>
                    <input id="glping-import-server" type="text" placeholder="@(T("ex. glping-mysql.exemple.local"))"
                           @bind="State.Server" disabled="@(State.IsRunning || State.IsAnalyzing)" />
                </div>

                <div class="glping-config-field">
                    <label for="glping-import-database">@T("Base de données")</label>
                    <input id="glping-import-database" type="text" placeholder="@(T("glpi"))"
                           @bind="State.Database" disabled="@(State.IsRunning || State.IsAnalyzing)" />
                </div>

                <div class="glping-config-field">
                    <label for="glping-import-username">@T("Utilisateur")</label>
                    <input id="glping-import-username" type="text" autocomplete="off"
                           @bind="State.Username" disabled="@(State.IsRunning || State.IsAnalyzing)" />
                </div>

                <div class="glping-config-field">
                    <label for="glping-import-password">@T("Mot de passe")</label>
                    <input id="glping-import-password" type="password" autocomplete="off"
                           @bind="State.Password" disabled="@(State.IsRunning || State.IsAnalyzing)" />
                </div>

                <p class="hint">
                    @T("Un compte MySQL en lecture seule est recommandé : ni l'analyse ni l'import ne font d'écriture sur la base GLPI source.")
                </p>

                @* Saisi avec la connexion, et non dans chaque section : c'est une propriété de
                   l'installation source au même titre que son serveur. Tout ce que l'import va
                   chercher sur disque en descend — les documents directement, les fichiers de
                   paquets sous _plugins/. *@
                <div class="glping-config-divider">
                    <span><i class="ti ti-folder"></i> @T("Fichiers de l'installation GLPI")</span>
                </div>

                <p class="hint" style="margin-left:0;">
                    @T("GLPI ne range pas ses fichiers en base : seuls leurs chemins y figurent. Sans ce dossier, documents et fichiers de paquets sont repris en fiches, mais sans contenu téléchargeable.")
                </p>

                <div class="glping-config-field">
                    <label for="glping-import-files-root">Dossier <code>files/</code> de GLPI</label>
                    <input id="glping-import-files-root" type="text" class="glping-config-input"
                           placeholder="@(T("/var/www/glpi/files"))"
                           @bind="State.GlpiFilesPath" disabled="@State.IsRunning" />
                </div>
                <p class="hint">@T("Chemin local ou partage réseau (UNC), vu depuis la machine GlpiNg.")</p>

                @* Optionnels : un partage déjà accessible au compte sous lequel tourne GlpiNg n'en
                   a pas besoin. Ils ne servent qu'aux chemins UNC — sur un chemin local ils sont
                   simplement ignorés. *@
                <div class="glping-config-field">
                    <label for="glping-import-files-user">@T("Identifiant du partage") <span class="text-secondary">@T("(optionnel)")</span></label>
                    <input id="glping-import-files-user" type="text" class="glping-config-input"
                           placeholder="@(T("DOMAINE\\utilisateur"))"
                           @bind="State.GlpiFilesUserName" disabled="@State.IsRunning" />
                </div>

                <div class="glping-config-field">
                    <label for="glping-import-files-password">@T("Mot de passe du partage")</label>
                    <input id="glping-import-files-password" type="password" class="glping-config-input"
                           autocomplete="new-password"
                           @bind="State.GlpiFilesPassword" disabled="@State.IsRunning" />
                </div>
                <p class="hint">
                    @T("À renseigner seulement si le compte sous lequel tourne GlpiNg n'a pas accès au partage. Utilisés le temps de l'import et jamais enregistrés. L'authentification d'un partage réseau n'est possible que sous Windows ; ailleurs, montez-le avant de lancer l'import.")
                </p>

                <button type="submit" class="glping-config-save" disabled="@(!State.CanAnalyze)">
                    @if (State.IsAnalyzing)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>@T("Analyse en cours…")</span>
                    }
                    else
                    {
                        <span>@T("Analyser")</span>
                    }
                </button>
            </EditForm>
        </div>
    </div>
</div>

@if (State.AnalysisError is not null)
{
    <div class="alert alert-danger">
        <i class="ti ti-alert-circle me-1"></i>@State.AnalysisError
    </div>
}

@if (State.Analysis is { } analysis && State.AdminAnalysis is { } adminAnalysis)
{
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title"><i class="ti ti-list-check me-1"></i>@T("Éléments trouvés — que faut-il importer ?")</h3>
        </div>
        <div class="card-body">
            @{
                GlpiNg.Modules.Inventory.Import.GlpiInventoryPluginInfo plugin = analysis.InventoryPlugin;
            }

            @* Trois onglets pour trois services d'import distincts (parc, administration, plugin
               d'inventaire), chacun avec son propre interrupteur de titre. Sans lui, cocher une
               dizaine d'éléments un par un est le passage obligé de chaque import. *@
            @{
                (int Selected, int Available) parcTally = ParcTally(analysis);
                (int Selected, int Available) adminTally = AdminTally(adminAnalysis);
                (int Selected, int Available) knowledgeBaseTally = State.KnowledgeBaseAnalysis is { } kbAnalysis
                    ? KnowledgeBaseTally(kbAnalysis)
                    : (0, 0);
                (int Selected, int Available) pluginTally = PluginTally(plugin);
            }

            <ul class="nav nav-tabs glping-import-tabs mb-3">
                <li class="nav-item">
                    <span class="nav-link @(_tab == ImportTab.Parc ? "active" : "")" role="button" @onclick="() => _tab = ImportTab.Parc">
                        <i class="ti ti-device-desktop"></i>
                        <span>@T("Parc")</span>
                        <span class="badge bg-secondary-lt">@parcTally.Selected / @parcTally.Available</span>
                        <label class="glping-switch" title="@(T("Tout activer ou désactiver dans cet onglet"))"
                               @onclick="() => { }" @onclick:stopPropagation="true">
                            <input type="checkbox" checked="@(parcTally.Available > 0 && parcTally.Selected == parcTally.Available)"
                                   disabled="@(State.IsRunning || parcTally.Available == 0)"
                                   @onchange="@((ChangeEventArgs e) => SetAllParc(analysis, (bool)(e.Value ?? false)))" />
                            <span class="glping-switch-slider"></span>
                        </label>
                    </span>
                </li>
                <li class="nav-item">
                    <span class="nav-link @(_tab == ImportTab.Administration ? "active" : "")" role="button" @onclick="() => _tab = ImportTab.Administration">
                        <i class="ti ti-users-group"></i>
                        <span>@T("Administration")</span>
                        <span class="badge bg-secondary-lt">@adminTally.Selected / @adminTally.Available</span>
                        <label class="glping-switch" title="@(T("Tout activer ou désactiver dans cet onglet"))"
                               @onclick="() => { }" @onclick:stopPropagation="true">
                            <input type="checkbox" checked="@(adminTally.Available > 0 && adminTally.Selected == adminTally.Available)"
                                   disabled="@(State.IsRunning || adminTally.Available == 0)"
                                   @onchange="@((ChangeEventArgs e) => SetAllAdmin(adminAnalysis, (bool)(e.Value ?? false)))" />
                            <span class="glping-switch-slider"></span>
                        </label>
                    </span>
                </li>
                <li class="nav-item">
                    <span class="nav-link @(_tab == ImportTab.KnowledgeBase ? "active" : "")" role="button" @onclick="() => _tab = ImportTab.KnowledgeBase">
                        <i class="ti ti-book"></i>
                        <span>@T("Base de connaissances")</span>
                        @if (State.KnowledgeBaseAnalysis is { IsPresent: true } kbTab)
                        {
                            <span class="badge bg-secondary-lt">@knowledgeBaseTally.Selected / @knowledgeBaseTally.Available</span>
                            <label class="glping-switch" title="@(T("Tout activer ou désactiver dans cet onglet"))"
                                   @onclick="() => { }" @onclick:stopPropagation="true">
                                <input type="checkbox" checked="@(knowledgeBaseTally.Available > 0 && knowledgeBaseTally.Selected == knowledgeBaseTally.Available)"
                                       disabled="@(State.IsRunning || knowledgeBaseTally.Available == 0)"
                                       @onchange="@((ChangeEventArgs e) => SetAllKnowledgeBase(kbTab, (bool)(e.Value ?? false)))" />
                                <span class="glping-switch-slider"></span>
                            </label>
                        }
                        else
                        {
                            <span class="badge bg-secondary-lt">@T("absente")</span>
                        }
                    </span>
                </li>
                <li class="nav-item">
                    <span class="nav-link @(_tab == ImportTab.Plugin ? "active" : "")" role="button" @onclick="() => _tab = ImportTab.Plugin">
                        <i class="ti ti-plug"></i>
                        <span>@T("Plugin d'inventaire")</span>
                        @if (plugin.IsPresent)
                        {
                            <span class="badge bg-secondary-lt">@pluginTally.Selected / @pluginTally.Available</span>
                            <label class="glping-switch" title="@(T("Tout activer ou désactiver dans cet onglet"))"
                                   @onclick="() => { }" @onclick:stopPropagation="true">
                                <input type="checkbox" checked="@(pluginTally.Available > 0 && pluginTally.Selected == pluginTally.Available)"
                                       disabled="@(State.IsRunning || pluginTally.Available == 0)"
                                       @onchange="@((ChangeEventArgs e) => SetAllPlugin(plugin, (bool)(e.Value ?? false)))" />
                                <span class="glping-switch-slider"></span>
                            </label>
                        }
                        else
                        {
                            <span class="badge bg-secondary-lt">@T("absent")</span>
                        }
                    </span>
                </li>
            </ul>

            @if (_tab == ImportTab.Parc)
            {
                <div class="glping-config-field-grid">
                    <div class="glping-config-field checkbox">
                        <label for="glping-import-sel-computers"><i class="ti ti-device-desktop me-2"></i>@T("Ordinateurs ({0})", analysis.ComputersCount)</label>
                        <label class="glping-switch">
                            <input id="glping-import-sel-computers" type="checkbox" @bind="State.Selection.ImportComputers"
                                   disabled="@(State.IsRunning || analysis.ComputersCount == 0)" />
                            <span class="glping-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glping-config-field checkbox">
                        <label for="glping-import-sel-monitors"><i class="ti ti-device-tv me-2"></i>@T("Moniteurs ({0})", analysis.MonitorsCount)</label>
                        <label class="glping-switch">
                            <input id="glping-import-sel-monitors" type="checkbox" @bind="State.Selection.ImportMonitors"
                                   disabled="@(State.IsRunning || analysis.MonitorsCount == 0)" />
                            <span class="glping-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glping-config-field checkbox">
                        <label for="glping-import-sel-agents"><i class="ti ti-robot me-2"></i>@T("Agents ({0})", analysis.AgentsCount)</label>
                        <label class="glping-switch">
                            <input id="glping-import-sel-agents" type="checkbox" @bind="State.Selection.ImportAgents"
                                   disabled="@(State.IsRunning || analysis.AgentsCount == 0)" />
                            <span class="glping-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glping-config-field checkbox">
                        <label for="glping-import-sel-components"><i class="ti ti-cpu me-2"></i>@T("Composants matériels ({0})", analysis.ComponentsCount)</label>
                        <label class="glping-switch">
                            <input id="glping-import-sel-components" type="checkbox" @bind="State.Selection.ImportComponents"
                                   disabled="@(State.IsRunning || analysis.ComponentsCount == 0)" />
                            <span class="glping-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glping-config-field checkbox">
                        <label for="glping-import-sel-softwares"><i class="ti ti-apps me-2"></i>@T("Logiciels ({0})", analysis.SoftwaresCount)</label>
                        <label class="glping-switch">
                            <input id="glping-import-sel-softwares" type="checkbox" @bind="State.Selection.ImportSoftwares"
                                   disabled="@(State.IsRunning || analysis.SoftwaresCount == 0)" />
                            <span class="glping-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glping-config-field checkbox">
                        <label for="glping-import-sel-printers"><i class="ti ti-printer me-2"></i>@T("Imprimantes ({0})", analysis.PrintersCount)</label>
                        <label class="glping-switch">
                            <input id="glping-import-sel-printers" type="checkbox" @bind="State.Selection.ImportPrinters"
                                   disabled="@(State.IsRunning || analysis.PrintersCount == 0)" />
                            <span class="glping-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glping-config-field checkbox">
                        <label for="glping-import-sel-peripherals"><i class="ti ti-mouse me-2"></i>@T("Périphériques ({0})", analysis.PeripheralsCount)</label>
                        <label class="glping-switch">
                            <input id="glping-import-sel-peripherals" type="checkbox" @bind="State.Selection.ImportPeripherals"
                                   disabled="@(State.IsRunning || analysis.PeripheralsCount == 0)" />
                            <span class="glping-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glping-config-field checkbox">
                        <label for="glping-import-sel-volumes"><i class="ti ti-server-2 me-2"></i>@T("Volumes ({0})", analysis.VolumesCount)</label>
                        <label class="glping-switch">
                            <input id="glping-import-sel-volumes" type="checkbox" @bind="State.Selection.ImportVolumes"
                                   disabled="@(State.IsRunning || analysis.VolumesCount == 0)" />
                            <span class="glping-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glping-config-field checkbox">
                        <label for="glping-import-sel-batteries"><i class="ti ti-battery me-2"></i>@T("Batteries ({0})", analysis.BatteriesCount)</label>
                        <label class="glping-switch">
                            <input id="glping-import-sel-batteries" type="checkbox" @bind="State.Selection.ImportBatteries"
                                   disabled="@(State.IsRunning || analysis.BatteriesCount == 0)" />
                            <span class="glping-switch-slider"></span>
                        </label>
                    </div>
                </div>

                <p class="hint mt-2">
                    @T("CPU : {0} · RAM : {1} · Disques : {2} · Cartes réseau : {3}", analysis.CpuCount, analysis.RamCount, analysis.DiskCount, analysis.NetworkCardCount)
                </p>
            }

            @if (_tab == ImportTab.Administration)
            {
                <div class="glping-config-field-grid">
                    <div class="glping-config-field checkbox">
                        <label for="glping-import-sel-entities"><i class="ti ti-building me-2"></i>@T("Entités ({0})", adminAnalysis.EntitiesCount)</label>
                        <label class="glping-switch">
                            <input id="glping-import-sel-entities" type="checkbox" @bind="State.AdminSelection.ImportEntities"
                                   disabled="@(State.IsRunning || adminAnalysis.EntitiesCount == 0)" />
                            <span class="glping-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glping-config-field checkbox">
                        <label for="glping-import-sel-groups"><i class="ti ti-users me-2"></i>@T("Groupes ({0})", adminAnalysis.GroupsCount)</label>
                        <label class="glping-switch">
                            <input id="glping-import-sel-groups" type="checkbox" @bind="State.AdminSelection.ImportGroups"
                                   disabled="@(State.IsRunning || adminAnalysis.GroupsCount == 0)" />
                            <span class="glping-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glping-config-field checkbox">
                        <label for="glping-import-sel-profiles"><i class="ti ti-shield-lock me-2"></i>@T("Profils ({0})", adminAnalysis.ProfilesCount)</label>
                        <label class="glping-switch">
                            <input id="glping-import-sel-profiles" type="checkbox" @bind="State.AdminSelection.ImportProfiles"
                                   disabled="@(State.IsRunning || adminAnalysis.ProfilesCount == 0)" />
                            <span class="glping-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glping-config-field checkbox">
                        <label for="glping-import-sel-users"><i class="ti ti-user me-2"></i>@T("Utilisateurs ({0})", adminAnalysis.UsersCount)</label>
                        <label class="glping-switch">
                            <input id="glping-import-sel-users" type="checkbox" @bind="State.AdminSelection.ImportUsers"
                                   disabled="@(State.IsRunning || adminAnalysis.UsersCount == 0)" />
                            <span class="glping-switch-slider"></span>
                        </label>
                    </div>

                    <div class="glping-config-field checkbox">
                        <label for="glping-import-sel-config"><i class="ti ti-settings me-2"></i>@T("Configuration générale")</label>
                        <label class="glping-switch">
                            <input id="glping-import-sel-config" type="checkbox" @bind="State.AdminSelection.ImportGeneralConfig"
                                   disabled="@(State.IsRunning || !adminAnalysis.GeneralConfigAvailable)" />
                            <span class="glping-switch-slider"></span>
                        </label>
                    </div>
                </div>

                <p class="hint mt-2">
                    @T("Profils : seuls le nom, le commentaire et le statut par défaut sont importés (les droits fins par module ne le sont pas — à configurer manuellement). Configuration générale : uniquement les réglages ayant un équivalent direct dans \"Configuration générale\" > \"Général\".")
                </p>
            }

            @if (_tab == ImportTab.KnowledgeBase)
            {
                @if (State.KnowledgeBaseAnalysis is not { IsPresent: true } kb)
                {
                    <div class="glping-import-plugin-empty">
                        <i class="ti ti-book-off"></i>
                        <p class="mb-0">Aucune base de connaissances sur cette base source (table <code>glpi_knowbaseitems</code> absente).</p>
                    </div>
                }
                else
                {
                    <div class="glping-config-field-grid">
                        <div class="glping-config-field checkbox">
                            <label for="glping-import-sel-kbcategories"><i class="ti ti-category me-2"></i>@T("Catégories ({0})", kb.CategoriesCount)</label>
                            <label class="glping-switch">
                                <input id="glping-import-sel-kbcategories" type="checkbox" @bind="State.KnowledgeBaseSelection.ImportCategories"
                                       disabled="@(State.IsRunning || kb.CategoriesCount == 0)" />
                                <span class="glping-switch-slider"></span>
                            </label>
                        </div>

                        <div class="glping-config-field checkbox">
                            <label for="glping-import-sel-kbarticles"><i class="ti ti-book me-2"></i>@T("Articles ({0})", kb.ArticlesCount)</label>
                            <label class="glping-switch">
                                <input id="glping-import-sel-kbarticles" type="checkbox" @bind="State.KnowledgeBaseSelection.ImportArticles"
                                       disabled="@(State.IsRunning || kb.ArticlesCount == 0)" />
                                <span class="glping-switch-slider"></span>
                            </label>
                        </div>

                        <div class="glping-config-field checkbox">
                            <label for="glping-import-sel-kbtargets"><i class="ti ti-lock me-2"></i>@T("Cibles de visibilité ({0})", kb.TargetsCount)</label>
                            <label class="glping-switch">
                                <input id="glping-import-sel-kbtargets" type="checkbox" @bind="State.KnowledgeBaseSelection.ImportTargets"
                                       disabled="@(State.IsRunning || kb.TargetsCount == 0)" />
                                <span class="glping-switch-slider"></span>
                            </label>
                        </div>

                        <div class="glping-config-field checkbox">
                            <label for="glping-import-sel-kbrevisions"><i class="ti ti-history me-2"></i>@T("Révisions ({0})", kb.RevisionsCount)</label>
                            <label class="glping-switch">
                                <input id="glping-import-sel-kbrevisions" type="checkbox" @bind="State.KnowledgeBaseSelection.ImportRevisions"
                                       disabled="@(State.IsRunning || kb.RevisionsCount == 0)" />
                                <span class="glping-switch-slider"></span>
                            </label>
                        </div>

                        <div class="glping-config-field checkbox">
                            <label for="glping-import-sel-kbdocuments"><i class="ti ti-paperclip me-2"></i>@T("Documents ({0})", kb.DocumentsCount)</label>
                            <label class="glping-switch">
                                <input id="glping-import-sel-kbdocuments" type="checkbox" @bind="State.KnowledgeBaseSelection.ImportDocuments"
                                       disabled="@(State.IsRunning || kb.DocumentsCount == 0)" />
                                <span class="glping-switch-slider"></span>
                            </label>
                        </div>

                        <div class="glping-config-field checkbox">
                            <label for="glping-import-sel-kbnotes"><i class="ti ti-notes me-2"></i>@T("Notes ({0})", kb.NotesCount)</label>
                            <label class="glping-switch">
                                <input id="glping-import-sel-kbnotes" type="checkbox" @bind="State.KnowledgeBaseSelection.ImportNotes"
                                       disabled="@(State.IsRunning || kb.NotesCount == 0)" />
                                <span class="glping-switch-slider"></span>
                            </label>
                        </div>
                    </div>

                    @if (State.KnowledgeBaseSelection.ImportDocuments)
                    {
                        <p class="hint">
                            Le contenu des fichiers est lu dans le dossier <code>files/</code> saisi avec la
                            @T("connexion, plus haut.")
                            @if (string.IsNullOrWhiteSpace(State.GlpiFilesPath))
                            {
                                <text>
                                    <strong>@T("Il n'est pas renseigné")</strong> : les documents seront repris en fiches et
                                    @T("rattachements, mais sans contenu téléchargeable — le compte rendu le signalera, et")
                                    @T("téléverser le fichier depuis l'article complétera la fiche existante.")
                                </text>
                            }
                        </p>
                    }

                    <p class="hint mt-2">
                        @T("Le contenu des articles est converti du HTML de GLPI vers le Markdown de GlpiNg (voir la fiche d'un article) : une mise en forme complexe peut être simplifiée au passage. Les cibles de visibilité et l'auteur d'un article ne se retrouvent que si l'onglet « Administration » a été importé — sinon, l'article arrive visible de tous. L'import est idempotent : le relancer met à jour les articles déjà repris au lieu de les dupliquer.")
                    </p>
                }
            }

            @if (_tab == ImportTab.Plugin)
            {
                @* Le plugin porte, côté GLPI, le domaine que GlpiNg réimplémente en propre
                   (déploiement, découverte réseau). L'onglet dit d'abord ce qui a été trouvé, puis
                   propose de le reprendre — dans cet ordre, parce qu'on ne choisit pas avant de
                   savoir ce qu'il y a. *@
                @if (!plugin.IsPresent)
                {
                    <div class="glping-config-placeholder">
                        <i class="ti ti-plug-off"></i>
                        <p class="mb-0">@T("Aucun plugin d'inventaire (GLPI Inventory ou FusionInventory) sur cette base.")</p>
                    </div>
                }
                else
                {
                    <div class="glping-import-plugin-head">
                        <i class="ti ti-plug"></i>
                        <div>
                            <div class="glping-import-plugin-name">
                                @(plugin.Name ?? plugin.Directory)
                                @if (plugin.Version is { Length: > 0 } version)
                                {
                                    <span class="badge bg-blue-lt">@version</span>
                                }
                                @if (plugin.State is not null && !plugin.IsActive)
                                {
                                    <span class="badge bg-orange-lt" title="@(T("Installé mais désactivé côté GLPI : ses données restent en base."))">@T("désactivé")</span>
                                }
                            </div>
                            <div class="text-secondary small">
                                @plugin.TableCount table(s) <code>@plugin.TablePrefix*</code> dans la base source.
                            </div>
                        </div>
                    </div>

                    @if (plugin.IsRegisteredWithoutTables)
                    {
                        <p class="text-secondary">
                            Déclaré dans <code>glpi_plugins</code> mais aucune de ses tables n'est présente :
                            @T("plugin désinstallé, ou export partiel de la base. Rien à reprendre.")
                        </p>
                    }
                    else
                    {
                        <p class="hint" style="margin-left:0;">
                            @T("GlpiNg gère ce domaine en propre (Outils > Déploiements). Rien n'est repris sans choix explicite, contrairement au parc et à l'administration.")
                        </p>

                        @* Les quatre catégories d'un bloc, sans rien qui les sépare : la liste doit se
                           lire d'un coup d'œil. Ce que la sélection des paquets ouvre en plus vient
                           après, dans sa propre section. *@
                        <div class="glping-config-field-grid">
                            <div class="glping-config-field checkbox">
                                <label for="glping-import-sel-ipranges"><i class="ti ti-network me-2"></i>@T("Plages IP ({0})", plugin.IpRangesCount)</label>
                                <label class="glping-switch">
                                    <input id="glping-import-sel-ipranges" type="checkbox" @bind="State.PluginSelection.ImportIpRanges"
                                           disabled="@(State.IsRunning || plugin.IpRangesCount == 0)" />
                                    <span class="glping-switch-slider"></span>
                                </label>
                            </div>

                            <div class="glping-config-field checkbox">
                                <label for="glping-import-sel-snmp"><i class="ti ti-key me-2"></i>@T("Identifiants SNMP ({0})", plugin.SnmpCredentialsCount)</label>
                                <label class="glping-switch">
                                    <input id="glping-import-sel-snmp" type="checkbox" @bind="State.PluginSelection.ImportSnmpCredentials"
                                           disabled="@(State.IsRunning || plugin.SnmpCredentialsCount == 0)" />
                                    <span class="glping-switch-slider"></span>
                                </label>
                            </div>

                            <div class="glping-config-field checkbox">
                                <label for="glping-import-sel-packages"><i class="ti ti-package me-2"></i>@T("Paquets de déploiement ({0})", plugin.DeployPackagesCount)</label>
                                <label class="glping-switch">
                                    <input id="glping-import-sel-packages" type="checkbox" @bind="State.PluginSelection.ImportDeployPackages"
                                           disabled="@(State.IsRunning || plugin.DeployPackagesCount == 0)" />
                                    <span class="glping-switch-slider"></span>
                                </label>
                            </div>

                            <div class="glping-config-field checkbox">
                                <label for="glping-import-sel-unmanaged"><i class="ti ti-help me-2"></i>@T("Actifs non gérés ({0})", plugin.UnmanagedDevicesCount)</label>
                                <label class="glping-switch">
                                    <input id="glping-import-sel-unmanaged" type="checkbox" @bind="State.PluginSelection.ImportUnmanagedDevices"
                                           disabled="@(State.IsRunning || plugin.UnmanagedDevicesCount == 0)" />
                                    <span class="glping-switch-slider"></span>
                                </label>
                            </div>
                        </div>

                        @if (State.PluginSelection.ImportDeployPackages)
                        {
                            @* Section à part, et non deux champs glissés dans la grille des
                               interrupteurs : ce ne sont pas des catégories à cocher mais le
                               réglage d'une seule d'entre elles, et les mêler couperait la liste
                               en deux. *@
                            <div class="glping-config-divider">
                                <span><i class="ti ti-file-download"></i> @T("Contenu des fichiers de paquets")</span>
                            </div>

                            <p class="hint" style="margin-left:0;">
                                @T("Les octets d'un fichier de paquet ne sont pas dans la base GLPI : ils vivent sur le disque de son serveur. Sans l'une de ces deux sources, les fichiers sont seulement déclarés, et le paquet reste non déployable tant qu'ils n'ont pas été téléversés depuis sa fiche.")
                            </p>

                            <div class="glping-config-field">
                                <label for="glping-import-files-path">
                                    @T("Répertoire des fichiers du plugin") <span class="text-secondary">@T("(optionnel)")</span>
                                </label>
                                <input id="glping-import-files-path" type="text" class="glping-config-input"
                                       placeholder="@(T("Déduit du dossier files/ et du plugin détecté"))"
                                       @bind="State.DeployFilesPathOverride" disabled="@State.IsRunning" />
                            </div>
                            <p class="hint">
                                Laissez vide dans le cas courant : le chemin est déduit du dossier <code>files/</code>
                                @T("saisi avec la connexion, et du plugin détecté à l'analyse")
                                (<code>&lt;files&gt;/_plugins/&lt;plugin&gt;/files</code>). À renseigner seulement si
                                @T("cette installation range ses fichiers de paquets ailleurs. Les identifiants du partage")
                                @T("sont ceux de la connexion — c'est le même partage.")
                            </p>

                            <div class="glping-config-field">
                                <label for="glping-import-base-url">@T("URL de GLPI")</label>
                                <input id="glping-import-base-url" type="text" class="glping-config-input"
                                       placeholder="https://glpi.exemple.local"
                                       @bind="State.GlpiBaseUrl" disabled="@State.IsRunning" />
                            </div>
                            <p class="hint">
                                @if (plugin.UrlBase is { Length: > 0 })
                                {
                                    @* Dire d'où vient la valeur : un champ pré-rempli sans explication laisse
                                       douter de ce qu'il contient. *@
                                    <text>Pré-remplie depuis la base source (<code>glpi_configs.url_base</code>), modifiable. </text>
                                }
                                @T("Essayée en repli, fichier par fichier, quand le répertoire ne rend rien.")
                            </p>

                            @* Le point d'accès qui rend un fichier entier (front/deployfile_download.php)
                               vérifie un droit GLPI : sans compte, la route HTTP ne peut rien récupérer
                               d'autre que ce qu'un miroir statique expose. *@
                            <div class="glping-config-field">
                                <label for="glping-import-web-user">@T("Compte GLPI") <span class="text-secondary">@T("(optionnel)")</span></label>
                                <input id="glping-import-web-user" type="text" class="glping-config-input"
                                       placeholder="@(T("compte ayant le droit de lecture sur les paquets"))"
                                       @bind="State.GlpiUserName" disabled="@State.IsRunning" />
                            </div>

                            <div class="glping-config-field">
                                <label for="glping-import-web-password">@T("Mot de passe GLPI")</label>
                                <input id="glping-import-web-password" type="password" class="glping-config-input"
                                       autocomplete="new-password"
                                       @bind="State.GlpiPassword" disabled="@State.IsRunning" />
                            </div>
                            <p class="hint">
                                @T("Ouvre une session web le temps de l'import. Sans lui, l'URL ci-dessus ne sert qu'aux miroirs. Utilisés le temps de l'import et jamais enregistrés.")
                            </p>

                            @if (plugin.MirrorUrls.Count > 0)
                            {
                                <p class="hint">
                                    <i class="ti ti-server me-1"></i>
                                    @T("{0} serveur(s) de miroir déclaré(s) dans le plugin, essayé(s)", plugin.MirrorUrls.Count)
                                    avant la session GLPI : @string.Join(", ", plugin.MirrorUrls.Take(3))@(plugin.MirrorUrls.Count > 3 ? ", …" : "").
                                </p>
                            }

                            <p class="hint">
                                @T("Chaque contenu récupéré, par quelque route que ce soit, est vérifié par son empreinte avant d'être enregistré.")
                            </p>
                        }

                        <div class="glping-config-divider">
                            <span><i class="ti ti-ban"></i> @T("Non repris")</span>
                        </div>

                        <p class="hint" style="margin-left:0;">
                            @T("Tâches du plugin ({0}) : sans équivalent direct, à recréer dans", plugin.TasksCount)
                            @T("Outils > Déploiements. Agents ({0}) : déjà couverts par la catégorie", plugin.AgentsCount)
                            @T("« Agents » de l'onglet Parc (")<code>glpi_agents</code>@T(", table du cœur de GLPI).")
                        </p>
                    }
                }
            }

            <button type="button" class="glping-config-save mt-2" disabled="@(!State.CanRun)" @onclick="RunImportAsync">
                @if (State.IsRunning)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>@T("Import en cours…")</span>
                }
                else
                {
                    <i class="ti ti-database-import me-1"></i>
                    <span>@T("Lancer l'import")</span>
                }
            </button>
        </div>
    </div>
}

<div class="card">
    <div class="card-body">
        <p class="text-secondary">
            @T("L'import est en lecture seule et idempotent : un poste déjà importé (identifié par son")
            <code>glpi_computers.id</code> @T("d'origine) est mis à jour plutôt que dupliqué.")
        </p>

        @if (State.IsRunning)
        {
            <div class="alert alert-info">
                <i class="ti ti-info-circle me-1"></i>
                @T("Un import est en cours (peut-être déclenché par un autre administrateur) — cette page se mettra à jour automatiquement pour tous les admins connectés dès qu'il sera terminé.")
            </div>

            <div class="d-flex justify-content-between align-items-baseline mb-1">
                <span class="fw-medium text-truncate">
                    <i class="ti ti-loader-2 glping-spin me-1"></i>@(State.CurrentPhase ?? T("Préparation…"))
                    @if (State.CurrentDetail is { Length: > 0 } detail)
                    {
                        @* Ce qui se passe quand le compteur, lui, ne bouge pas — le téléchargement
                           d'un fichier de paquet peut durer des minutes. *@
                        <span class="text-secondary fw-normal ms-1">— @detail</span>
                    }
                </span>
                @if (State.ProgressTotal > 0)
                {
                    <span class="text-secondary small">
                        @T("{0} / {1} élément(s) — {2} %", State.ProgressCompleted.ToString("N0"), State.ProgressTotal.ToString("N0"), State.ProgressPercent)
                    </span>
                }
            </div>

            @* Barre déterminée tant que l'analyse a pu chiffrer le travail, indéterminée sinon : une
               barre qui affiche un pourcentage inventé serait pire qu'une barre qui ne promet rien. *@
            <div class="progress mb-3" style="height: 0.75rem;">
                @if (State.ProgressTotal > 0)
                {
                    <div class="progress-bar" role="progressbar" style="width: @(State.ProgressPercent)%"
                         aria-valuenow="@State.ProgressPercent" aria-valuemin="0" aria-valuemax="100"></div>
                }
                else
                {
                    <div class="progress-bar glping-progress-indeterminate"></div>
                }
            </div>
        }

        @if (State.LastError is not null)
        {
            <div class="alert alert-danger">
                <i class="ti ti-alert-circle me-1"></i>@State.LastError
            </div>
        }

        @if (State.LastResult is { } result)
        {
            <div class="alert alert-success">
                <i class="ti ti-check me-1"></i>
                @T("Dernier import terminé en {0} s", result.Duration.TotalSeconds.ToString("0.0"))
                @if (State.LastRunAt is { } lastRunAt)
                {
                    <span>(le @Display.DateTime(lastRunAt))</span>
                }
            </div>

            <div class="row row-cards mb-3">
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@result.ComputersCreated</div>
                            <div class="text-secondary">@T("Postes créés")</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@result.ComputersUpdated</div>
                            <div class="text-secondary">@T("Postes mis à jour")</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@result.MonitorsImported</div>
                            <div class="text-secondary">@T("Moniteurs importés")</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@(result.AgentsCreated + result.AgentsUpdated)</div>
                            <div class="text-secondary">@T("Agents ({0} créés)", result.AgentsCreated)</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@result.ComponentsImported</div>
                            <div class="text-secondary">@T("Composants importés")</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@result.SoftwaresImported</div>
                            <div class="text-secondary">@T("Logiciels importés")</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@result.PrintersImported</div>
                            <div class="text-secondary">@T("Imprimantes importées")</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@result.PeripheralsImported</div>
                            <div class="text-secondary">@T("Périphériques importés")</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@result.VolumesImported</div>
                            <div class="text-secondary">@T("Volumes importés")</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@result.BatteriesImported</div>
                            <div class="text-secondary">@T("Batteries importées")</div>
                        </div>
                    </div>
                </div>
            </div>

            @if (result.Warnings.Count > 0)
            {
                <div class="glping-fiche-block-title"><i class="ti ti-alert-triangle"></i>@T("Avertissements")</div>
                <ul>
                    @foreach (string warning in result.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            }
        }

        @if (State.LastAdminError is not null)
        {
            <div class="alert alert-danger">
                <i class="ti ti-alert-circle me-1"></i>@State.LastAdminError
            </div>
        }

        @if (State.LastAdminResult is { } adminResult)
        {
            <div class="row row-cards mb-3">
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@(adminResult.EntitiesCreated + adminResult.EntitiesUpdated)</div>
                            <div class="text-secondary">@T("Entités ({0} créées)", adminResult.EntitiesCreated)</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@(adminResult.GroupsCreated + adminResult.GroupsUpdated)</div>
                            <div class="text-secondary">@T("Groupes ({0} créés)", adminResult.GroupsCreated)</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@(adminResult.ProfilesCreated + adminResult.ProfilesUpdated)</div>
                            <div class="text-secondary">@T("Profils ({0} créés)", adminResult.ProfilesCreated)</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@(adminResult.UsersCreated + adminResult.UsersUpdated)</div>
                            <div class="text-secondary">@T("Utilisateurs ({0} créés)", adminResult.UsersCreated)</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@adminResult.GeneralConfigKeysImported</div>
                            <div class="text-secondary">@T("Réglages généraux importés")</div>
                        </div>
                    </div>
                </div>
            </div>

            @if (adminResult.Warnings.Count > 0)
            {
                <div class="glping-fiche-block-title"><i class="ti ti-alert-triangle"></i>@T("Avertissements (Administration)")</div>
                <ul>
                    @foreach (string warning in adminResult.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            }
        }

        @if (State.LastKnowledgeBaseError is not null)
        {
            <div class="alert alert-danger">
                <i class="ti ti-alert-circle me-1"></i>@State.LastKnowledgeBaseError
            </div>
        }

        @if (State.LastKnowledgeBaseResult is { } kbResult)
        {
            <div class="row row-cards mb-3">
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@(kbResult.CategoriesCreated + kbResult.CategoriesUpdated)</div>
                            <div class="text-secondary">@T("Catégories ({0} créées)", kbResult.CategoriesCreated)</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@(kbResult.ArticlesCreated + kbResult.ArticlesUpdated)</div>
                            <div class="text-secondary">@T("Articles ({0} créés)", kbResult.ArticlesCreated)</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@kbResult.TargetsImported</div>
                            <div class="text-secondary">
                                @T("Cibles reprises")
                                @if (kbResult.TargetsSkipped > 0)
                                {
                                    <text>@T("({0} ignorées)", kbResult.TargetsSkipped)</text>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@kbResult.RevisionsImported</div>
                            <div class="text-secondary">@T("Révisions reprises")</div>
                        </div>
                    </div>
                </div>
                @* Documents et rattachements comptés séparément : un document repris sans être
                   rattaché à aucun article n'apparaîtrait nulle part sur les fiches, et le seul
                   nombre de documents laisserait croire l'import complet. *@
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@kbResult.DocumentsImported</div>
                            <div class="text-secondary">
                                @T("Documents repris")
                                @if (kbResult.DocumentsWithoutContent > 0)
                                {
                                    <text>@T("({0} sans fichier)", kbResult.DocumentsWithoutContent)</text>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@kbResult.DocumentLinksImported</div>
                            <div class="text-secondary">@T("Rattachements aux articles")</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@kbResult.NotesImported</div>
                            <div class="text-secondary">
                                @T("Notes reprises")
                                @if (kbResult.NotesSkipped > 0)
                                {
                                    <text>@T("({0} ignorées)", kbResult.NotesSkipped)</text>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (kbResult.Warnings.Count > 0)
            {
                <div class="glping-fiche-block-title"><i class="ti ti-alert-triangle"></i>@T("Avertissements (Base de connaissances)")</div>
                <ul>
                    @foreach (string warning in kbResult.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            }
        }

        @if (State.LastPluginError is not null)
        {
            <div class="alert alert-danger">
                <i class="ti ti-alert-circle me-1"></i>@State.LastPluginError
            </div>
        }

        @if (State.LastPluginResult is { } pluginResult)
        {
            <div class="row row-cards mb-3">
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@(pluginResult.IpRangesCreated + pluginResult.IpRangesUpdated)</div>
                            <div class="text-secondary">@T("Plages IP ({0} créées)", pluginResult.IpRangesCreated)</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@(pluginResult.SnmpCredentialsCreated + pluginResult.SnmpCredentialsUpdated)</div>
                            <div class="text-secondary">@T("Identifiants SNMP ({0} créés)", pluginResult.SnmpCredentialsCreated)</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@(pluginResult.DeployPackagesCreated + pluginResult.DeployPackagesUpdated)</div>
                            <div class="text-secondary">@T("Paquets ({0} créés)", pluginResult.DeployPackagesCreated)</div>
                            @* Le contenu repris compte autant que le nombre de paquets : c'est lui
                               qu'on ne veut pas ressaisir. *@
                            <div class="text-secondary small mt-1">
                                @T("{0} vérification(s), {1} action(s)", pluginResult.DeployPackageChecksImported, pluginResult.DeployPackageActionsImported)
                            </div>
                            @if (pluginResult.DeployPackageFilesCreated + pluginResult.DeployPackageFilesUpdated > 0)
                            {
                                <div class="text-secondary small">
                                    @T("{0} fichier(s)", pluginResult.DeployPackageFilesCreated + pluginResult.DeployPackageFilesUpdated)
                                </div>
                            }
                            @if (pluginResult.DeployPackageFilesDownloaded > 0)
                            {
                                <div class="text-success small">
                                    <i class="ti ti-download me-1"></i>@T("{0} contenu(s) récupéré(s)", pluginResult.DeployPackageFilesDownloaded)
                                </div>
                            }
                            @if (pluginResult.DeployPackageFilesPending > 0)
                            {
                                <div class="text-warning small">
                                    <i class="ti ti-upload me-1"></i>@T("{0} sans contenu", pluginResult.DeployPackageFilesPending)
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card card-sm">
                        <div class="card-body text-center">
                            <div class="fs-2 fw-bold">@(pluginResult.UnmanagedDevicesCreated + pluginResult.UnmanagedDevicesUpdated)</div>
                            <div class="text-secondary">@T("Actifs non gérés ({0} créés)", pluginResult.UnmanagedDevicesCreated)</div>
                        </div>
                    </div>
                </div>
            </div>

            @if (pluginResult.Warnings.Count > 0)
            {
                <div class="glping-fiche-block-title"><i class="ti ti-alert-triangle"></i>@T("Avertissements (plugin d'inventaire)")</div>
                <ul>
                    @foreach (string warning in pluginResult.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            }
        }
    </div>
</div>
