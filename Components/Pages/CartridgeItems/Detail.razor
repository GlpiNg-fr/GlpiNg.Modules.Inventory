@page "/parc/cartridge-items/{ItemId:int}"
@using GlpiNg.Modules.Inventory.Models
@using GlpiNg.Modules.Inventory.Services
@rendermode InteractiveServer

<PageTitle>@(_item?.Name ?? T("Modèle de cartouche")) — GlpiNg</PageTitle>

@if (_item is null)
{
    <div class="text-center text-secondary py-5">
        <i class="ti ti-droplet-off fs-1"></i>
        <p class="mt-2">@T("Ce modèle de cartouche est introuvable.")</p>
    </div>
}
else
{
    <div class="glping-fiche-topbar">
        <div class="glping-fiche-crumb">
            <i class="ti ti-droplet"></i>
            <span>@T("Modèle de cartouche - {0} - ID {1}", _item.Name, _item.Id)</span>
        </div>
    </div>

    <div class="glping-fiche-layout">
        <aside class="glping-fiche-sidebar">
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "main" ? "active" : "")" @onclick='() => SetTab("main")'>
                <i class="ti ti-droplet"></i>
                <span>@T("Modèle")</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "stock" ? "active" : "")" @onclick='() => SetTab("stock")'>
                <i class="ti ti-stack-2"></i>
                <span>@T("Stock")</span>
                <span class="glping-fiche-tab-count">@_item.Cartridges.Count</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "history" ? "active" : "")" @onclick='() => SetTab("history")'>
                <i class="ti ti-history"></i>
                <span>@T("Historique")</span>
                <span class="glping-fiche-tab-count">@_item.HistoryEntries.Count</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "links" ? "active" : "")" @onclick='() => SetTab("links")'>
                <i class="ti ti-external-link"></i>
                <span>@T("Liens externes")</span>
            </button>
        </aside>

        <div class="glping-fiche-panel">
            @switch (_activeTabKey)
            {
                case "main":
                    <EditForm Model="_item" OnValidSubmit="SaveAsync">
                        <CartridgeItemFormFields Item="_item" LocationOptions="_locationOptions" />

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync">
                                <i class="ti ti-trash me-1"></i>@T("Supprimer définitivement")
                            </button>
                            <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? T("Enregistrement…") : T("Sauvegarder"))
                            </button>
                        </div>
                    </EditForm>
                    break;

                case "stock":
                    int available = _item.Cartridges.Count(c => c.DateUse is null && c.DateOut is null);
                    int inUse = _item.Cartridges.Count(c => c.DateUse is not null && c.DateOut is null);
                    int discarded = _item.Cartridges.Count(c => c.DateOut is not null);
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-stack-2"></i>@T("Stock")</div>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <div class="text-secondary">@T("Disponible")</div>
                                <div class="fs-2 fw-bold @(available < _item.AlertThreshold ? "text-danger" : "")">@available</div>
                            </div>
                            <div class="col-md-4">
                                <div class="text-secondary">@T("En service")</div>
                                <div class="fs-2 fw-bold">@inUse</div>
                            </div>
                            <div class="col-md-4">
                                <div class="text-secondary">@T("Retirées")</div>
                                <div class="fs-2 fw-bold">@discarded</div>
                            </div>
                        </div>

                        <div class="d-flex align-items-end gap-2 mb-3">
                            <div>
                                <label class="form-label">@T("Réceptionner")</label>
                                <input type="number" min="1" class="form-control" style="width: 100px;" @bind="_receiveQuantity" />
                            </div>
                            <button type="button" class="btn btn-primary" @onclick="ReceiveStockAsync">
                                <i class="ti ti-plus me-1"></i>@T("Ajouter au stock")
                            </button>
                        </div>

                        @if (_item.Cartridges.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-stack-2"></i>
                                <p class="mb-0">@T("Aucune unité réceptionnée pour ce modèle.")</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("ID")</th>
                                            <th>@T("Réceptionnée le")</th>
                                            <th>@T("Statut")</th>
                                            <th>@T("Imprimante")</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (Cartridge cartridge in _item.Cartridges.OrderByDescending(c => c.DateIn))
                                        {
                                            <tr>
                                                <td>@cartridge.Id</td>
                                                <td>@Display.Date(cartridge.DateIn)</td>
                                                <td>
                                                    @if (cartridge.DateOut is not null)
                                                    {
                                                        <span class="badge bg-secondary-lt">@T("Retirée")</span>
                                                    }
                                                    else if (cartridge.DateUse is not null)
                                                    {
                                                        <span class="badge bg-blue-lt">@T("En service")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-green-lt">@T("En stock")</span>
                                                    }
                                                </td>
                                                <td>@(cartridge.Printer?.Name ?? "—")</td>
                                                <td class="text-end">
                                                    @if (cartridge.DateOut is null && cartridge.DateUse is null)
                                                    {
                                                        <select class="form-select form-select-sm d-inline-block me-1" style="width: 180px;"
                                                                @onchange="@((ChangeEventArgs e) => _printerToUse[cartridge.Id] = int.Parse((string)e.Value!))">
                                                            <option value="0">@T("-- Imprimante --")</option>
                                                            @foreach (Printer printer in _printers)
                                                            {
                                                                <option value="@printer.Id">@printer.Name</option>
                                                            }
                                                        </select>
                                                        <button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="() => PutIntoUseAsync(cartridge)">
                                                            @T("Mettre en service")
                                                        </button>
                                                    }
                                                    @if (cartridge.DateOut is null)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveFromServiceAsync(cartridge)">
                                                            @T("Retirer")
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    break;

                case "history":
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-history"></i>@T("Historique ({0})", _item.HistoryEntries.Count)</div>
                        @if (_item.HistoryEntries.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-history"></i>
                                <p class="mb-0">@T("Aucune modification enregistrée.")</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("ID")</th>
                                            <th>@T("Date")</th>
                                            <th>@T("Utilisateur")</th>
                                            <th>@T("Champ")</th>
                                            <th>@T("Mise à jour")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (CartridgeItemHistoryEntry entry in Display.Chronological(_item.HistoryEntries, e => e.OccurredAt))
                                        {
                                            <tr>
                                                <td>@entry.Id</td>
                                                <td>@Display.DateTime(entry.OccurredAt)</td>
                                                <td>@entry.User</td>
                                                <td>@entry.Field</td>
                                                <td>@entry.Description</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    break;

                case "links":
                    <ExternalLinksPanel ItemType="@ExternalLinkTagSource.CartridgeItemItemType"
                                        Tags="@ExternalLinkTagSource.For(_item)" />
                    break;
            }
        </div>
    </div>
}
