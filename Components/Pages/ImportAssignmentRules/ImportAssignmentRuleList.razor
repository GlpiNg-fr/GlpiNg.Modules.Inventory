@page "/admin/import-rules"
@using GlpiNg.Modules.Inventory.Services
@rendermode InteractiveServer

<PageTitle>GlpiNg — Règles d'import</PageTitle>

<h3 class="mb-3"><i class="ti ti-route me-2"></i>Règles d'import</h3>

<ImportRulesTopMenu Current="rules" />

<div class="glpi-list-page">
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between glpi-list-toolbar">
        <label class="form-check m-0 px-2" title="Tout sélectionner">
            <input class="form-check-input m-0" type="checkbox" checked="@AllSelected"
                   @onchange="@((ChangeEventArgs e) => ToggleSelectAll((bool)(e.Value ?? false)))" />
        </label>

        <div class="btn-list align-items-center">
            <div class="dropdown">
                <button type="button" class="btn btn-icon text-danger" data-bs-toggle="dropdown" aria-expanded="false"
                        disabled="@(_selectedIds.Count == 0)" title="Supprimer la sélection">
                    <i class="ti ti-trash"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 260px;">
                    <p class="mb-2">Supprimer @_selectedIds.Count règle(s) sélectionnée(s) ?</p>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-sm">Annuler</button>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteSelectedAsync">Supprimer</button>
                    </div>
                </div>
            </div>

            <button type="button" class="btn btn-icon" @onclick="LoadAsync" title="Rafraîchir">
                <i class="ti ti-refresh"></i>
            </button>

            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newImportAssignmentRuleModal">
                <i class="ti ti-plus me-1"></i>Nouvelle règle
            </button>
        </div>
    </div>

    <p class="text-secondary px-3 pt-3 mb-0">
        <i class="ti ti-info-circle me-1"></i>Le moteur s'arrête à la première règle vérifiée, évaluée à chaque inventaire reçu
        (avant même la création/mise à jour de l'ordinateur).
    </p>

    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th style="width: 2.5rem;"></th>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Critères</th>
                    <th>Actions</th>
                    <th>Activé</th>
                    <th style="width: 6rem;">Position</th>
                </tr>
            </thead>
            <tbody>
                @if (_rules.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-secondary py-4">Aucune règle d'import.</td>
                    </tr>
                }
                else
                {
                    @for (int i = 0; i < _rules.Count; i++)
                    {
                        ImportAssignmentRule rule = _rules[i];
                        bool isFirst = i == 0;
                        bool isLast = i == _rules.Count - 1;
                        <tr>
                            <td>
                                <input class="form-check-input m-0" type="checkbox" checked="@_selectedIds.Contains(rule.Id)"
                                       @onchange="@((ChangeEventArgs e) => ToggleSelect(rule.Id, (bool)(e.Value ?? false)))" />
                            </td>
                            <td>
                                <a href="@($"/admin/import-rules/{rule.Id}")" class="text-reset fw-semibold">
                                    <i class="ti ti-route me-1 text-secondary"></i>@rule.Name
                                </a>
                            </td>
                            <td>@rule.Comment</td>
                            <td>
                                @foreach (ImportAssignmentRuleCriterion criterion in rule.Criteria)
                                {
                                    <div class="small">@ImportAssignmentRuleLabels.CriterionSummary(criterion)</div>
                                }
                            </td>
                            <td>
                                @foreach (ImportAssignmentRuleAction action in rule.Actions)
                                {
                                    <div class="small">@ImportAssignmentRuleLabels.ActionSummary(action)</div>
                                }
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm @(rule.IsActive ? "btn-outline-success" : "btn-outline-secondary")" @onclick="() => ToggleActiveAsync(rule)">
                                    @(rule.IsActive ? "Oui" : "Non")
                                </button>
                            </td>
                            <td class="text-nowrap">
                                <button type="button" class="btn btn-sm btn-icon" disabled="@isFirst" @onclick="() => MoveAsync(rule, -1)" title="Monter">
                                    <i class="ti ti-arrow-up"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon" disabled="@isLast" @onclick="() => MoveAsync(rule, 1)" title="Descendre">
                                    <i class="ti ti-arrow-down"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
</div>

<div class="modal fade" id="newImportAssignmentRuleModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ti ti-route me-2"></i>Nouvelle règle d'import</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <div class="glpi-fiche-field">
                    <label>Nom</label>
                    <input class="form-control" @bind="_newRule.Name" @bind:event="oninput" />
                </div>
                <div class="glpi-fiche-field">
                    <label>Commentaires</label>
                    <textarea class="form-control" rows="3" @bind="_newRule.Comment"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" disabled="@string.IsNullOrWhiteSpace(_newRule.Name)" @onclick="CreateRuleAsync">
                    <i class="ti ti-plus me-1"></i>Ajouter
                </button>
            </div>
        </div>
    </div>
</div>
