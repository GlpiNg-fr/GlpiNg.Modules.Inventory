@page "/admin/import-rules/blacklist"
@using GlpiNg.Modules.Inventory.Models
@rendermode InteractiveServer

<PageTitle>@T("Liste noire — GlpiNg")</PageTitle>

<h3 class="mb-3"><i class="ti ti-eye-off me-2"></i>@T("Liste noire")</h3>

<ImportRulesTopMenu Current="blacklist" />

<div class="glping-list-page">
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between glping-list-toolbar">
        <label class="form-check m-0 px-2" title="@(T("Tout sélectionner"))">
            <input class="form-check-input m-0" type="checkbox" checked="@AllSelected"
                   @onchange="@((ChangeEventArgs e) => ToggleSelectAll((bool)(e.Value ?? false)))" />
        </label>

        <div class="btn-list align-items-center">
            <div class="dropdown">
                <button type="button" class="btn btn-icon text-danger" data-bs-toggle="dropdown" aria-expanded="false"
                        disabled="@(_selectedIds.Count == 0)" title="@(T("Supprimer la sélection"))">
                    <i class="ti ti-trash"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 260px;">
                    <p class="mb-2">@T("Supprimer {0} valeur(s) sélectionnée(s) ?", _selectedIds.Count)</p>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-sm">@T("Annuler")</button>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteSelectedAsync">@T("Supprimer")</button>
                    </div>
                </div>
            </div>

            <button type="button" class="btn btn-icon" @onclick="LoadAsync" title="@(T("Rafraîchir"))">
                <i class="ti ti-refresh"></i>
            </button>

            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newImportBlacklistEntryModal">
                <i class="ti ti-plus me-1"></i>@T("Ajouter")
            </button>
        </div>
    </div>

    <p class="text-secondary px-3 pt-3 mb-0">
        <i class="ti ti-info-circle me-1"></i>@T("Une valeur listée ici (IP, MAC ou numéro de série connu comme factice) est traitée comme absente à l'inventaire plutôt qu'enregistrée telle quelle.")
    </p>

    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th style="width: 2.5rem;">
                        @* Ne coche que les lignes affichées — la page courante là où le tableau est
                           paginé : cocher ici ne doit jamais engager plus que ce qu'on voit. *@
                        <input class="form-check-input m-0" type="checkbox" title="@(T("Sélectionner les éléments visibles"))"
                               checked="@AllSelected"
                               @onchange="@((ChangeEventArgs e) => ToggleSelectAll((bool)(e.Value ?? false)))" />
                    </th>
                    <th>@T("Nom")</th>
                    <th>@T("Type")</th>
                    <th>@T("Valeur")</th>
                    <th style="width: 3rem;"></th>
                </tr>
            </thead>
            <tbody>
                @if (_entries.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-secondary py-4">@T("Aucune valeur en liste noire.")</td>
                    </tr>
                }
                else
                {
                    @foreach (ImportBlacklistEntry entry in _entries)
                    {
                        <tr>
                            <td>
                                <input class="form-check-input m-0" type="checkbox" checked="@_selectedIds.Contains(entry.Id)"
                                       @onchange="@((ChangeEventArgs e) => ToggleSelect(entry.Id, (bool)(e.Value ?? false)))" />
                            </td>
                            <td>@entry.Name</td>
                            <td>@BlacklistTypeLabel(entry.Type)</td>
                            <td class="text-secondary">@entry.Value</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-icon text-danger" title="@(T("Supprimer"))" @onclick="() => DeleteSelectedSingleAsync(entry.Id)">
                                    <i class="ti ti-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
</div>

<div class="modal fade" id="newImportBlacklistEntryModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ti ti-eye-off me-2"></i>@T("Nouvelle valeur en liste noire")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@(T("Fermer"))"></button>
            </div>
            <div class="modal-body">
                <div class="glping-fiche-field">
                    <label>@T("Nom")</label>
                    <input class="form-control" @bind="_newEntry.Name" @bind:event="oninput" />
                </div>
                <div class="glping-fiche-field">
                    <label>@T("Type")</label>
                    <select class="form-select" @bind="_newEntry.Type">
                        <option value="@ImportBlacklistType.IpAddress">@T("IP")</option>
                        <option value="@ImportBlacklistType.MacAddress">@T("MAC")</option>
                        <option value="@ImportBlacklistType.SerialNumber">@T("Numéro de série")</option>
                    </select>
                </div>
                <div class="glping-fiche-field">
                    <label>@T("Valeur")</label>
                    <input class="form-control" @bind="_newEntry.Value" @bind:event="oninput" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" disabled="@string.IsNullOrWhiteSpace(_newEntry.Name)" @onclick="CreateAsync">
                    <i class="ti ti-plus me-1"></i>@T("Ajouter")
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private static string BlacklistTypeLabel(ImportBlacklistType type) => type switch
    {
        ImportBlacklistType.IpAddress => T("IP"),
        ImportBlacklistType.MacAddress => T("MAC"),
        ImportBlacklistType.SerialNumber => T("Numéro de série"),
        _ => type.ToString()
    };

    private Task DeleteSelectedSingleAsync(int id)
    {
        _selectedIds.Clear();
        _selectedIds.Add(id);
        return DeleteSelectedAsync();
    }
}
