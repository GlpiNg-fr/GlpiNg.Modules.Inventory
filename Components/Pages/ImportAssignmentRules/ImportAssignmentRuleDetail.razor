@page "/admin/import-rules/{RuleId:int}"
@using GlpiNg.Modules.Inventory.Services
@rendermode InteractiveServer

<PageTitle>GlpiNg — @(_rule?.Name ?? "Règle d'import")</PageTitle>

@if (_rule is null)
{
    <div class="text-center text-secondary py-5">
        <i class="ti ti-route-off fs-1"></i>
        <p class="mt-2">Cette règle est introuvable.</p>
    </div>
}
else
{
    <div class="glpi-fiche-layout">
        <aside class="glpi-fiche-sidebar">
            <button type="button" class="glpi-fiche-tab-item @(_activeTabKey == "main" ? "active" : "")" @onclick='() => SetTab("main")'>
                <i class="ti ti-route"></i>
                <span>Règle</span>
            </button>
            <button type="button" class="glpi-fiche-tab-item @(_activeTabKey == "criteria" ? "active" : "")" @onclick='() => SetTab("criteria")'>
                <i class="ti ti-filter"></i>
                <span>Critères</span>
                <span class="glpi-fiche-tab-count">@_rule.Criteria.Count</span>
            </button>
            <button type="button" class="glpi-fiche-tab-item @(_activeTabKey == "actions" ? "active" : "")" @onclick='() => SetTab("actions")'>
                <i class="ti ti-bolt"></i>
                <span>Actions</span>
                <span class="glpi-fiche-tab-count">@_rule.Actions.Count</span>
            </button>
        </aside>

        <div class="glpi-fiche-panel">
            @switch (_activeTabKey)
            {
                case "main":
                    <div class="row">
                        <div class="col-md-6">
                            <div class="glpi-fiche-field">
                                <label>Nom</label>
                                <input class="form-control" @bind="_rule.Name" @bind:event="oninput" />
                            </div>
                            <div class="glpi-fiche-field">
                                <label>Opérateur logique</label>
                                <select class="form-select" @bind="_rule.LogicalOperator">
                                    <option value="@ImportAssignmentRuleLogicalOperator.And">ET (tous les critères)</option>
                                    <option value="@ImportAssignmentRuleLogicalOperator.Or">OU (au moins un critère)</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="glpi-fiche-field">
                                <label>Actif</label>
                                @* Valeur et gestionnaire explicites plutot que @bind : sur un <select> lie a un booleen,
                                   Blazor ecrit dans l'attribut value le resultat de bool.ToString(), soit "True" ou
                                   "False". Aucune option en minuscules ne correspondait alors, la liste restait bloquee
                                   sur son premier choix et le modele n'etait jamais mis a jour. *@
                                <select class="form-select" value="@(_rule.IsActive ? "true" : "false")"
                                        @onchange="@((ChangeEventArgs e) => _rule.IsActive = (string?)e.Value == "true")">
                                    <option value="true">Oui</option>
                                    <option value="false">Non</option>
                                </select>
                            </div>
                            <div class="glpi-fiche-field">
                                <label>Commentaires</label>
                                <textarea class="form-control" rows="3" @bind="_rule.Comment"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync">
                            <i class="ti ti-trash me-1"></i>Supprimer définitivement
                        </button>
                        <button type="button" class="btn btn-primary" disabled="@_isSaving" @onclick="SaveAsync">
                            <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? "Enregistrement…" : "Sauvegarder")
                        </button>
                    </div>
                    break;

                case "criteria":
                    <div class="glpi-fiche-block">
                        <div class="glpi-fiche-block-title"><i class="ti ti-filter"></i>Critères (@_rule.Criteria.Count)</div>
                        <p class="text-secondary">
                            Une règle s'applique si l'ensemble de ses critères, combinés par l'opérateur logique
                            de l'onglet « Règle » (@(_rule.LogicalOperator == ImportAssignmentRuleLogicalOperator.Or ? "OU" : "ET")), est vérifié —
                            le moteur s'arrête à la première règle vérifiée.
                        </p>

                        @if (_rule.Criteria.Count > 0)
                        {
                            <div class="table-responsive mb-3">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Champ</th>
                                            <th>Opérateur</th>
                                            <th>Valeur</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ImportAssignmentRuleCriterion criterion in _rule.Criteria)
                                        {
                                            <tr>
                                                <td>@ImportAssignmentRuleFieldCatalog.Label(criterion.Field)</td>
                                                <td>@ImportAssignmentRuleLabels.OperatorLabel(criterion.Operator)</td>
                                                <td>@(ImportAssignmentRuleLabels.IsValuelessOperator(criterion.Operator) ? "—" : criterion.Value)</td>
                                                <td class="text-end">
                                                    <button type="button" class="btn btn-sm btn-icon text-danger" @onclick="() => RemoveCriterionAsync(criterion)">
                                                        <i class="ti ti-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <div class="row g-2 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label">Champ</label>
                                <select class="form-select" @bind="_newCriterion.Field">
                                    @foreach (ImportAssignmentRuleFieldDefinition field in ImportAssignmentRuleFieldCatalog.All)
                                    {
                                        <option value="@field.Key">@field.Label</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Opérateur</label>
                                <select class="form-select" @bind="_newCriterion.Operator">
                                    @foreach (ImportAssignmentRuleCriterionOperator op in Enum.GetValues<ImportAssignmentRuleCriterionOperator>())
                                    {
                                        <option value="@op">@ImportAssignmentRuleLabels.OperatorLabel(op)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Valeur</label>
                                @if (ImportAssignmentRuleLabels.IsValuelessOperator(_newCriterion.Operator))
                                {
                                    <input class="form-control" disabled placeholder="—" />
                                }
                                else
                                {
                                    <input class="form-control" @bind="_newCriterion.Value"
                                           placeholder="@(_newCriterion.Operator is ImportAssignmentRuleCriterionOperator.MatchesRegex or ImportAssignmentRuleCriterionOperator.NotMatchesRegex ? "expression régulière" : "")" />
                                }
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-primary w-100" @onclick="AddCriterionAsync">
                                    <i class="ti ti-plus me-1"></i>Ajouter
                                </button>
                            </div>
                        </div>
                    </div>
                    break;

                case "actions":
                    <div class="glpi-fiche-block">
                        <div class="glpi-fiche-block-title"><i class="ti ti-bolt"></i>Actions (@_rule.Actions.Count)</div>
                        <p class="text-secondary">
                            <i class="ti ti-info-circle me-1"></i>Seule la première règle vérifiée s'applique : ses actions sont
                            exécutées, les règles suivantes ne sont pas évaluées.
                        </p>

                        @if (_rule.Actions.Count > 0)
                        {
                            <div class="table-responsive mb-3">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Type d'action</th>
                                            <th>Valeur</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ImportAssignmentRuleAction action in _rule.Actions)
                                        {
                                            <tr>
                                                <td>@ImportAssignmentRuleLabels.ActionTypeLabel(action.ActionType)</td>
                                                <td>@(ImportAssignmentRuleLabels.ActionHasValue(action.ActionType) ? action.Value : "—")</td>
                                                <td class="text-end">
                                                    <button type="button" class="btn btn-sm btn-icon text-danger" @onclick="() => RemoveActionAsync(action)">
                                                        <i class="ti ti-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <div class="row g-2 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label">Type d'action</label>
                                <select class="form-select" @bind="_newAction.ActionType">
                                    @foreach (ImportAssignmentRuleActionType actionType in Enum.GetValues<ImportAssignmentRuleActionType>())
                                    {
                                        <option value="@actionType">@ImportAssignmentRuleLabels.ActionTypeLabel(actionType)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">Valeur</label>
                                @if (ImportAssignmentRuleLabels.ActionHasValue(_newAction.ActionType))
                                {
                                    <input class="form-control" @bind="_newAction.Value"
                                           placeholder="@(_newAction.ActionType == ImportAssignmentRuleActionType.AssignLocation ? "nom du lieu" : "nom d'utilisateur")" />
                                }
                                else
                                {
                                    <input class="form-control" disabled placeholder="—" />
                                }
                            </div>
                            <div class="col-md-3">
                                <button type="button" class="btn btn-primary w-100" @onclick="AddActionAsync">
                                    <i class="ti ti-plus me-1"></i>Ajouter
                                </button>
                            </div>
                        </div>
                    </div>
                    break;
            }
        </div>
    </div>
}
