@page "/parc/printers"
@rendermode InteractiveServer

<PageTitle>GlpiNg — Matériels réseau</PageTitle>

<div class="glpi-list-page">
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between glpi-list-toolbar">
        <div class="btn-list">
            <SearchCriteriaPanel Fields="SearchFields" Criteria="_criteria" DistinctValues="DistinctValues" OnApply="ApplyFilterAndSort" />
            <SortCriteriaPanel Fields="SearchFields" SortCriteria="_sortCriteria" OnApply="ApplyFilterAndSort" />
        </div>

        <div class="btn-list align-items-center">
            <label class="form-check m-0 px-2" title="Tout sélectionner">
                <input class="form-check-input m-0" type="checkbox" checked="@AllSelected"
                       @onchange="@((ChangeEventArgs e) => ToggleSelectAll((bool)(e.Value ?? false)))" />
            </label>

            <div class="dropdown">
                <button type="button" class="btn btn-icon text-danger" data-bs-toggle="dropdown" aria-expanded="false"
                        disabled="@(_selectedIds.Count == 0)" title="Supprimer la sélection">
                    <i class="ti ti-trash"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 260px;">
                    <p class="mb-2">Supprimer @_selectedIds.Count élément(s) sélectionné(s) ? Cette action est définitive.</p>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-sm">Annuler</button>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteSelectedAsync">Supprimer</button>
                    </div>
                </div>
            </div>

            <button type="button" class="btn btn-icon" @onclick="LoadAsync" title="Rafraîchir">
                <i class="ti ti-refresh"></i>
            </button>

            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newItemModal">
                <i class="ti ti-plus me-1"></i>Ajouter
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th style="width: 2.5rem;">
                        @* Ne coche que les lignes affichées — la page courante là où le tableau est
                           paginé : cocher ici ne doit jamais engager plus que ce qu'on voit. *@
                        <input class="form-check-input m-0" type="checkbox" title="Sélectionner les éléments visibles"
                               checked="@AllSelected"
                               @onchange="@((ChangeEventArgs e) => ToggleSelectAll((bool)(e.Value ?? false)))" />
                    </th>
                    <th style="width: 2rem;"></th>
                    <th class="glpi-sortable-th" @onclick='() => SetSort("name")'>Nom @SortIndicator("name")</th>
                    <th class="glpi-sortable-th" @onclick='() => SetSort("status")'>Statut @SortIndicator("status")</th>
                    <th class="glpi-sortable-th" @onclick='() => SetSort("manufacturer")'>Fabricant @SortIndicator("manufacturer")</th>
                    <th class="glpi-sortable-th" @onclick='() => SetSort("location")'>Lieu @SortIndicator("location")</th>
                    <th class="glpi-sortable-th" @onclick='() => SetSort("type")'>Type @SortIndicator("type")</th>
                    <th class="glpi-sortable-th" @onclick='() => SetSort("model")'>Modèle @SortIndicator("model")</th>
                    <th>Cartouches</th>
                </tr>
            </thead>
            <tbody>
                @if (_filtered.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center text-secondary py-4">Aucune imprimante trouvée.</td>
                    </tr>
                }
                else
                {
                    @foreach (Printer item in _paged)
                    {
                        List<Cartridge> cartridges = CartridgesOf(item.Id);
                        bool isExpanded = _expandedIds.Contains(item.Id);

                        <tr>
                            <td>
                                <input class="form-check-input m-0" type="checkbox" checked="@_selectedIds.Contains(item.Id)"
                                       @onchange="@((ChangeEventArgs e) => ToggleSelect(item.Id, (bool)(e.Value ?? false)))" />
                            </td>
                            <td>
                                @* Le chevron n'apparaît que s'il y a quelque chose à déplier : une
                                   imprimante sans cartouche en service ne doit pas inviter à un
                                   clic qui n'ouvrirait rien. *@
                                @if (cartridges.Count > 0)
                                {
                                    <i class="ti @(isExpanded ? "ti-chevron-down" : "ti-chevron-right") text-secondary cursor-pointer"
                                       role="button" @onclick="() => ToggleExpanded(item.Id)"></i>
                                }
                            </td>
                            <td>
                                <a href="@($"/parc/printers/{item.Id}")" class="text-reset fw-semibold">
                                    <i class="ti ti-printer me-1 text-secondary"></i>@item.Name
                                </a>
                            </td>
                            <td><StatusBadge Status="item.StatusItem" /></td>
                            <td>@(item.Manufacturer ?? "—")</td>
                            <td>@(item.LocationItem?.Name ?? "—")</td>
                            <td>@(item.Type ?? "—")</td>
                            <td>@(item.Model ?? "—")</td>
                            <td>
                                @if (cartridges.Count == 0)
                                {
                                    <span class="text-secondary">—</span>
                                }
                                else
                                {
                                    <span class="text-secondary me-2">@cartridges.Count</span>
                                    @* Le plus bas niveau résume la ligne repliée : une imprimante
                                       n'est utilisable que jusqu'à ce que sa cartouche la plus
                                       basse soit vide. *@
                                    @if (LowestLevel(item.Id) is { } lowest)
                                    {
                                        <span class="badge @LevelBadgeCss(lowest)">@lowest&nbsp;%</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-lt" title="Aucun relevé SNMP : voir l'OID sur la référence de cartouche et les paramètres SNMP de l'imprimante.">
                                            non relevé
                                        </span>
                                    }
                                }
                            </td>
                        </tr>

                        @if (isExpanded)
                        {
                            <tr>
                                <td colspan="2"></td>
                                <td colspan="7" class="pb-3">
                                    <table class="table table-sm table-vcenter mb-0">
                                        <thead>
                                            <tr>
                                                <th>Cartouche</th>
                                                <th>Type</th>
                                                <th>Niveau</th>
                                                <th>Relevé le</th>
                                                <th>Installée le</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (Cartridge cartridge in cartridges)
                                            {
                                                <tr>
                                                    <td>
                                                        <a href="@($"/parc/cartridge-items/{cartridge.CartridgeItemId}")" class="text-reset">
                                                            <i class="ti ti-droplet me-1 text-secondary"></i>@(cartridge.CartridgeItem?.Name ?? "—")
                                                        </a>
                                                    </td>
                                                    <td>@(cartridge.CartridgeItem?.Type ?? "—")</td>
                                                    <td>
                                                        @if (cartridge.LevelPercent is { } level)
                                                        {
                                                            <span class="badge @LevelBadgeCss(level)">@level&nbsp;%</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-secondary">—</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @* La date accompagne toujours le niveau : un relevé d'il y a
                                                           trois mois ne se lit pas comme celui de ce matin. *@
                                                        @(cartridge.LevelReadAt is { } read
                                                            ? read.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                                            : "—")
                                                    </td>
                                                    <td>@(cartridge.DateUse is { } used ? used.ToLocalTime().ToString("dd/MM/yyyy") : "—")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="card-footer d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2 text-secondary">
            <span>Éléments par page</span>
            <select class="form-select form-select-sm w-auto" value="@_pageSize"
                    @onchange="@((ChangeEventArgs e) => SetPageSize(int.Parse((string)e.Value!)))">
                @foreach (int size in PageSizeOptions)
                {
                    <option value="@size">@size</option>
                }
            </select>
        </div>

        @if (_filtered.Count > 0)
        {
            <div class="d-flex align-items-center gap-3">
                <span class="text-secondary">
                    @(((_currentPage - 1) * _pageSize) + 1)–@(Math.Min(_currentPage * _pageSize, _filtered.Count)) sur @_filtered.Count
                </span>
                <ul class="pagination pagination-sm m-0">
                    <li class="page-item @(_currentPage <= 1 ? "disabled" : "")">
                        <button type="button" class="page-link" @onclick="() => GoToPage(_currentPage - 1)" disabled="@(_currentPage <= 1)">
                            <i class="ti ti-chevron-left"></i>
                        </button>
                    </li>
                    <li class="page-item disabled"><span class="page-link">Page @_currentPage / @TotalPages</span></li>
                    <li class="page-item @(_currentPage >= TotalPages ? "disabled" : "")">
                        <button type="button" class="page-link" @onclick="() => GoToPage(_currentPage + 1)" disabled="@(_currentPage >= TotalPages)">
                            <i class="ti ti-chevron-right"></i>
                        </button>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>
</div>

<div class="modal fade" id="newItemModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ti ti-printer me-2"></i>Nouvel élément - Imprimante</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <PrinterFormFields Item="_newItem" StatusOptions="_statusOptions" LocationOptions="_locationOptions" OnChanged="StateHasChanged" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" disabled="@string.IsNullOrWhiteSpace(_newItem.Name)" @onclick="CreateAsync">
                    <i class="ti ti-plus me-1"></i>Ajouter
                </button>
            </div>
        </div>
    </div>
</div>
