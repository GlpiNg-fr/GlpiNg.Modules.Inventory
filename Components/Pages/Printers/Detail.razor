@page "/parc/printers/{ItemId:int}"
@using GlpiNg.Modules.Inventory.Models
@using GlpiNg.Modules.Inventory.Services
@rendermode InteractiveServer

<PageTitle>@(_item?.Name ?? "Imprimante") — GlpiNg</PageTitle>

@if (_item is null)
{
    <div class="text-center text-secondary py-5">
        <i class="ti ti-printer-off fs-1"></i>
        <p class="mt-2">Cette imprimante est introuvable.</p>
    </div>
}
else
{
    <div class="glping-fiche-topbar">
        <div class="glping-fiche-crumb">
            <i class="ti ti-printer"></i>
            <span>Imprimante - @_item.Name - ID @_item.Id</span>
        </div>
        <div class="glping-fiche-toolbar">
            @if (_total > 0)
            {
                <span class="glping-fiche-pager-count">@_position/@_total</span>
                <a class="glping-fiche-pager-btn @(_previousId is null ? "disabled" : "")" href="@(_previousId is { } prevId ? $"/parc/printers/{prevId}" : "#")">
                    <i class="ti ti-chevron-left"></i>
                </a>
                <a class="glping-fiche-pager-btn @(_nextId is null ? "disabled" : "")" href="@(_nextId is { } nextId ? $"/parc/printers/{nextId}" : "#")">
                    <i class="ti ti-chevron-right"></i>
                </a>
            }
        </div>
    </div>

    <div class="glping-fiche-layout">
        <aside class="glping-fiche-sidebar">
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "main" ? "active" : "")" @onclick='() => SetTab("main")'>
                <i class="ti ti-printer"></i>
                <span>Imprimante</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "cartridges" ? "active" : "")" @onclick='() => SetTab("cartridges")'>
                <i class="ti ti-droplet"></i>
                <span>Cartouches</span>
                <span class="glping-fiche-tab-count">@InstalledCartridges.Count()</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "history" ? "active" : "")" @onclick='() => SetTab("history")'>
                <i class="ti ti-history"></i>
                <span>Historique</span>
                <span class="glping-fiche-tab-count">@_item.HistoryEntries.Count</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "links" ? "active" : "")" @onclick='() => SetTab("links")'>
                <i class="ti ti-external-link"></i>
                <span>Liens externes</span>
            </button>
        </aside>

        <div class="glping-fiche-panel">
            @switch (_activeTabKey)
            {
                case "main":
                    <EditForm Model="_item" OnValidSubmit="SaveAsync">
                        <PrinterFormFields Item="_item" StatusOptions="_statusOptions" LocationOptions="_locationOptions" />

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync">
                                <i class="ti ti-trash me-1"></i>Supprimer définitivement
                            </button>
                            <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? "Enregistrement…" : "Sauvegarder")
                            </button>
                        </div>
                    </EditForm>
                    break;

                case "cartridges":
                    @* Les deux moitiés de la question : ce qui est dans l'imprimante en ce moment,
                       et ce qui y est passé. La seconde est ce qui permet de voir la consommation
                       d'une imprimante sans avoir à ouvrir chaque référence de cartouche. *@
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-droplet"></i>Cartouches en service (@InstalledCartridges.Count())</div>

                        @if (_cartridgeError is { } cartridgeError)
                        {
                            <div class="alert alert-danger py-2 px-3 mb-2" role="alert">
                                <i class="ti ti-alert-circle me-1"></i>@cartridgeError
                            </div>
                        }

                        @if (!InstalledCartridges.Any())
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-droplet-off"></i>
                                <p class="mb-0">Aucune cartouche installée sur cette imprimante.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Référence</th>
                                            <th>Type</th>
                                            <th>Unité</th>
                                            <th>Niveau</th>
                                            <th>Installée le</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (Cartridge cartridge in InstalledCartridges)
                                        {
                                            <tr>
                                                <td>
                                                    <a href="/parc/cartridge-items/@cartridge.CartridgeItemId">@(cartridge.CartridgeItem?.Name ?? "—")</a>
                                                </td>
                                                <td>@(cartridge.CartridgeItem?.Type ?? "—")</td>
                                                <td>#@cartridge.Id</td>
                                                <td>
                                                    @if (cartridge.LevelPercent is { } level)
                                                    {
                                                        @* La date du relevé accompagne toujours le niveau : un niveau
                                                           d'il y a trois mois ne se lit pas comme celui de ce matin. *@
                                                        <span class="badge @(level <= 10 ? "bg-red-lt" : level <= 25 ? "bg-orange-lt" : "bg-green-lt")"
                                                              title="@(cartridge.LevelReadAt is { } read ? $"Relevé le {Display.DateTime(read)}" : null)">
                                                            @level&nbsp;%
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-secondary">—</span>
                                                    }
                                                </td>
                                                <td>@(cartridge.DateUse is { } used ? Display.Date(used) : "—")</td>
                                                <td class="text-end">
                                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveCartridgeAsync(cartridge)">
                                                        Retirer
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <div class="glping-fiche-add-row">
                            <div class="d-flex gap-2 align-items-center flex-wrap">
                                <select class="form-select" style="max-width: 360px;" value="@_itemToInstall"
                                        @onchange="@((ChangeEventArgs e) => _itemToInstall = int.Parse((string)e.Value!))">
                                    <option value="0">-- Référence à installer --</option>
                                    @foreach (CartridgeItem item in _installableItems)
                                    {
                                        <option value="@item.Id">@item.Name (@AvailableStock(item) en stock)</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-primary" disabled="@(_itemToInstall == 0)" @onclick="InstallCartridgeAsync">
                                    <i class="ti ti-plus me-1"></i>Installer
                                </button>
                            </div>
                            @if (_installableItems.Count == 0)
                            {
                                <p class="hint mt-2 mb-0">
                                    Aucune référence n'a d'unité en stock. Réceptionnez-en une depuis
                                    <a href="/parc/cartridge-items">Cartouches</a> avant de pouvoir l'installer.
                                </p>
                            }
                            else
                            {
                                <p class="hint mt-2 mb-0">
                                    L'unité la plus anciennement reçue est installée en premier : un consommable
                                    se périme, et le fond de stock ne doit pas vieillir pendant qu'on entame les
                                    arrivages.
                                </p>
                            }
                        </div>
                    </div>

                    @if (PastCartridges.Any())
                    {
                        <div class="glping-fiche-block">
                            <div class="glping-fiche-block-title"><i class="ti ti-history"></i>Cartouches retirées (@PastCartridges.Count())</div>
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Référence</th>
                                            <th>Unité</th>
                                            <th>Installée le</th>
                                            <th>Retirée le</th>
                                            <th>Durée</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (Cartridge cartridge in PastCartridges.OrderByDescending(c => c.DateOut))
                                        {
                                            <tr class="text-secondary">
                                                <td>
                                                    <a href="/parc/cartridge-items/@cartridge.CartridgeItemId">@(cartridge.CartridgeItem?.Name ?? "—")</a>
                                                </td>
                                                <td>#@cartridge.Id</td>
                                                <td>@(cartridge.DateUse is { } from ? Display.Date(from) : "—")</td>
                                                <td>@(cartridge.DateOut is { } to ? Display.Date(to) : "—")</td>
                                                <td>
                                                    @(cartridge is { DateUse: { } start, DateOut: { } end }
                                                        ? $"{(int)(end - start).TotalDays} jour(s)"
                                                        : "—")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    break;

                case "history":
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-history"></i>Historique (@_item.HistoryEntries.Count)</div>
                        @if (_item.HistoryEntries.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-history"></i>
                                <p class="mb-0">Aucune modification enregistrée.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Date</th>
                                            <th>Utilisateur</th>
                                            <th>Champ</th>
                                            <th>Mise à jour</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (PrinterHistoryEntry entry in Display.Chronological(_item.HistoryEntries, e => e.OccurredAt))
                                        {
                                            <tr>
                                                <td>@entry.Id</td>
                                                <td>@Display.DateTime(entry.OccurredAt)</td>
                                                <td>@entry.User</td>
                                                <td>@entry.Field</td>
                                                <td>@entry.Description</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    break;

                case "links":
                    <ExternalLinksPanel ItemType="@ExternalLinkTagSource.PrinterItemType"
                                        Tags="@ExternalLinkTagSource.For(_item)" />
                    break;
            }
        </div>
    </div>
}
