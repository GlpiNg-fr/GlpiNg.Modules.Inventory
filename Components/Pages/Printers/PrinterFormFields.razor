@using GlpiNg.Modules.Inventory.Models

<div class="row">
    <div class="col-md-6">
        <div class="glping-fiche-field">
            <label>@T("Nom")</label>
            <input class="form-control" @bind="Item.Name" @bind:event="oninput" @bind:after="NotifyChangedAsync" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Statut")</label>
            <select class="form-select" value="@(Item.StatusId?.ToString() ?? "")"
                    @onchange="@((ChangeEventArgs e) => Item.StatusId = string.IsNullOrEmpty((string?)e.Value) ? null : int.Parse((string)e.Value!))">
                <option value="">—</option>
                @foreach (DropdownItem status in StatusOptions)
                {
                    <option value="@status.Id">@status.Name</option>
                }
            </select>
        </div>
        <div class="glping-fiche-field">
            <label>@T("Lieu")</label>
            <select class="form-select" value="@(Item.LocationId?.ToString() ?? "")"
                    @onchange="@((ChangeEventArgs e) => Item.LocationId = string.IsNullOrEmpty((string?)e.Value) ? null : int.Parse((string)e.Value!))">
                <option value="">—</option>
                @foreach (DropdownItem location in LocationOptions)
                {
                    <option value="@location.Id">@location.Name</option>
                }
            </select>
        </div>
        <div class="glping-fiche-field">
            <label>@T("Type")</label>
            <input class="form-control" @bind="Item.Type" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Technicien responsable")</label>
            <input class="form-control" @bind="Item.TechnicianInCharge" />
        </div>
    </div>
    <div class="col-md-6">
        <div class="glping-fiche-field">
            <label>@T("Fabricant")</label>
            <input class="form-control" @bind="Item.Manufacturer" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Modèle")</label>
            <input class="form-control" @bind="Item.Model" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Numéro de série")</label>
            <input class="form-control" @bind="Item.SerialNumber" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Numéro d'inventaire")</label>
            <input class="form-control" @bind="Item.InventoryNumber" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Utilisateur")</label>
            <input class="form-control" @bind="Item.AssignedUser" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("UUID")</label>
            <input class="form-control" @bind="Item.Uuid" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Compteur de page initial")</label>
            <input type="number" class="form-control" value="@Item.InitialPageCount"
                   @onchange="@((ChangeEventArgs e) => Item.InitialPageCount = string.IsNullOrEmpty((string?)e.Value) ? null : int.Parse((string)e.Value!))" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Compteur de page actuel")</label>
            <input type="number" class="form-control" value="@Item.CurrentPageCount"
                   @onchange="@((ChangeEventArgs e) => Item.CurrentPageCount = string.IsNullOrEmpty((string?)e.Value) ? null : int.Parse((string)e.Value!))" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Commentaires")</label>
            <textarea class="form-control" rows="4" @bind="Item.Comment"></textarea>
        </div>
    </div>
</div>

<hr class="my-3" />

@* Interrogation SNMP. Les champs suivent la version choisie : montrer une communauté à côté d'une
   passphrase v3 laisserait croire que les deux servent, alors qu'elles s'excluent. *@
<div class="glping-config-divider">
    <span><i class="ti ti-network"></i> @T("Interrogation SNMP")</span>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="glping-fiche-field">
            <label>@T("Adresse IP")</label>
            <input class="form-control @(IpLooksValid ? "" : "is-invalid")" placeholder="192.168.1.50"
                   @bind="Item.IpAddress" @bind:event="oninput" />
        </div>
        @if (!IpLooksValid)
        {
            <div class="glping-fiche-field">
                <label></label>
                <div class="text-danger small">@T("Adresse IPv4 ou IPv6 attendue.")</div>
            </div>
        }
        <div class="glping-fiche-field">
            <label>@T("Version SNMP")</label>
            <select class="form-select" value="@((int)Item.SnmpVersion)"
                    @onchange="@((ChangeEventArgs e) => SetVersion(int.Parse((string)e.Value!)))">
                <option value="0">@T("Aucune (pas d'interrogation)")</option>
                <option value="1">v1</option>
                <option value="2">v2c</option>
                <option value="3">v3</option>
            </select>
        </div>
        @if (Item.SnmpVersion != PrinterSnmpVersion.None)
        {
            <div class="glping-fiche-field">
                <label>@T("Port")</label>
                <input type="number" class="form-control" value="@Item.SnmpPort"
                       @onchange="@((ChangeEventArgs e) => Item.SnmpPort = int.TryParse((string?)e.Value, out int port) ? port : 161)" />
            </div>
        }
    </div>

    <div class="col-md-6">
        @if (Item.SnmpVersion is PrinterSnmpVersion.V1 or PrinterSnmpVersion.V2c)
        {
            <div class="glping-fiche-field">
                <label>@T("Communauté") <span class="text-danger">*</span></label>
                <input class="form-control @(string.IsNullOrWhiteSpace(Item.SnmpCommunity) ? "is-invalid" : "")"
                       placeholder="@(T("public"))" @bind="Item.SnmpCommunity" @bind:event="oninput" />
            </div>
            <div class="glping-fiche-field">
                <label></label>
                <div class="text-secondary small">@T("Requise en v1 et v2c : c'est le seul secret que ces versions connaissent.")</div>
            </div>
        }
        else if (Item.SnmpVersion == PrinterSnmpVersion.V3)
        {
            <div class="glping-fiche-field">
                <label>@T("Nom de sécurité") <span class="text-danger">*</span></label>
                <input class="form-control @(string.IsNullOrWhiteSpace(Item.SnmpUsername) ? "is-invalid" : "")"
                       @bind="Item.SnmpUsername" @bind:event="oninput" />
            </div>

            <div class="glping-fiche-field">
                <label>@T("Authentification")</label>
                <select class="form-select" value="@((int)Item.SnmpAuthProtocol)"
                        @onchange="@((ChangeEventArgs e) => SetAuthProtocol(int.Parse((string)e.Value!)))">
                    <option value="0">@T("Aucune (noAuthNoPriv)")</option>
                    <option value="1">@T("MD5")</option>
                    <option value="2">@T("SHA")</option>
                    <option value="3">@T("SHA-224")</option>
                    <option value="4">@T("SHA-256")</option>
                    <option value="5">@T("SHA-384")</option>
                    <option value="6">@T("SHA-512")</option>
                </select>
            </div>

            @if (Item.SnmpAuthProtocol != PrinterSnmpAuthProtocol.None)
            {
                <div class="glping-fiche-field">
                    <label>@T("Phrase d'authentification") <span class="text-danger">*</span></label>
                    <input type="password" class="form-control @(string.IsNullOrEmpty(Item.SnmpAuthPassphrase) ? "is-invalid" : "")"
                           autocomplete="new-password" @bind="Item.SnmpAuthPassphrase" @bind:event="oninput" />
                </div>

                @* Le chiffrement n'est proposé qu'une fois l'authentification choisie : authPriv
                   suppose authNoPriv, il n'existe pas de mode chiffré sans authentification. *@
                <div class="glping-fiche-field">
                    <label>@T("Chiffrement")</label>
                    <select class="form-select" value="@((int)Item.SnmpPrivProtocol)"
                            @onchange="@((ChangeEventArgs e) => SetPrivProtocol(int.Parse((string)e.Value!)))">
                        <option value="0">@T("Aucun (authNoPriv)")</option>
                        <option value="1">@T("DES")</option>
                        <option value="2">@T("AES-128")</option>
                        <option value="3">@T("Triple DES")</option>
                        <option value="4">@T("Cisco AES-192")</option>
                        <option value="5">@T("Cisco AES-256")</option>
                        <option value="6">@T("AES-192 (IETF)")</option>
                        <option value="7">@T("AES-256 (IETF)")</option>
                    </select>
                </div>

                @if (Item.SnmpPrivProtocol != PrinterSnmpPrivProtocol.None)
                {
                    <div class="glping-fiche-field">
                        <label>@T("Phrase de chiffrement") <span class="text-danger">*</span></label>
                        <input type="password" class="form-control @(string.IsNullOrEmpty(Item.SnmpPrivPassphrase) ? "is-invalid" : "")"
                               autocomplete="new-password" @bind="Item.SnmpPrivPassphrase" @bind:event="oninput" />
                    </div>
                }
            }
            else
            {
                <div class="glping-fiche-field">
                    <label></label>
                    <div class="text-secondary small">
                        @T("Sans authentification, le chiffrement n'est pas possible : SNMPv3 n'a pas de mode « chiffré mais anonyme ».")
                    </div>
                </div>
            }
        }
    </div>
</div>

@if (SnmpIncomplete is { } missing)
{
    <div class="alert alert-warning py-2 px-3" role="alert">
        <i class="ti ti-alert-triangle me-1"></i>
        @T("Interrogation SNMP incomplète : {0}. Tant qu'il manque quelque chose, l'imprimante ne sera pas interrogée — l'enregistrement reste possible.", missing)
    </div>
}

<hr class="my-3" />

<EntityScopeFields Item="Item" />

@code {
    /// <summary>
    /// Ce qui manque pour que l'imprimante soit interrogeable, ou <c>null</c> si tout y est.
    ///
    /// Signalé sans bloquer l'enregistrement : une fiche d'imprimante vaut d'être conservée même
    /// incomplète côté SNMP, et un blocage obligerait à tout ressaisir pour corriger un nom.
    /// </summary>
    private string? SnmpIncomplete
    {
        get
        {
            if (Item.SnmpVersion == PrinterSnmpVersion.None)
            {
                return null;
            }

            List<string> missing = [];

            if (string.IsNullOrWhiteSpace(Item.IpAddress)) missing.Add("adresse IP");

            if (Item.SnmpVersion is PrinterSnmpVersion.V1 or PrinterSnmpVersion.V2c)
            {
                if (string.IsNullOrWhiteSpace(Item.SnmpCommunity)) missing.Add("communauté");
            }
            else
            {
                if (string.IsNullOrWhiteSpace(Item.SnmpUsername)) missing.Add("nom de sécurité");
                if (Item.SnmpAuthProtocol != PrinterSnmpAuthProtocol.None && string.IsNullOrEmpty(Item.SnmpAuthPassphrase))
                {
                    missing.Add("phrase d'authentification");
                }

                if (Item.SnmpPrivProtocol != PrinterSnmpPrivProtocol.None && string.IsNullOrEmpty(Item.SnmpPrivPassphrase))
                {
                    missing.Add("phrase de chiffrement");
                }
            }

            return missing.Count == 0 ? null : string.Join(", ", missing);
        }
    }

    /// <summary>Adresse acceptée telle que saisie, vide comprise : c'est l'avertissement qui dit
    /// qu'elle manque, pas ce contrôle-ci, qui ne juge que la forme.</summary>
    private bool IpLooksValid => string.IsNullOrWhiteSpace(Item.IpAddress)
        || System.Net.IPAddress.TryParse(Item.IpAddress.Trim(), out _);

    /// <summary>
    /// Change de version en effaçant ce qui n'a plus cours. Laisser une communauté derrière un
    /// passage en v3 la garderait en base sans qu'aucun écran ne la montre — un secret oublié.
    /// </summary>
    private void SetVersion(int version)
    {
        Item.SnmpVersion = (PrinterSnmpVersion)version;

        if (Item.SnmpVersion is PrinterSnmpVersion.V1 or PrinterSnmpVersion.V2c)
        {
            ClearV3();
        }
        else if (Item.SnmpVersion == PrinterSnmpVersion.V3)
        {
            Item.SnmpCommunity = null;
        }
        else
        {
            Item.SnmpCommunity = null;
            ClearV3();
        }
    }

    private void SetAuthProtocol(int protocol)
    {
        Item.SnmpAuthProtocol = (PrinterSnmpAuthProtocol)protocol;

        if (Item.SnmpAuthProtocol == PrinterSnmpAuthProtocol.None)
        {
            Item.SnmpAuthPassphrase = null;
            SetPrivProtocol(0);
        }
    }

    private void SetPrivProtocol(int protocol)
    {
        Item.SnmpPrivProtocol = (PrinterSnmpPrivProtocol)protocol;

        if (Item.SnmpPrivProtocol == PrinterSnmpPrivProtocol.None)
        {
            Item.SnmpPrivPassphrase = null;
        }
    }

    private void ClearV3()
    {
        Item.SnmpUsername = null;
        Item.SnmpAuthProtocol = PrinterSnmpAuthProtocol.None;
        Item.SnmpAuthPassphrase = null;
        Item.SnmpPrivProtocol = PrinterSnmpPrivProtocol.None;
        Item.SnmpPrivPassphrase = null;
    }

    [Parameter, EditorRequired]
    public Printer Item { get; set; } = null!;

    [Parameter, EditorRequired]
    public List<DropdownItem> StatusOptions { get; set; } = [];

    [Parameter, EditorRequired]
    public List<DropdownItem> LocationOptions { get; set; } = [];

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private Task NotifyChangedAsync() => OnChanged.InvokeAsync();
}
