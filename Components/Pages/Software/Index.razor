@page "/parc/software"
@rendermode InteractiveServer

<PageTitle>@T("Logiciels — GlpiNg")</PageTitle>

<div class="glping-list-page">
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between glping-list-toolbar">
        <div class="btn-list">
            <div class="dropdown">
                <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                    <i class="ti ti-search me-1"></i>@T("Rechercher")
                    @if (ActiveCriteriaCount > 0)
                    {
                        <span class="badge bg-blue-lt ms-1">@ActiveCriteriaCount</span>
                    }
                </button>
                <div class="dropdown-menu p-3" style="min-width: 640px;">
                    @for (int criterionIndex = 0; criterionIndex < _criteria.Count; criterionIndex++)
                    {
                        SearchCriterion criterion = _criteria[criterionIndex];
                        SearchFieldDefinition? field = FindField(criterion.FieldKey);

                        <div class="row g-2 align-items-center mb-2">
                            <div class="col-auto" style="width: 5.5rem;">
                                @if (criterionIndex == 0)
                                {
                                    <span class="text-secondary">@T("PAS")</span>
                                }
                                else
                                {
                                    <select class="form-select form-select-sm" value="@criterion.Link"
                                            @onchange="@((ChangeEventArgs e) => criterion.Link = (string)e.Value!)">
                                        <option value="AND">@T("ET")</option>
                                        <option value="OR">@T("OU")</option>
                                    </select>
                                }
                            </div>
                            <div class="col">
                                <select class="form-select form-select-sm" value="@criterion.FieldKey"
                                        @onchange="@((ChangeEventArgs e) => OnCriterionFieldChanged(criterion, (string)e.Value!))">
                                    @foreach (SearchFieldDefinition option in SearchFields)
                                    {
                                        <option value="@option.Key">@T(option.Label)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-auto" style="width: 10rem;">
                                <select class="form-select form-select-sm" value="@criterion.Operator"
                                        @onchange="@((ChangeEventArgs e) => criterion.Operator = (string)e.Value!)">
                                    @foreach ((string opValue, string opLabel) in GetOperators(field))
                                    {
                                        <option value="@opValue">@opLabel</option>
                                    }
                                </select>
                            </div>
                            <div class="col">
                                @if (criterion.Operator != "empty")
                                {
                                    @if (field?.Type == SearchFieldType.Text && (criterion.Operator == "equals" || criterion.Operator == "notequals"))
                                    {
                                        <select class="form-select form-select-sm" value="@criterion.Value"
                                                @onchange="@((ChangeEventArgs e) => criterion.Value = (string)e.Value!)">
                                            <option value="">—</option>
                                            @foreach (string distinctValue in GetDistinctTextValues(field.Key))
                                            {
                                                <option value="@distinctValue">@distinctValue</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <input type="@(field?.Type == SearchFieldType.Number ? "number" : "text")" class="form-control form-control-sm"
                                               value="@criterion.Value"
                                               @onchange="@((ChangeEventArgs e) => criterion.Value = (string)(e.Value ?? string.Empty))" />
                                    }
                                }
                            </div>
                            <div class="col-auto">
                                <button type="button" class="btn btn-icon btn-sm" title="@(T("Supprimer ce critère"))"
                                        disabled="@(_criteria.Count <= 1)" @onclick="() => RemoveCriterion(criterion)">
                                    <i class="ti ti-trash"></i>
                                </button>
                            </div>
                        </div>
                    }

                    <div class="d-flex align-items-center justify-content-between mt-3">
                        <button type="button" class="btn btn-sm" @onclick="AddCriterion">
                            <i class="ti ti-circle-plus me-1"></i>@T("Ajouter un critère")
                        </button>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm" @onclick="ResetSearch">@T("Réinitialiser")</button>
                            <button type="button" class="btn btn-sm btn-primary" @onclick="ApplySearch">
                                <i class="ti ti-search me-1"></i>@T("Rechercher")
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="dropdown">
                <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="@(T("Depuis les en-têtes de colonnes : clic pour trier, Ctrl+clic pour un tri secondaire"))">
                    <i class="ti ti-arrows-sort me-1"></i>@T("Trier")
                    @if (_sortCriteria.Count > 0)
                    {
                        <span class="badge bg-blue-lt ms-1">@_sortCriteria.Count</span>
                    }
                </button>
                <div class="dropdown-menu p-3" style="min-width: 420px;">
                    @if (_sortCriteria.Count == 0)
                    {
                        <p class="text-secondary mb-2">@T("Aucun tri actif.")</p>
                    }
                    @for (int sortIndex = 0; sortIndex < _sortCriteria.Count; sortIndex++)
                    {
                        SortCriterion sortCriterion = _sortCriteria[sortIndex];
                        <div class="row g-2 align-items-center mb-2">
                            <div class="col">
                                <select class="form-select form-select-sm" value="@sortCriterion.Field"
                                        @onchange="@((ChangeEventArgs e) => sortCriterion.Field = (string)e.Value!)">
                                    @foreach (SearchFieldDefinition field in SearchFields.Where(f => f.Key != "all"))
                                    {
                                        <option value="@field.Key">@T(field.Label)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-auto" style="width: 9.5rem;">
                                <select class="form-select form-select-sm" value="@(sortCriterion.Descending ? "desc" : "asc")"
                                        @onchange="@((ChangeEventArgs e) => sortCriterion.Descending = (string)e.Value! == "desc")">
                                    <option value="asc">@T("Croissant")</option>
                                    <option value="desc">@T("Décroissant")</option>
                                </select>
                            </div>
                            <div class="col-auto">
                                <button type="button" class="btn btn-icon btn-sm" title="@(T("Supprimer ce tri"))"
                                        @onclick="() => RemoveSortCriterion(sortCriterion)">
                                    <i class="ti ti-trash"></i>
                                </button>
                            </div>
                        </div>
                    }

                    <div class="d-flex align-items-center justify-content-between mt-3">
                        <button type="button" class="btn btn-sm" disabled="@(_sortCriteria.Count >= SearchFields.Count(f => f.Key != "all"))" @onclick="AddSortCriterion">
                            <i class="ti ti-circle-plus me-1"></i>@T("Ajouter un autre tri")
                        </button>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm" @onclick="ResetSort">@T("Réinitialiser le tri")</button>
                            <button type="button" class="btn btn-sm btn-primary" @onclick="ApplySort">
                                <i class="ti ti-arrows-sort me-1"></i>@T("Trier")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th></th>
                    @{
                        string[] sortableColumns = ["name", "publisher", "versioncount", "installcount"];
                        string[] columnLabels = ["Nom", "Éditeur", "Versions", "Installations"];
                    }
                    @for (int i = 0; i < sortableColumns.Length; i++)
                    {
                        string colKey = sortableColumns[i];
                        string colLabel = columnLabels[i];
                        SortCriterion? active = GetSortCriterion(colKey);
                        <th class="glping-sortable-th" title="@(T("Ctrl+clic pour ajouter un tri secondaire"))"
                            @onclick="@((MouseEventArgs e) => SetSort(colKey, e.CtrlKey))">
                            <span class="d-flex align-items-center gap-1">
                                @T(colLabel)
                                @if (active is not null)
                                {
                                    <span class="glping-sort-indicator">
                                        <i class="ti @(active.Descending ? "ti-caret-up-filled" : "ti-caret-down-filled")"></i>
                                        @if (_sortCriteria.Count > 1)
                                        {
                                            <span class="glping-sort-num">@(_sortCriteria.IndexOf(active) + 1)</span>
                                        }
                                    </span>
                                }
                            </span>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (_filteredGroups.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-secondary py-4">@T("Aucun logiciel trouvé.")</td>
                    </tr>
                }
                else
                {
                    @foreach (SoftwareGroup group in _pagedGroups)
                    {
                        var key = GroupKey(group);
                        var isExpanded = _expandedKeys.Contains(key);
                        <tr class="cursor-pointer" @onclick="() => ToggleGroup(key)">
                            <td>
                                <i class="ti @(isExpanded ? "ti-chevron-down" : "ti-chevron-right") text-secondary"></i>
                            </td>
                            <td class="fw-semibold">
                                <i class="ti ti-apps me-1 text-secondary"></i>@group.Name
                            </td>
                            <td>@(group.Publisher ?? "—")</td>
                            <td>@group.VersionCount</td>
                            <td>@group.InstallCount</td>
                        </tr>
                        @if (isExpanded)
                        {
                            <tr>
                                <td></td>
                                <td colspan="4" class="pb-3">
                                    <table class="table table-sm table-vcenter mb-0">
                                        <thead>
                                            <tr>
                                                <th>@T("Poste")</th>
                                                <th>@T("Version")</th>
                                                <th>@T("Date d'installation")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (SoftwareInstall install in group.Installs)
                                            {
                                                <tr>
                                                    <td>
                                                        <a href="@($"/parc/computer/{install.ComputerId}")" class="text-reset">
                                                            <i class="ti ti-device-desktop me-1 text-secondary"></i>@install.ComputerName
                                                        </a>
                                                    </td>
                                                    <td>@(install.Version ?? "—")</td>
                                                    <td>@(install.InstallDate ?? "—")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="card-footer d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2 text-secondary">
            <span>@T("Éléments par page")</span>
            <select class="form-select form-select-sm w-auto" value="@_pageSize"
                    @onchange="@((ChangeEventArgs e) => SetPageSize(int.Parse((string)e.Value!)))">
                @foreach (int size in PageSizeOptions)
                {
                    <option value="@size">@size</option>
                }
            </select>
        </div>

        @if (_filteredGroups.Count > 0)
        {
            <div class="d-flex align-items-center gap-3">
                <span class="text-secondary">
                    @T("{0}–{1} sur {2}", ((_currentPage - 1) * _pageSize) + 1, Math.Min(_currentPage * _pageSize, _filteredGroups.Count), _filteredGroups.Count)
                </span>
                <ul class="pagination pagination-sm m-0">
                    <li class="page-item @(_currentPage <= 1 ? "disabled" : "")">
                        <button type="button" class="page-link" @onclick="() => GoToPage(_currentPage - 1)" disabled="@(_currentPage <= 1)">
                            <i class="ti ti-chevron-left"></i>
                        </button>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">@T("Page {0} / {1}", _currentPage, TotalPages)</span>
                    </li>
                    <li class="page-item @(_currentPage >= TotalPages ? "disabled" : "")">
                        <button type="button" class="page-link" @onclick="() => GoToPage(_currentPage + 1)" disabled="@(_currentPage >= TotalPages)">
                            <i class="ti ti-chevron-right"></i>
                        </button>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>
</div>
