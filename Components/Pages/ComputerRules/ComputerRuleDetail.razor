@page "/admin/rules/{RuleId:int}"
@using GlpiNg.Modules.Inventory.Services
@rendermode InteractiveServer

<PageTitle>@(_rule?.Name ?? T("Règle métier")) — GlpiNg</PageTitle>

@if (_rule is null)
{
    <div class="text-center text-secondary py-5">
        <i class="ti ti-adjustments-off fs-1"></i>
        <p class="mt-2">@T("Cette règle est introuvable.")</p>
    </div>
}
else
{
    <div class="glping-fiche-layout">
        <aside class="glping-fiche-sidebar">
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "main" ? "active" : "")" @onclick='() => SetTab("main")'>
                <i class="ti ti-adjustments"></i>
                <span>@T("Règle")</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "criteria" ? "active" : "")" @onclick='() => SetTab("criteria")'>
                <i class="ti ti-filter"></i>
                <span>@T("Critères")</span>
                <span class="glping-fiche-tab-count">@_rule.Criteria.Count</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "actions" ? "active" : "")" @onclick='() => SetTab("actions")'>
                <i class="ti ti-bolt"></i>
                <span>@T("Actions")</span>
                <span class="glping-fiche-tab-count">@_rule.Actions.Count</span>
            </button>
        </aside>

        <div class="glping-fiche-panel">
            @switch (_activeTabKey)
            {
                case "main":
                    <div class="row">
                        <div class="col-md-6">
                            <div class="glping-fiche-field">
                                <label>@T("Nom")</label>
                                <input class="form-control" @bind="_rule.Name" @bind:event="oninput" />
                            </div>
                            <div class="glping-fiche-field">
                                <label>@T("Opérateur logique")</label>
                                <select class="form-select" @bind="_rule.LogicalOperator">
                                    <option value="@ComputerRuleLogicalOperator.And">@T("ET (tous les critères)")</option>
                                    <option value="@ComputerRuleLogicalOperator.Or">@T("OU (au moins un critère)")</option>
                                </select>
                            </div>
                            <div class="glping-fiche-field">
                                <label>@T("Actif")</label>
                                @* Valeur et gestionnaire explicites plutot que @bind : sur un <select> lie a un booleen,
                                   Blazor ecrit dans l'attribut value le resultat de bool.ToString(), soit "True" ou
                                   "False". Aucune option en minuscules ne correspondait alors, la liste restait bloquee
                                   sur son premier choix et le modele n'etait jamais mis a jour. *@
                                <select class="form-select" value="@(_rule.IsActive ? "true" : "false")"
                                        @onchange="@((ChangeEventArgs e) => _rule.IsActive = (string?)e.Value == "true")">
                                    <option value="true">@T("Oui")</option>
                                    <option value="false">@T("Non")</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="glping-fiche-field">
                                <label>@T("Règle utilisée pour")</label>
                                <select class="form-select" @bind="_rule.AppliesTo">
                                    <option value="@ComputerRuleAppliesTo.OnCreateAndUpdate">@T("Ajout / Mise à jour")</option>
                                    <option value="@ComputerRuleAppliesTo.OnCreate">@T("Ajout")</option>
                                    <option value="@ComputerRuleAppliesTo.OnUpdate">@T("Mise à jour")</option>
                                    <option value="@(ComputerRuleAppliesTo.OnCreateAndUpdate | ComputerRuleAppliesTo.OnSchedule)">@T("Ajout / Mise à jour / Périodique")</option>
                                    <option value="@ComputerRuleAppliesTo.OnSchedule">@T("Exécution périodique seulement")</option>
                                </select>
                            </div>
                            <div class="glping-fiche-field">
                                <label>@T("Commentaires")</label>
                                <textarea class="form-control" rows="3" @bind="_rule.Comment"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync">
                            <i class="ti ti-trash me-1"></i>@T("Supprimer définitivement")
                        </button>
                        <button type="button" class="btn @(_testPanelOpen ? "btn-secondary" : "btn-outline-secondary")" @onclick="() => _testPanelOpen = !_testPanelOpen">
                            <i class="ti ti-player-play me-1"></i>@T("Tester")
                        </button>
                        <button type="button" class="btn btn-primary" disabled="@_isSaving" @onclick="SaveAsync">
                            <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? T("Enregistrement…") : T("Sauvegarder"))
                        </button>
                    </div>

                    @if (_testPanelOpen)
                    {
                        <div class="glping-fiche-block mt-3">
                            <div class="glping-fiche-block-title"><i class="ti ti-player-play"></i>@T("Tester le moteur de règles")</div>
                            <p class="text-secondary">
                                @T("Prévisualise l'effet de cette règle, telle qu'actuellement enregistrée, sur un ordinateur existant — sans modifier l'ordinateur.")
                            </p>

                            <div class="row g-2 align-items-end mb-3">
                                <div class="col-md-5">
                                    <label class="form-label">@T("Ordinateur")</label>
                                    <select class="form-select" @bind="_testComputerId">
                                        <option value="0">@T("-- Choisir un ordinateur --")</option>
                                        @foreach (Computer computer in _testComputers)
                                        {
                                            <option value="@computer.Id">@computer.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">@T("Mode")</label>
                                    @* Meme correction que le selecteur « Actif » : voir la remarque plus haut. *@
                                    <select class="form-select" value="@(_testIsUpdate ? "true" : "false")"
                                            @onchange="@((ChangeEventArgs e) => _testIsUpdate = (string?)e.Value == "true")">
                                        <option value="false">@T("Simuler un ajout")</option>
                                        <option value="true">@T("Simuler une mise à jour")</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <button type="button" class="btn btn-primary w-100" disabled="@(_testComputerId == 0)" @onclick="RunTestAsync">
                                        <i class="ti ti-player-play me-1"></i>@T("Tester")
                                    </button>
                                </div>
                            </div>

                            @if (_testRan)
                            {
                                @if (!_testMatched)
                                {
                                    <p class="text-secondary"><i class="ti ti-circle-x me-1"></i>@T("Les critères ne correspondent pas à cet ordinateur (ou n'entraînent aucune modification).")</p>
                                }
                                else
                                {
                                    <table class="table table-vcenter card-table mb-0">
                                        <thead>
                                            <tr>
                                                <th>@T("Champ")</th>
                                                <th>@T("Avant")</th>
                                                <th>@T("Après")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var change in _testChanges)
                                            {
                                                <tr>
                                                    <td>@T(change.Label)</td>
                                                    <td>@change.Before</td>
                                                    <td>@change.After</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            }
                        </div>
                    }
                    break;

                case "criteria":
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-filter"></i>@T("Critères ({0})", _rule.Criteria.Count)</div>
                        <p class="text-secondary">
                            @T("Une règle s'applique si l'ensemble de ses critères, combinés par l'opérateur logique")
                            de l'onglet « Règle » (@(_rule.LogicalOperator == ComputerRuleLogicalOperator.Or ? T("OU") : T("ET"))), est vérifié.
                        </p>

                        @if (_rule.Criteria.Count > 0)
                        {
                            <div class="table-responsive mb-3">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("Champ")</th>
                                            <th>@T("Opérateur")</th>
                                            <th>@T("Valeur")</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ComputerRuleCriterion criterion in _rule.Criteria)
                                        {
                                            <tr>
                                                <td>@T(ComputerRuleFieldCatalog.Label(criterion.Field))</td>
                                                <td>@ComputerRuleLabels.OperatorLabel(criterion.Operator)</td>
                                                <td>@(ComputerRuleLabels.IsValuelessOperator(criterion.Operator) ? "—" : criterion.Value)</td>
                                                <td class="text-end">
                                                    <button type="button" class="btn btn-sm btn-icon text-danger" @onclick="() => RemoveCriterionAsync(criterion)">
                                                        <i class="ti ti-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <div class="row g-2 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label">@T("Champ")</label>
                                <select class="form-select" @bind="_newCriterion.Field">
                                    @foreach (ComputerRuleFieldDefinition field in ComputerRuleFieldCatalog.All)
                                    {
                                        <option value="@field.Key">@T(field.Label)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">@T("Opérateur")</label>
                                <select class="form-select" @bind="_newCriterion.Operator">
                                    @foreach (ComputerRuleCriterionOperator op in ComputerRuleLabels.OperatorsFor(_newCriterion.Field))
                                    {
                                        <option value="@op">@ComputerRuleLabels.OperatorLabel(op)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">@T("Valeur")</label>
                                @if (ComputerRuleLabels.IsValuelessOperator(_newCriterion.Operator))
                                {
                                    <input class="form-control" disabled placeholder="—" />
                                }
                                else if (IsStatusField(_newCriterion.Field) && _statusOptions.Count > 0)
                                {
                                    @* Même raison que pour l'action : le statut se compare au nom
                                       exact d'un intitulé, donc il se choisit plutôt qu'il ne se tape. *@
                                    <select class="form-select" @bind="_newCriterion.Value">
                                        <option value="">—</option>
                                        @foreach (string status in _statusOptions)
                                        {
                                            <option value="@status">@status</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input class="form-control" @bind="_newCriterion.Value"
                                           type="@(ComputerRuleLabels.IsDurationOperator(_newCriterion.Operator) ? "number" : "text")"
                                           placeholder="@CriterionValuePlaceholder()" />
                                }
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-primary w-100" @onclick="AddCriterionAsync">
                                    <i class="ti ti-plus me-1"></i>@T("Ajouter")
                                </button>
                            </div>
                        </div>
                    </div>
                    break;

                case "actions":
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-bolt"></i>@T("Actions ({0})", _rule.Actions.Count)</div>
                        <p class="text-secondary">
                            <i class="ti ti-info-circle me-1"></i>@T("Pour « Résultat d'une expression régulière », la valeur peut référencer")
                            @T("les groupes capturés par le dernier critère « correspond à l'expression régulière » ayant validé la règle,")
                            avec la notation <code>#0</code>, <code>#1</code>...
                        </p>

                        @if (_rule.Actions.Count > 0)
                        {
                            <div class="table-responsive mb-3">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("Champ")</th>
                                            <th>@T("Type d'action")</th>
                                            <th>@T("Valeur")</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ComputerRuleAction action in _rule.Actions)
                                        {
                                            <tr>
                                                <td>@T(ComputerRuleFieldCatalog.Label(action.Field))</td>
                                                <td>@ComputerRuleLabels.ActionTypeLabel(action.ActionType)</td>
                                                <td>@action.Value</td>
                                                <td class="text-end">
                                                    <button type="button" class="btn btn-sm btn-icon text-danger" @onclick="() => RemoveActionAsync(action)">
                                                        <i class="ti ti-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <div class="row g-2 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label">@T("Champ")</label>
                                <select class="form-select" value="@_newAction.Field"
                                        @onchange="@((ChangeEventArgs e) => OnActionFieldChanged((string)e.Value!))">
                                    @foreach (ComputerRuleFieldDefinition field in AssignableFields)
                                    {
                                        <option value="@field.Key">@T(field.Label)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">@T("Type d'action")</label>
                                <select class="form-select" @bind="_newAction.ActionType">
                                    @foreach (ComputerRuleActionType actionType in ActionTypesFor(_newAction.Field))
                                    {
                                        <option value="@actionType">@ComputerRuleLabels.ActionTypeLabel(actionType)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">@T("Valeur")</label>
                                @* Le statut se choisit parmi les intitulés existants : le moteur les
                                   rapproche par nom exact et n'en crée pas, donc une saisie libre
                                   rendait la règle silencieusement sans effet à la moindre faute. *@
                                @if (IsStatusField(_newAction.Field))
                                {
                                    @if (_statusOptions.Count == 0)
                                    {
                                        <input class="form-control" value="Aucun statut défini" disabled />
                                    }
                                    else
                                    {
                                        <select class="form-select" @bind="_newAction.Value">
                                            <option value="">—</option>
                                            @foreach (string status in _statusOptions)
                                            {
                                                <option value="@status">@status</option>
                                            }
                                        </select>
                                    }
                                }
                                else
                                {
                                    <input class="form-control" @bind="_newAction.Value" />
                                }
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-primary w-100" @onclick="AddActionAsync">
                                    <i class="ti ti-plus me-1"></i>@T("Ajouter")
                                </button>
                            </div>
                        </div>
                    </div>
                    break;
            }
        </div>
    </div>
}
