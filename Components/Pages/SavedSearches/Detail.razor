@page "/tools/saved-searches/{SavedSearchId:int}"
@rendermode InteractiveServer

<PageTitle>@(_savedSearch?.Name ?? T("Recherche sauvegardée")) — GlpiNg</PageTitle>

@if (_savedSearch is null)
{
    <div class="text-center text-secondary py-5">
        <i class="ti ti-bookmark-off fs-1"></i>
        <p class="mt-2">@T("Cette recherche sauvegardée est introuvable.")</p>
    </div>
}
else
{
    <div class="glping-fiche-topbar">
        <div class="glping-fiche-crumb">
            <i class="ti ti-bookmark"></i>
            <span>@T("Recherche sauvegardée - {0} - ID {1}", _savedSearch.Name, _savedSearch.Id)</span>
        </div>
        <div class="glping-fiche-toolbar">
            @if (_total > 0)
            {
                <span class="glping-fiche-pager-count">@_position/@_total</span>
                <a class="glping-fiche-pager-btn @(_previousId is null ? "disabled" : "")" href="@(_previousId is { } prevId ? $"/tools/saved-searches/{prevId}" : "#")">
                    <i class="ti ti-chevron-left"></i>
                </a>
                <a class="glping-fiche-pager-btn @(_nextId is null ? "disabled" : "")" href="@(_nextId is { } nextId ? $"/tools/saved-searches/{nextId}" : "#")">
                    <i class="ti ti-chevron-right"></i>
                </a>
            }
        </div>
    </div>

    <div class="glping-fiche-layout">
        <aside class="glping-fiche-sidebar">
            @foreach (FicheTab tab in Tabs)
            {
                <button type="button" class="glping-fiche-tab-item @(_activeTabKey == tab.Key ? "active" : "")" @onclick="() => SetTab(tab.Key)">
                    <i class="ti @tab.Icon"></i>
                    <span>@T(tab.Label)</span>
                </button>
            }
        </aside>

        <div class="glping-fiche-panel">
            @switch (_activeTabKey)
            {
                case "savedsearch":
                    <EditForm Model="_savedSearch" OnValidSubmit="SaveAsync">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">@T("Nom")</label>
                                <input type="text" class="form-control" @bind="_savedSearch.Name" disabled="@(!IsOwner)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">@T("Type d'élément")</label>
                                <input type="text" class="form-control" value="@SavedSearchItemTypes.LabelFor(_savedSearch.ItemType)" disabled />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">@T("Compter")</label>
                                <select class="form-select" @bind="_savedSearch.CountMode" disabled="@(!IsOwner)">
                                    <option value="@SavedSearchCountMode.Auto">@T("Auto")</option>
                                    <option value="@SavedSearchCountMode.Yes">@T("Oui")</option>
                                    <option value="@SavedSearchCountMode.No">@T("Non")</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">@T("Visibilité")</label>
                                <select class="form-select" value="@(_savedSearch.IsPublic ? "public" : "private")"
                                        disabled="@(!IsOwner)"
                                        @onchange="@((ChangeEventArgs e) => _savedSearch.IsPublic = (string)e.Value! == "public")">
                                    <option value="private">@T("Privé")</option>
                                    <option value="public">@T("Public")</option>
                                </select>
                            </div>
                        </div>

                        @if (IsOwner)
                        {
                            <div class="d-flex justify-content-end gap-2 mt-3">
                                <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync">
                                    <i class="ti ti-trash me-1"></i>@T("Supprimer définitivement")
                                </button>
                                <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                    <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? T("Enregistrement…") : T("Sauvegarder"))
                                </button>
                            </div>
                        }
                    </EditForm>
                    break;

                case "all":
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-bookmark"></i>@T("Recherche sauvegardée")</div>
                        <p class="mb-1"><strong>@T("Nom :")</strong> @_savedSearch.Name</p>
                        <p class="mb-1"><strong>@T("Type d'élément :")</strong> @SavedSearchItemTypes.LabelFor(_savedSearch.ItemType)</p>
                        <p class="mb-1"><strong>@T("Compter :")</strong> @(_savedSearch.CountMode switch { SavedSearchCountMode.Yes => T("Oui"), SavedSearchCountMode.No => T("Non"), _ => T("Auto") })</p>
                        <p class="mb-1"><strong>@T("Visibilité :")</strong> @(_savedSearch.IsPublic ? T("Public") : T("Privé"))</p>
                        <p class="mb-1"><strong>@T("Par défaut :")</strong> @(_savedSearch.IsDefault ? T("Oui") : T("Non"))</p>
                        <p class="mb-1"><strong>@T("Résultats :")</strong> @_savedSearch.ResultCount</p>
                        <p class="mb-1"><strong>@T("Propriétaire :")</strong> @(_savedSearch.OwnerName ?? "—")</p>
                        <p class="mb-0"><strong>@T("Créée le :")</strong> @Display.DateTime(_savedSearch.CreatedAt)</p>
                    </div>
                    break;

                default:
                    var current = Tabs.First(t => t.Key == _activeTabKey);
                    <div class="glping-config-placeholder">
                        <i class="ti @current.Icon"></i>
                        <p class="mb-0">@T("L'onglet « {0} » n'est pas encore disponible.", current.Label)</p>
                    </div>
                    break;
            }
        </div>
    </div>
}
