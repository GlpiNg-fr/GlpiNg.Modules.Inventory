@page "/tools/saved-searches"
@rendermode InteractiveServer

<PageTitle>Recherches sauvegardées — GlpiNg</PageTitle>

<div class="glpi-list-page">
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between glpi-list-toolbar">
        <div class="btn-list">
            <div class="dropdown">
                <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ti ti-search me-1"></i>Rechercher
                </button>
                <div class="dropdown-menu p-3" style="min-width: 280px;">
                    <div class="input-icon">
                        <span class="input-icon-addon">
                            <i class="ti ti-search"></i>
                        </span>
                        <input type="text" class="form-control" placeholder="Nom de la recherche..."
                               @bind="_searchTerm" @bind:event="oninput" @onkeyup="OnSearchChanged" />
                    </div>
                </div>
            </div>

            <div class="dropdown">
                <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ti ti-filter me-1"></i>@(_itemTypeFilter.Length == 0 ? "Tous les types" : SavedSearchItemTypes.LabelFor(_itemTypeFilter))
                </button>
                <ul class="dropdown-menu">
                    <li><button type="button" class="dropdown-item" @onclick='() => SetItemTypeFilter("")'>Tous les types</button></li>
                    @foreach ((string itemType, string label, string icon, string _) in SavedSearchItemTypes.All)
                    {
                        <li>
                            <button type="button" class="dropdown-item" @onclick="() => SetItemTypeFilter(itemType)">
                                <i class="ti @icon me-1"></i>@label
                            </button>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <div class="btn-list align-items-center">
            <button type="button" class="btn btn-icon" @onclick="OnRefreshAsync" title="Rafraîchir">
                <i class="ti ti-refresh"></i>
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th class="glpi-sortable-th" @onclick="() => SetSort(SortField.Name)">
                        <span class="d-flex align-items-center gap-1">Nom @SortIndicator(SortField.Name)</span>
                    </th>
                    <th class="glpi-sortable-th" @onclick="() => SetSort(SortField.ItemType)">
                        <span class="d-flex align-items-center gap-1">Type d'élément @SortIndicator(SortField.ItemType)</span>
                    </th>
                    <th class="glpi-sortable-th" @onclick="() => SetSort(SortField.Owner)">
                        <span class="d-flex align-items-center gap-1">Utilisateur @SortIndicator(SortField.Owner)</span>
                    </th>
                    <th class="glpi-sortable-th" @onclick="() => SetSort(SortField.ResultCount)">
                        <span class="d-flex align-items-center gap-1">Résultats @SortIndicator(SortField.ResultCount)</span>
                    </th>
                    <th>Visibilité</th>
                    <th>Défaut</th>
                </tr>
            </thead>
            <tbody>
                @if (_filteredSavedSearches.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-secondary py-4">Aucune recherche sauvegardée.</td>
                    </tr>
                }
                else
                {
                    @foreach (SavedSearch saved in _pagedSavedSearches)
                    {
                        bool isOwner = saved.OwnerUserId == _currentUserId;
                        <tr>
                            <td>
                                <a href="@($"/tools/saved-searches/{saved.Id}")" class="text-reset fw-semibold" title="Ouvrir cette recherche sauvegardée">
                                    <i class="ti @SavedSearchItemTypes.IconFor(saved.ItemType) me-1 text-secondary"></i>@saved.Name
                                </a>
                            </td>
                            <td>@SavedSearchItemTypes.LabelFor(saved.ItemType)</td>
                            <td>@(saved.OwnerName ?? "—")</td>
                            <td>@(saved.CountMode == SavedSearchCountMode.No ? "—" : saved.ResultCount.ToString())</td>
                            <td>
                                <span class="badge @(saved.IsPublic ? "bg-blue-lt" : "bg-secondary-lt")">@(saved.IsPublic ? "Public" : "Privé")</span>
                            </td>
                            <td>
                                @if (isOwner)
                                {
                                    <button type="button" class="btn btn-icon btn-sm btn-ghost-secondary" title="Définir par défaut"
                                            @onclick="() => SetDefaultAsync(saved)">
                                        <i class="ti @(saved.IsDefault ? "ti-star-filled text-warning" : "ti-star")"></i>
                                    </button>
                                }
                                else if (saved.IsDefault)
                                {
                                    <i class="ti ti-star-filled text-warning" title="Recherche par défaut du propriétaire"></i>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="card-footer d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2 text-secondary">
            <span>Éléments par page</span>
            <select class="form-select form-select-sm w-auto" value="@_pageSize"
                    @onchange="@((ChangeEventArgs e) => SetPageSize(int.Parse((string)e.Value!)))">
                @foreach (int size in PageSizeOptions)
                {
                    <option value="@size">@size</option>
                }
            </select>
        </div>

        @if (_filteredSavedSearches.Count > 0)
        {
            <div class="d-flex align-items-center gap-3">
                <span class="text-secondary">
                    @(((_currentPage - 1) * _pageSize) + 1)–@(Math.Min(_currentPage * _pageSize, _filteredSavedSearches.Count)) sur @_filteredSavedSearches.Count
                </span>
                <ul class="pagination pagination-sm m-0">
                    <li class="page-item @(_currentPage <= 1 ? "disabled" : "")">
                        <button type="button" class="page-link" @onclick="() => GoToPage(_currentPage - 1)" disabled="@(_currentPage <= 1)">
                            <i class="ti ti-chevron-left"></i>
                        </button>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">Page @_currentPage / @TotalPages</span>
                    </li>
                    <li class="page-item @(_currentPage >= TotalPages ? "disabled" : "")">
                        <button type="button" class="page-link" @onclick="() => GoToPage(_currentPage + 1)" disabled="@(_currentPage >= TotalPages)">
                            <i class="ti ti-chevron-right"></i>
                        </button>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>
</div>

@code {
    private RenderFragment SortIndicator(SortField field) => builder =>
    {
        if (_sortField != field) return;

        builder.OpenElement(0, "i");
        builder.AddAttribute(1, "class", $"ti {(_sortDescending ? "ti-caret-up-filled" : "ti-caret-down-filled")}");
        builder.CloseElement();
    };
}
