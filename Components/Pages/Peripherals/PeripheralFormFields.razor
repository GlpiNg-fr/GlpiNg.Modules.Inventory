@using GlpiNg.Modules.Inventory.Models

<div class="row">
    <div class="col-md-6">
        <div class="glping-fiche-field">
            <label>@T("Nom")</label>
            <input class="form-control" @bind="Peripheral.Name" @bind:event="oninput" @bind:after="NotifyChangedAsync" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Statut")</label>
            <select class="form-select" value="@(Peripheral.StatusId?.ToString() ?? "")"
                    @onchange="@((ChangeEventArgs e) => Peripheral.StatusId = string.IsNullOrEmpty((string?)e.Value) ? null : int.Parse((string)e.Value!))">
                <option value="">—</option>
                @foreach (DropdownItem status in StatusOptions)
                {
                    <option value="@status.Id">@status.Name</option>
                }
            </select>
        </div>
        <div class="glping-fiche-field">
            <label>@T("Lieu")</label>
            <div class="row g-2">
                <div class="col"><input class="form-control" placeholder="@(T("Site"))" @bind="Peripheral.Site" /></div>
                <div class="col"><input class="form-control" placeholder="@(T("Bâtiment"))" @bind="Peripheral.Building" /></div>
                <div class="col"><input class="form-control" placeholder="@(T("Salle"))" @bind="Peripheral.Room" /></div>
            </div>
        </div>
        <div class="glping-fiche-field">
            <label>@T("Type")</label>
            <input class="form-control" @bind="Peripheral.Type" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Technicien responsable")</label>
            <input class="form-control" @bind="Peripheral.TechnicianInCharge" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Fabricant")</label>
            <input class="form-control" @bind="Peripheral.Manufacturer" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Modèle")</label>
            <input class="form-control" @bind="Peripheral.Model" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Marque")</label>
            <input class="form-control" @bind="Peripheral.Brand" />
        </div>
    </div>
    <div class="col-md-6">
        <div class="glping-fiche-field">
            <label>@T("Numéro de série")</label>
            <input class="form-control" @bind="Peripheral.SerialNumber" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Numéro d'inventaire")</label>
            <input class="form-control" @bind="Peripheral.InventoryNumber" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Usager numéro")</label>
            <input class="form-control" @bind="Peripheral.ContactNumber" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Usager")</label>
            <input class="form-control" @bind="Peripheral.Contact" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Utilisateur")</label>
            <input class="form-control" @bind="Peripheral.AssignedUser" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Type de gestion")</label>
            <select class="form-select" value="@(Peripheral.IsGlobalManagement ? "true" : "false")" @onchange="@(e => Peripheral.IsGlobalManagement = e.Value?.ToString() == "true")">
                <option value="false">@T("Gestion unitaire")</option>
                <option value="true">@T("Gestion globale")</option>
            </select>
        </div>
        <div class="glping-fiche-field">
            <label>@T("UUID")</label>
            <input class="form-control" @bind="Peripheral.Uuid" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Commentaires")</label>
            <textarea class="form-control" rows="4" @bind="Peripheral.Comment"></textarea>
        </div>
    </div>
</div>

<hr class="my-3" />

<EntityScopeFields Item="Peripheral" />

@code {
    [Parameter, EditorRequired]
    public Peripheral Peripheral { get; set; } = null!;

    /// <summary>Valeurs de l'Intitulé Status (DropdownType.Status) à proposer dans le select — chargées par le parent (Index/Detail), pas ce composant, pour ne pas dupliquer la requête entre les deux usages.</summary>
    [Parameter, EditorRequired]
    public List<DropdownItem> StatusOptions { get; set; } = [];

    // Peripheral est muté directement (référence partagée avec le parent) : ça ne déclenche pas
    // le re-rendu du parent tout seul, d'où ce callback pour les cas où le parent affiche un état
    // dérivé de Peripheral (ex. le bouton "Ajouter" désactivé tant que Name est vide).
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private Task NotifyChangedAsync() => OnChanged.InvokeAsync();
}
