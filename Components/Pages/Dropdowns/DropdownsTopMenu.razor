@using GlpiNg.Modules.Inventory.Models

<div class="card mb-3">
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs" style="border-bottom: none;">
            @foreach (DropdownType type in Items)
            {
                string slug = DropdownTypeCatalog.Slug(type);
                <li class="nav-item">
                    <a href="@($"{BaseRoute}/{slug}")" class="nav-link @(Current == slug ? "active" : "")">
                        <i class="ti @(DropdownTypeCatalog.Icon(type)) me-1"></i>@DropdownTypeCatalog.Label(type)
                    </a>
                </li>
            }
        </ul>
    </div>
</div>

@code {
    /// <summary>Slug (DropdownTypeCatalog.Slug) de la catégorie actuellement affiché, pour mettre en évidence l'onglet correspondant.</summary>
    [Parameter, EditorRequired]
    public string Current { get; set; } = string.Empty;

    /// <summary>Catégories à afficher en onglets — DropdownTypeCatalog.Labels ou .Components selon la page appelante (Intitulés vs Composants).</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<DropdownType> Items { get; set; } = [];

    /// <summary>Racine des liens d'onglet ("/config/dropdowns" ou "/config/components") — voir DropdownTypeCatalog.GroupBaseRoute.</summary>
    [Parameter, EditorRequired]
    public string BaseRoute { get; set; } = string.Empty;
}
