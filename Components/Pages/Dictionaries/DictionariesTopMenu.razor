<div class="card mb-3">
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs" style="border-bottom: none;">
            @foreach (DictionaryRuleType type in DictionaryRuleTypeCatalog.All)
            {
                string slug = DictionaryRuleTypeCatalog.Slug(type);
                <li class="nav-item">
                    <a href="@($"/admin/dictionaries/{slug}")" class="nav-link @(Current == slug ? "active" : "")">
                        <i class="ti @(DictionaryRuleTypeCatalog.Icon(type)) me-1"></i>@DictionaryRuleTypeCatalog.Label(type)
                    </a>
                </li>
            }
        </ul>
    </div>
</div>

@code {
    /// <summary>Slug (DictionaryRuleTypeCatalog.Slug) du dictionnaire actuellement affiché, pour mettre en évidence l'onglet correspondant.</summary>
    [Parameter, EditorRequired]
    public string Current { get; set; } = string.Empty;
}
