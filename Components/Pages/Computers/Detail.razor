@page "/parc/computer/{ComputerId:int}"
@using GlpiNg.Modules.Abstractions.Deployment
@using GlpiNg.Modules.Inventory.Models
@using GlpiNg.Modules.Inventory.Services
@using GlpiNg.Modules.Abstractions.Notes
@rendermode InteractiveServer

<PageTitle>@(_computer?.Name ?? T("Ordinateur")) — GlpiNg</PageTitle>

@if (_computer is null)
{
    <div class="text-center text-secondary py-5">
        <i class="ti ti-device-desktop-off fs-1"></i>
        <p class="mt-2">@T("Ce poste est introuvable.")</p>
    </div>
}
else
{
    <div class="glping-fiche-topbar">
        <a class="glping-fiche-pager-btn" href="@_listUrl" title="@(T("Retour à la liste"))">
            <i class="ti ti-list"></i>
        </a>
        <div class="glping-fiche-crumb">
            <i class="ti ti-device-desktop"></i>
            <span>@T("Ordinateur - {0} - ID {1}", _computer.Name, _computer.Id)</span>
            <button type="button" class="glping-fiche-favorite" title="@(T("Ajouter aux favoris"))">
                <i class="ti ti-star"></i>
            </button>
        </div>
        <div class="glping-fiche-toolbar">
            <button type="button" class="glping-fiche-pager-btn" title="@(T("Recharger les données"))" disabled="@_isReloading" @onclick="ReloadComputerAsync">
                <i class="ti ti-refresh @(_isReloading ? "glping-spin" : "")"></i>
            </button>
            <div class="dropdown">
                <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ti ti-dots-vertical me-1"></i>@T("Actions")
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><button type="button" class="dropdown-item" @onclick="EnterEditModeAsync"><i class="ti ti-pencil me-1"></i>@T("Modifier")</button></li>
                    <li><a class="dropdown-item" href="#"><i class="ti ti-copy me-1"></i>@T("Dupliquer")</a></li>
                    <li>
                        <button type="button" class="dropdown-item" disabled="@(_isWaking || !HasWakeableMac)"
                                title="@(HasWakeableMac
                                           ? T("Diffuse un magic packet sur toutes les adresses MAC connues du poste, depuis le serveur.")
                                           : T("Aucune adresse MAC connue : l'inventaire réseau de ce poste n'a rien remonté."))"
                                @onclick="SendWakeOnLanAsync">
                            <i class="ti @(_isWaking ? "ti-loader-2 glping-spin" : "ti-power") me-1"></i>@T("Réveiller (Wake-on-LAN)")
                        </button>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item text-danger" href="#"><i class="ti ti-trash me-1"></i>@T("Mettre à la corbeille")</a></li>
                </ul>
            </div>
            @if (_total > 0)
            {
                <span class="glping-fiche-pager-count">@_position/@_total</span>
                <a class="glping-fiche-pager-btn @(_previousId is null ? "disabled" : "")" href="@(_previousId is { } prevId ? $"/parc/computer/{prevId}" : "#")">
                    <i class="ti ti-chevron-left"></i>
                </a>
                <a class="glping-fiche-pager-btn @(_nextId is null ? "disabled" : "")" href="@(_nextId is { } nextId ? $"/parc/computer/{nextId}" : "#")">
                    <i class="ti ti-chevron-right"></i>
                </a>
            }
        </div>
    </div>

    @if (_wakeOnLanMessage is { } wakeMessage)
    {
        <div class="alert @(_wakeOnLanFailed ? "alert-danger" : "alert-success") alert-dismissible py-2 px-3 mb-2" role="alert">
            <i class="ti @(_wakeOnLanFailed ? "ti-alert-triangle" : "ti-power") me-1"></i>@wakeMessage
            @if (_wakeOnLanDetail is { } wakeDetail)
            {
                @* Le détail est affiché même en cas de succès : un magic packet part sans accusé de
                   réception, donc « envoyé » ne veut pas dire « réveillé ». Savoir sur quelles MAC et
                   quelles adresses de diffusion il est parti est la seule prise pour diagnostiquer un
                   poste qui ne se rallume pas. *@
                <div class="small text-muted mt-1">@wakeDetail</div>
            }
            <button type="button" class="btn-close" aria-label="@(T("Fermer"))" @onclick="DismissWakeOnLanMessage"></button>
        </div>
    }

    <div class="glping-fiche-layout">
        <aside class="glping-fiche-sidebar">
            @foreach (var tab in _tabs)
            {
                <button type="button" class="glping-fiche-tab-item @(_activeTabKey == tab.Key ? "active" : "")" @onclick="() => SetTab(tab.Key)">
                    <i class="ti @tab.Icon"></i>
                    <span>@T(tab.Label)</span>
                    @if (tab.Count is { } count)
                    {
                        <span class="glping-fiche-tab-count">@count</span>
                    }
                </button>
            }
        </aside>

        <div class="glping-fiche-panel @(FillPanelTabKeys.Contains(_activeTabKey) ? "glping-fiche-panel-fill" : "")">
            @switch (_activeTabKey)
            {
                case "computer":
                    @if (_editMode)
                    {
                        <div class="d-flex justify-content-end gap-2 mb-3">
                            <button type="button" class="btn btn-sm" disabled="@_editSaving" @onclick="CancelEdit">@T("Annuler")</button>
                            <button type="button" class="btn btn-sm btn-primary" disabled="@_editSaving" @onclick="SaveEditAsync">
                                <i class="ti ti-device-floppy me-1 @(_editSaving ? "glping-spin" : "")"></i>@T("Enregistrer")
                            </button>
                        </div>
                    }
                    <div class="glping-fiche-form">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="glping-fiche-field">
                                    <label>@T("Nom")<FieldLockToggle Field="Name" IsLocked='@IsFieldLocked("Name")' OnToggle="ToggleFieldLockAsync" /></label>
                                    <div class="glping-fiche-value-box">@_computer.Name</div>
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Emplacement")</label>
                                    @if (_editMode)
                                    {
                                        <select class="form-select" value="@(_editLocationId?.ToString() ?? "")"
                                                @onchange="@((ChangeEventArgs e) => _editLocationId = string.IsNullOrEmpty((string?)e.Value) ? null : int.Parse((string)e.Value!))">
                                            <option value="">—</option>
                                            @foreach (LocationOption location in _locationOptions)
                                            {
                                                <option value="@location.Id">@location.Path</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <div class="glping-fiche-value-box">@(LocationLabel(_computer) ?? "—")</div>
                                    }
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Utilisateur assigné")</label>
                                    @if (_editMode)
                                    {
                                        <input class="form-control" list="assignedUserOptions" @bind="_editAssignedUser" @bind:event="oninput" />
                                        <datalist id="assignedUserOptions">
                                            @foreach (string option in _userOptions)
                                            {
                                                <option value="@option"></option>
                                            }
                                        </datalist>
                                    }
                                    else
                                    {
                                        <div class="glping-fiche-value-box">@(_computer.AssignedUser ?? "—")</div>
                                    }
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Dernier utilisateur connecté")<FieldLockToggle Field="LastLoggedUser" IsLocked='@IsFieldLocked("LastLoggedUser")' OnToggle="ToggleFieldLockAsync" /></label>
                                    <div class="glping-fiche-value-box">@(_computer.LastLoggedUser ?? "—")</div>
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("UUID matériel")<FieldLockToggle Field="HardwareUuid" IsLocked='@IsFieldLocked("HardwareUuid")' OnToggle="ToggleFieldLockAsync" /></label>
                                    <div class="glping-fiche-value-box"><code>@(_computer.HardwareUuid ?? "—")</code></div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="glping-fiche-field">
                                    <label>@T("Statut")</label>
                                    @if (_editMode)
                                    {
                                        <select class="form-select" value="@(_editStatusId?.ToString() ?? "")"
                                                @onchange="@((ChangeEventArgs e) => _editStatusId = string.IsNullOrEmpty((string?)e.Value) ? null : int.Parse((string)e.Value!))">
                                            <option value="">—</option>
                                            @foreach (DropdownItem status in _statusOptions)
                                            {
                                                <option value="@status.Id">@status.Name</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <div class="glping-fiche-value-box">
                                            <StatusBadge Status="_computer.StatusItem" />
                                        </div>
                                    }
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Type")<FieldLockToggle Field="ChassisType" IsLocked='@IsFieldLocked("ChassisType")' OnToggle="ToggleFieldLockAsync" /></label>
                                    @if (_editMode)
                                    {
                                        <input class="form-control" list="computerTypeOptions" @bind="_editChassisType" @bind:event="oninput" />
                                        <datalist id="computerTypeOptions">
                                            @foreach (string option in _computerTypeOptions)
                                            {
                                                <option value="@option"></option>
                                            }
                                        </datalist>
                                    }
                                    else
                                    {
                                        <div class="glping-fiche-value-box">@(_computer.ChassisType ?? "—")</div>
                                    }
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Fabricant")<FieldLockToggle Field="Manufacturer" IsLocked='@IsFieldLocked("Manufacturer")' OnToggle="ToggleFieldLockAsync" /></label>
                                    @if (_editMode)
                                    {
                                        <input class="form-control" list="manufacturerOptions" @bind="_editManufacturer" @bind:event="oninput" />
                                        <datalist id="manufacturerOptions">
                                            @foreach (string option in _manufacturerOptions)
                                            {
                                                <option value="@option"></option>
                                            }
                                        </datalist>
                                    }
                                    else
                                    {
                                        <div class="glping-fiche-value-box">@(_computer.Manufacturer ?? "—")</div>
                                    }
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Modèle")<FieldLockToggle Field="Model" IsLocked='@IsFieldLocked("Model")' OnToggle="ToggleFieldLockAsync" /></label>
                                    @if (_editMode)
                                    {
                                        <input class="form-control" list="computerModelOptions" @bind="_editModel" @bind:event="oninput" />
                                        <datalist id="computerModelOptions">
                                            @foreach (string option in _computerModelOptions)
                                            {
                                                <option value="@option"></option>
                                            }
                                        </datalist>
                                    }
                                    else
                                    {
                                        <div class="glping-fiche-value-box">@(_computer.Model ?? "—")</div>
                                    }
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("N° de série")<FieldLockToggle Field="SerialNumber" IsLocked='@IsFieldLocked("SerialNumber")' OnToggle="ToggleFieldLockAsync" /></label>
                                    <div class="glping-fiche-value-box">@(_computer.SerialNumber ?? "—")</div>
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Virtualisation")<FieldLockToggle Field="VmSystem" IsLocked='@IsFieldLocked("VmSystem")' OnToggle="ToggleFieldLockAsync" /></label>
                                    <div class="glping-fiche-value-box">@(_computer.VmSystem is { Length: > 0 } vm && vm != "Physical" ? vm : T("Machine physique"))</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (_computer.Agent is { } agent)
                    {
                        <div class="glping-fiche-inventory-panel">
                            <div class="glping-fiche-inventory-title"><i class="ti ti-cloud-upload"></i>@T("Informations d'inventaire")</div>
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="glping-fiche-inventory-label">@T("Agent")</div>
                                    <div>
                                        @(agent.AgentName ?? agent.Hostname ?? agent.DeviceId ?? "—")
                                        @if (AgentWebUrl(agent, _computer) is { } agentWebUrl)
                                        {
                                            <a href="@agentWebUrl" target="_blank" rel="noopener noreferrer" title="@(T("Ouvrir la page web de l'agent"))" class="glping-fiche-inventory-agent-link">
                                                <i class="ti ti-external-link"></i>
                                            </a>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="glping-fiche-inventory-label">@T("UserAgent")</div>
                                    <div>@(agent.LastUserAgent ?? "—")</div>
                                </div>
                                <div class="col-md-4">
                                    <div class="glping-fiche-inventory-label">@T("Tag d'inventaire")</div>
                                    <div>@(agent.Tag ?? "—")</div>
                                </div>
                                <div class="col-md-4">
                                    <div class="glping-fiche-inventory-label">@T("Adresse publique de contact")</div>
                                    <div>@(agent.LastContactIp ?? "—")</div>
                                </div>
                                <div class="col-md-4">
                                    <div class="glping-fiche-inventory-label">@T("Dernier contact")</div>
                                    <div>@Display.DateTime(agent.LastContactAt)</div>
                                </div>
                                <div class="col-md-4">
                                    <div class="glping-fiche-inventory-label">@T("Dernière mise à jour de l'inventaire")</div>
                                    <div>@LastInventoryLabel(_computer)</div>
                                </div>
                                <div class="col-md-4">
                                    <div class="glping-fiche-inventory-label">
                                        @T("Statut de l'agent")
                                        <i class="ti ti-refresh @(_agentStatusLoading ? "glping-spin" : "")" role="button" title="@(T("Interroger l'agent"))" @onclick="RefreshAgentStatusAsync"></i>
                                    </div>
                                    <div>@(_agentStatus ?? T("Inconnu"))</div>
                                </div>
                                <div class="col-md-4">
                                    <div class="glping-fiche-inventory-label">
                                        @T("Demander un inventaire")
                                        <i class="ti ti-refresh @(_inventoryRequestLoading ? "glping-spin" : "")" role="button" title="@(T("Demander un inventaire immédiat"))" @onclick="RequestInventoryAsync"></i>
                                    </div>
                                    <div>@(_inventoryRequestResult ?? T("Inconnu"))</div>
                                </div>
                                <div class="col-md-4">
                                    <div class="glping-fiche-inventory-label">
                                        @T("Lancer les tâches de l'hôte")
                                        <i class="ti ti-refresh @(_hostTasksRequestLoading ? "glping-spin" : "")" role="button" title="@(T("Lancer les tâches de l'hôte"))" @onclick="RequestHostTasksAsync"></i>
                                    </div>
                                    <div>@(_hostTasksRequestResult ?? T("Inconnu"))</div>
                                </div>
                            </div>
                            <div class="glping-fiche-inventory-footer">
                                <span>@T("Créé le {0}", Display.DateTime(_computer.CreatedAt))</span>
                                <span>@T("Dernière mise à jour le") @LastInventoryLabel(_computer)</span>
                            </div>
                        </div>
                    }
                    break;

                case "os":
                    @if (_editMode)
                    {
                        <div class="d-flex justify-content-end gap-2 mb-3">
                            <button type="button" class="btn btn-sm" disabled="@_editSaving" @onclick="CancelEdit">@T("Annuler")</button>
                            <button type="button" class="btn btn-sm btn-primary" disabled="@_editSaving" @onclick="SaveEditAsync">
                                <i class="ti ti-device-floppy me-1 @(_editSaving ? "glping-spin" : "")"></i>@T("Enregistrer")
                            </button>
                        </div>
                    }
                    <div class="glping-fiche-form">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="glping-fiche-field">
                                    <label>@T("Système d'exploitation")<FieldLockToggle Field="OperatingSystem" IsLocked='@IsFieldLocked("OperatingSystem")' OnToggle="ToggleFieldLockAsync" /></label>
                                    @if (_editMode)
                                    {
                                        <input class="form-control" list="operatingSystemOptions" @bind="_editOperatingSystem" @bind:event="oninput" />
                                        <datalist id="operatingSystemOptions">
                                            @foreach (string option in _operatingSystemOptions)
                                            {
                                                <option value="@option"></option>
                                            }
                                        </datalist>
                                    }
                                    else
                                    {
                                        <div class="glping-fiche-value-box">@(_computer.OperatingSystem ?? "—")</div>
                                    }
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Version")<FieldLockToggle Field="OsVersion" IsLocked='@IsFieldLocked("OsVersion")' OnToggle="ToggleFieldLockAsync" /></label>
                                    @if (_editMode)
                                    {
                                        <input class="form-control" list="operatingSystemVersionOptions" @bind="_editOsVersion" @bind:event="oninput" />
                                        <datalist id="operatingSystemVersionOptions">
                                            @foreach (string option in _operatingSystemVersionOptions)
                                            {
                                                <option value="@option"></option>
                                            }
                                        </datalist>
                                    }
                                    else
                                    {
                                        <div class="glping-fiche-value-box">@(_computer.OsVersion ?? "—")</div>
                                    }
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Version du noyau")<FieldLockToggle Field="OsKernelVersion" IsLocked='@IsFieldLocked("OsKernelVersion")' OnToggle="ToggleFieldLockAsync" /></label>
                                    <div class="glping-fiche-value-box">@(_computer.OsKernelVersion ?? "—")</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="glping-fiche-field">
                                    <label>@T("Mémoire totale")<FieldLockToggle Field="TotalMemoryMb" IsLocked='@IsFieldLocked("TotalMemoryMb")' OnToggle="ToggleFieldLockAsync" /></label>
                                    <div class="glping-fiche-value-box">@(_computer.TotalMemoryMb is { } mb ? $"{mb} Mo" : "—")</div>
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Dernière remontée")</label>
                                    <div class="glping-fiche-value-box">@LastInventoryLabel(_computer)</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    break;

                case "components":
                    @if (_computer.Components.Count == 0)
                    {
                        <div class="glping-config-placeholder">
                            <i class="ti ti-cpu-off"></i>
                            <p class="mb-0">@T("Aucun composant remonté.")</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var group in ComponentGroups(_computer))
                        {
                            <div class="glping-fiche-block">
                                <div class="glping-fiche-block-title">
                                    <i class="ti @ComponentTypeIcon(group.Key)"></i>@ComponentTypeLabel(group.Key) (@group.Count())
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-vcenter card-table mb-0">
                                        <thead>
                                            <tr>
                                                <th>@T("Désignation")</th>
                                                <th>@ComponentValueColumnLabel(group.Key)</th>
                                                <th>@T("Numéro de série")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (ComputerComponent component in group)
                                            {
                                                <tr>
                                                    <td>@component.Designation</td>
                                                    <td>@(component.Capacity ?? "—")</td>
                                                    <td>@(component.Serial ?? "—")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }
                    break;

                case "batteries":
                    @if (_computer.Batteries.Count == 0)
                    {
                        <div class="glping-config-placeholder">
                            <i class="ti ti-battery-off"></i>
                            <p class="mb-0">@T("Aucune batterie remontée.")</p>
                        </div>
                    }
                    else
                    {
                        <div class="glping-fiche-block">
                            <div class="glping-fiche-block-title"><i class="ti ti-battery"></i>@T("Batteries ({0})", _computer.Batteries.Count)</div>
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("Nom")</th>
                                            <th>@T("Fabricant")</th>
                                            <th>@T("Type")</th>
                                            <th>@T("Tension")</th>
                                            <th>@T("Capacité")</th>
                                            <th>@T("Capacité réelle")</th>
                                            <th>@T("Numéro de série")</th>
                                            <th>@T("Date de fabrication")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ComputerBattery battery in _computer.Batteries)
                                        {
                                            int? wearPercent = WearPercent(battery.CapacityMwh, battery.RealCapacityMwh);
                                            <tr>
                                                <td>@battery.Name</td>
                                                <td>@(battery.Manufacturer ?? "—")</td>
                                                <td>@(battery.Chemistry ?? "—")</td>
                                                <td>@VoltageLabel(battery.VoltageMv)</td>
                                                <td>@CapacityLabel(battery.CapacityMwh)</td>
                                                <td>
                                                    @if (battery.RealCapacityMwh is null)
                                                    {
                                                        @:—
                                                    }
                                                    else
                                                    {
                                                        <span class="badge @WearBadgeCss(wearPercent)">
                                                            @RealCapacityLabel(battery.RealCapacityMwh)@(wearPercent is { } p ? $" ({p}%)" : "")
                                                        </span>
                                                    }
                                                </td>
                                                <td>@(battery.Serial ?? "—")</td>
                                                <td>@(battery.ManufactureDate ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    break;

                case "software":
                    @if (_computer.Softwares.Count == 0)
                    {
                        <div class="glping-config-placeholder">
                            <i class="ti ti-apps-off"></i>
                            <p class="mb-0">@T("Aucun logiciel remonté.")</p>
                        </div>
                    }
                    else
                    {
                        <div class="glping-fiche-block">
                            <div class="glping-fiche-block-title">
                                <i class="ti ti-apps"></i>@T("Logiciels installés ({0})", _softwareFiltered.Count)
                                <div class="glping-fiche-block-filter">
                                    <i class="ti ti-search"></i>
                                    <input type="text" placeholder="@(T("Filtrer..."))" value="@_softwareFilter" @oninput="OnSoftwareFilterInput" />
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("Nom")</th>
                                            <th>@T("Version")</th>
                                            <th>@T("Éditeur")</th>
                                            <th>@T("Date d'installation")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ComputerSoftware software in _softwarePaged)
                                        {
                                            <tr>
                                                <td>@software.Name</td>
                                                <td>@(software.Version ?? "—")</td>
                                                <td>@(software.Publisher ?? "—")</td>
                                                <td>@(software.InstallDate ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (_softwareFiltered.Count > SoftwarePageSizeOptions[0])
                            {
                                <div class="card-footer d-flex align-items-center justify-content-between flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2 text-secondary">
                                        <span>@T("Éléments par page")</span>
                                        <select class="form-select form-select-sm w-auto" value="@_softwarePageSize"
                                                @onchange="@((ChangeEventArgs e) => SetSoftwarePageSize(int.Parse((string)e.Value!)))">
                                            @foreach (int size in SoftwarePageSizeOptions)
                                            {
                                                <option value="@size">@size</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="text-secondary">
                                            @T("{0}–{1} sur {2}", (_softwarePage - 1) * _softwarePageSize + 1, Math.Min(_softwarePage * _softwarePageSize, _softwareFiltered.Count), _softwareFiltered.Count)
                                        </span>
                                        <ul class="pagination pagination-sm m-0">
                                            <li class="page-item @(_softwarePage <= 1 ? "disabled" : "")">
                                                <button type="button" class="page-link" @onclick="() => GoToSoftwarePage(_softwarePage - 1)" disabled="@(_softwarePage <= 1)">
                                                    <i class="ti ti-chevron-left"></i>
                                                </button>
                                            </li>
                                            <li class="page-item disabled">
                                                <span class="page-link">@T("Page {0} / {1}", _softwarePage, SoftwareTotalPages)</span>
                                            </li>
                                            <li class="page-item @(_softwarePage >= SoftwareTotalPages ? "disabled" : "")">
                                                <button type="button" class="page-link" @onclick="() => GoToSoftwarePage(_softwarePage + 1)" disabled="@(_softwarePage >= SoftwareTotalPages)">
                                                    <i class="ti ti-chevron-right"></i>
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    break;

                case "volumes":
                    @if (_computer.Volumes.Count == 0)
                    {
                        <div class="glping-config-placeholder">
                            <i class="ti ti-server-off"></i>
                            <p class="mb-0">@T("Aucun volume remonté.")</p>
                        </div>
                    }
                    else
                    {
                        <div class="glping-fiche-block">
                            <div class="glping-fiche-block-title"><i class="ti ti-server-2"></i>@T("Volumes ({0})", _computer.Volumes.Count)</div>
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("Nom")</th>
                                            <th>@T("Inventaire automatique")</th>
                                            <th>@T("Partition")</th>
                                            <th>@T("Point de montage")</th>
                                            <th>@T("Système de fichier")</th>
                                            <th>@T("Taille totale")</th>
                                            <th>@T("Espace disponible")</th>
                                            <th>@T("Taux d'utilisation")</th>
                                            <th>@T("Chiffrement")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ComputerVolume volume in _computer.Volumes)
                                        {
                                            <tr>
                                                <td>@volume.Name</td>
                                                <td>@T("Oui")</td>
                                                <td>@(volume.Partition ?? "—")</td>
                                                <td>@(volume.MountPoint ?? "—")</td>
                                                <td>@(volume.FileSystem ?? "—")</td>
                                                <td>@SizeLabel(volume.TotalSizeMb)</td>
                                                <td>@SizeLabel(volume.FreeSizeMb)</td>
                                                <td>
                                                    @if (UsagePercent(volume) is { } percent)
                                                    {
                                                        <div class="glping-usage-bar">
                                                            <div class="glping-usage-bar-fill" style="width: @(percent)%"></div>
                                                            <span>@percent %</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span>—</span>
                                                    }
                                                </td>
                                                <td>@(volume.Encryption ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    break;

                case "connections":
                    @if (_computer.Peripherals.Count == 0)
                    {
                        <div class="glping-config-placeholder">
                            <i class="ti ti-device-tv-off"></i>
                            <p class="mb-0">@T("Aucun périphérique connecté remonté.")</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var group in PeripheralGroups(_computer))
                        {
                            <div class="glping-fiche-block">
                                <div class="glping-fiche-block-title">
                                    <i class="ti @PeripheralKindIcon(group.Key)"></i>@PeripheralKindLabel(group.Key) (@group.Count())
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-vcenter card-table mb-0">
                                        <thead>
                                            <tr>
                                                <th>@T("Désignation")</th>
                                                <th>@T("Fabricant")</th>
                                                <th>@T("Numéro de série")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (ComputerPeripheral peripheral in group)
                                            {
                                                <tr>
                                                    <td>
                                                        @if (peripheral.Kind == PeripheralKind.Monitor)
                                                        {
                                                            <a href="@($"/parc/monitors/{peripheral.Id}")" class="text-reset">@peripheral.Designation</a>
                                                        }
                                                        else
                                                        {
                                                            @peripheral.Designation
                                                        }
                                                    </td>
                                                    <td>@(peripheral.Manufacturer ?? "—")</td>
                                                    <td>@(peripheral.Serial ?? "—")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }
                    break;

                case "networkports":
                    @if (_computer.NetworkPorts.Count == 0)
                    {
                        <div class="glping-config-placeholder">
                            <i class="ti ti-network-off"></i>
                            <p class="mb-0">@T("Aucun port réseau remonté.")</p>
                        </div>
                    }
                    else
                    {
                        <div class="glping-fiche-block">
                            <div class="glping-fiche-block-title"><i class="ti ti-network"></i>@T("Ports réseau ({0})", _computer.NetworkPorts.Count)</div>
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("Nom")</th>
                                            <th>@T("Type")</th>
                                            <th>@T("Adresse MAC")</th>
                                            <th>@T("Adresse IP")</th>
                                            <th>@T("Masque")</th>
                                            <th>@T("Passerelle")</th>
                                            <th>@T("Sous-réseau")</th>
                                            <th>@T("DHCP")</th>
                                            <th>@T("MTU")</th>
                                            <th>@T("Vitesse")</th>
                                            <th>@T("Statut")</th>
                                            <th>@T("Virtuel")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ComputerNetworkPort port in _computer.NetworkPorts)
                                        {
                                            <tr>
                                                <td>@port.Designation</td>
                                                <td>@(port.Type ?? "—")</td>
                                                <td>@FormatMac(port.MacAddress)</td>
                                                <td>@(port.IpAddress ?? "—")</td>
                                                <td>@(port.IpMask ?? "—")</td>
                                                <td>@(port.IpGateway ?? "—")</td>
                                                <td>@(port.IpSubnet ?? "—")</td>
                                                <td>@DhcpLabel(port.IpDhcp)</td>
                                                <td>@(port.Mtu?.ToString() ?? "—")</td>
                                                <td>@SpeedLabel(port.SpeedMbps)</td>
                                                <td>@(port.Status ?? "—")</td>
                                                <td>@(port.IsVirtual ? T("Oui") : T("Non"))</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    break;

                case "connectors":
                    @* Connecteurs physiques du châssis (section "ports" de l'inventaire) : ce que
                       la machine peut recevoir. À distinguer de « Connexions » (ce qui y est
                       branché) et de « Ports réseau » (les interfaces IP configurées). *@
                    @if (_computer.Connectors.Count == 0)
                    {
                        <div class="glping-config-placeholder">
                            <i class="ti ti-usb"></i>
                            <p class="mb-0">@T("Aucun connecteur remonté par l'inventaire.")</p>
                        </div>
                    }
                    else
                    {
                        <div class="glping-fiche-block">
                            <div class="glping-fiche-block-title"><i class="ti ti-usb"></i>@T("Connecteurs ({0})", _computer.Connectors.Count)</div>
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("Désignation")</th>
                                            <th>@T("Type")</th>
                                            <th>@T("Libellé")</th>
                                            <th>@T("Description")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ComputerConnector connector in _computer.Connectors.OrderBy(c => c.Type).ThenBy(c => c.Designation))
                                        {
                                            <tr>
                                                <td>@connector.Designation</td>
                                                <td>@(connector.Type ?? "—")</td>
                                                <td>@(connector.Caption ?? "—")</td>
                                                <td>@(connector.Description ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    break;

                case "antivirus":
                    @if (_computer.Antiviruses.Count == 0)
                    {
                        <div class="glping-config-placeholder">
                            <i class="ti ti-shield-off"></i>
                            <p class="mb-0">@T("Aucun antivirus remonté.")</p>
                        </div>
                    }
                    else
                    {
                        <div class="glping-fiche-block">
                            <div class="glping-fiche-block-title"><i class="ti ti-shield-check"></i>@T("Antivirus ({0})", _computer.Antiviruses.Count)</div>
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("Nom")</th>
                                            <th>@T("Éditeur")</th>
                                            <th>@T("Version")</th>
                                            <th>@T("Actif")</th>
                                            <th>@T("À jour")</th>
                                            <th>@T("Version de la base")</th>
                                            <th>@T("Date de la base")</th>
                                            <th>@T("Expiration")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ComputerAntivirus antivirus in _computer.Antiviruses)
                                        {
                                            <tr>
                                                <td>@antivirus.Name</td>
                                                <td>@(antivirus.Company ?? "—")</td>
                                                <td>@(antivirus.Version ?? "—")</td>
                                                <td><span class="badge @BoolBadgeCss(antivirus.Enabled)">@BoolLabel(antivirus.Enabled)</span></td>
                                                <td><span class="badge @BoolBadgeCss(antivirus.UpToDate)">@BoolLabel(antivirus.UpToDate)</span></td>
                                                <td>@(antivirus.BaseVersion ?? "—")</td>
                                                <td>@(antivirus.BaseCreationDate ?? "—")</td>
                                                <td>@(antivirus.Expiration ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    break;

                case "locks":
                    @* Vue d'ensemble des verrous, que les cadenas dispersés dans la fiche ne
                       donnent pas : ils répondent « ce champ est-il verrouillé ? », pas « qu'est-ce
                       qui est verrouillé sur ce poste, par qui, depuis quand ». L'onglet liste tout
                       le catalogue et pas seulement les champs verrouillés, sinon il serait vide au
                       moment précis où l'on cherche quoi verrouiller. *@
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-lock"></i>@T("Verrous ({0} / {1})", _locks.Count, ComputerLockableFields.All.Count)</div>
                        <p class="text-muted small px-3 pt-2 mb-0">
                            @T("Un champ verrouillé n'est plus mis à jour par les remontées d'agent : la valeur saisie à la main est conservée. Les champs non verrouillés sont réécrits au prochain inventaire.")
                        </p>
                        <div class="table-responsive">
                            <table class="table table-vcenter card-table mb-0">
                                <thead>
                                    <tr>
                                        <th style="width: 1%"></th>
                                        <th>@T("Champ")</th>
                                        <th>@T("Valeur actuelle")</th>
                                        <th>@T("État")</th>
                                        <th>@T("Verrouillé par")</th>
                                        <th>@T("Depuis")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach ((string key, string label) in ComputerLockableFields.All)
                                    {
                                        LockedField? lockRow = LockOf(key);
                                        <tr>
                                            <td>
                                                <FieldLockToggle Field="@key" IsLocked="@(lockRow is not null)" OnToggle="ToggleFieldLockAsync" />
                                            </td>
                                            <td>@T(label)</td>
                                            <td>@CurrentFieldValue(key)</td>
                                            <td>
                                                @if (lockRow is not null)
                                                {
                                                    <span class="badge bg-warning-lt"><i class="ti ti-lock me-1"></i>@T("Verrouillé")</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-lt"><i class="ti ti-lock-open me-1"></i>@T("Mis à jour par l'inventaire")</span>
                                                }
                                            </td>
                                            <td>@(lockRow?.LockedBy ?? "—")</td>
                                            <td>@(lockRow is null ? "—" : Display.DateTime(lockRow.CreatedAt))</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    break;

                case "links":
                    <ExternalLinksPanel ItemType="@ExternalLinkTagSource.ComputerItemType"
                                        Tags="@ExternalLinkTagSource.For(_computer)" />
                    break;

                case "collectinfo":
                    @if (_collectInfo is null)
                    {
                        @* Le module Déploiement n'est pas chargé : rien ne définit ni ne rapatrie de
                           collecte. Le dire, plutôt qu'un vide qui se lit comme une panne. *@
                        <div class="glping-config-placeholder">
                            <i class="ti ti-cloud-off"></i>
                            <p class="mb-0">@T("Le module Déploiement n'est pas activé : aucune collecte n'est définie.")</p>
                        </div>
                    }
                    else
                    {
                        @foreach (ComputerCollectGroup group in _collectInfo.Groups)
                        {
                            <div class="glping-fiche-block">
                                <div class="glping-fiche-block-title">
                                    <i class="ti ti-cloud-upload"></i>@group.Name
                                    <span class="badge bg-secondary-lt ms-2">@T(group.TypeLabel)</span>
                                    @if (group.LastCollectedAt is { } collectedAt)
                                    {
                                        <span class="text-secondary ms-auto" style="font-weight: 400;">
                                            @T("Dernière remontée : {0}", Display.DateTime(collectedAt))
                                        </span>
                                    }
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-vcenter card-table mb-0">
                                        <thead>
                                            <tr>
                                                <th>@T("Entrée")</th>
                                                <th>@T("Élément interrogé")</th>
                                                <th>@T("Valeur")</th>
                                                <th class="w-1">@T("Remontée le")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (ComputerCollectEntry entry in group.Entries)
                                            {
                                                <tr>
                                                    <td>@entry.EntryName</td>
                                                    <td class="text-secondary">@(entry.Key ?? "—")</td>
                                                    @* Une valeur de registre ou une sortie WMI peut être longue et
                                                       n'a pas de coupure naturelle : on la laisse se replier plutôt
                                                       que d'étirer le tableau hors de l'écran. *@
                                                    <td style="word-break: break-all;">
                                                        @if (string.IsNullOrEmpty(entry.Value))
                                                        {
                                                            <span class="text-secondary">@T("(vide)")</span>
                                                        }
                                                        else
                                                        {
                                                            @entry.Value
                                                        }
                                                    </td>
                                                    <td class="text-nowrap text-secondary">
                                                        @Display.DateTime(entry.CollectedAt)
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }

                        @if (_collectInfo.PendingCollects.Count > 0)
                        {
                            @* Une collecte définie mais jamais remontée n'est pas la même chose qu'une
                               absence de collecte : l'agent ne l'a simplement pas encore exécutée. *@
                            <div class="alert alert-info" role="alert">
                                <i class="ti ti-clock me-1"></i>
                                @T("En attente de la prochaine exécution de l'agent : {0}.", string.Join(", ", _collectInfo.PendingCollects))
                            </div>
                        }

                        @if (_collectInfo.Groups.Count == 0 && _collectInfo.PendingCollects.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-cloud-off"></i>
                                <p class="mb-1">@T("Aucune information de collecte pour ce poste.")</p>
                                <p class="mb-0 text-secondary" style="max-width: 46rem;">
                                    @T("Les collectes se définissent dans")
                                    <a href="/tools/deployments/collects">@T("Outils > Déploiements > Informations de collecte")</a>
                                    @T("(clés de registre, requêtes WMI, recherches de fichiers). Les collectes actives sont transmises à tous les agents, qui rapportent leurs résultats ici.")
                                </p>
                                <p class="mb-0 text-secondary" style="max-width: 46rem;">
                                    @T("Si rien ne remonte alors que des collectes sont actives, vérifiez que la tâche")
                                    <code>collect</code> est bien activée sur l'agent : elle est souvent installée
                                    @T("sans l'être, et le serveur ne peut pas l'activer à distance. Son état figure")
                                    @T("dans « Tâches activées » sur la fiche de l'agent.")
                                </p>
                            </div>
                        }
                    }
                    break;

                case "notes":
                    <p class="text-secondary">
                        @T("Notes libres attachées à ce poste. Elles ne viennent pas de l'inventaire et ne sont jamais écrasées par un agent : c'est le carnet de bord de ceux qui l'exploitent.")
                    </p>

                    <div class="mb-3">
                        <label class="form-label" for="pc-new-note">@T("Ajouter une note")</label>
                        <textarea id="pc-new-note" class="form-control" rows="3"
                                  placeholder="@(T("Intervention, particularité, rappel…"))"
                                  @bind="_newNote" @bind:event="oninput"></textarea>
                        <button type="button" class="btn btn-primary mt-2"
                                disabled="@string.IsNullOrWhiteSpace(_newNote)" @onclick="AddNoteAsync">
                            <i class="ti ti-plus me-1"></i>@T("Ajouter")
                        </button>
                    </div>

                    @if (_notes.Count == 0)
                    {
                        <div class="glping-config-placeholder">
                            <i class="ti ti-notes-off"></i>
                            <p class="mb-0">@T("Aucune note pour ce poste.")</p>
                        </div>
                    }
                    else
                    {
                        @foreach (ItemNote note in _notes)
                        {
                            <div class="card mb-2">
                                <div class="card-body">
                                    @if (_editingNoteId == note.Id)
                                    {
                                        <textarea class="form-control" rows="4"
                                                  @bind="_editingNote" @bind:event="oninput"></textarea>
                                        <div class="mt-2">
                                            <button type="button" class="btn btn-primary btn-sm"
                                                    disabled="@string.IsNullOrWhiteSpace(_editingNote)" @onclick="SaveNoteAsync">
                                                @T("Enregistrer")
                                            </button>
                                            <button type="button" class="btn btn-sm" @onclick="CancelEditNote">@T("Annuler")</button>
                                        </div>
                                    }
                                    else
                                    {
                                        @* Texte brut, volontairement : la fiche d'un poste n'a pas de rendu
                                           Markdown, et interpréter du balisage ici obligerait à l'assainir. *@
                                        <div style="white-space: pre-wrap;">@note.Content</div>

                                        <div class="d-flex align-items-center justify-content-between mt-2">
                                            <div class="text-secondary small">
                                                <i class="ti ti-user me-1"></i>@note.AuthorName
                                                <span class="ms-2">
                                                    <i class="ti ti-calendar me-1"></i>@Display.DateTime(note.CreatedAt)
                                                </span>
                                                @if (note.UpdatedAt is { } updated)
                                                {
                                                    <span class="ms-2">
                                                        <i class="ti ti-pencil me-1"></i>@T("Modifiée le {0}", Display.DateTime(updated))
                                                        @if (note.LastEditorName is { Length: > 0 } editor)
                                                        {
                                                            <text> @T("par {0}", editor)</text>
                                                        }
                                                    </span>
                                                }
                                            </div>

                                            <div class="text-nowrap">
                                                <button type="button" class="btn btn-icon btn-sm" title="@(T("Modifier"))"
                                                        @onclick="() => StartEditNote(note)">
                                                    <i class="ti ti-pencil"></i>
                                                </button>
                                                @if (_confirmDeleteNoteId == note.Id)
                                                {
                                                    <button type="button" class="btn btn-sm btn-danger"
                                                            @onclick="() => DeleteNoteAsync(note.Id)">
                                                        @T("Confirmer")
                                                    </button>
                                                    <button type="button" class="btn btn-sm"
                                                            @onclick="() => _confirmDeleteNoteId = null">
                                                        @T("Annuler")
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-icon btn-sm btn-ghost-danger" title="@(T("Supprimer"))"
                                                            @onclick="() => _confirmDeleteNoteId = note.Id">
                                                        <i class="ti ti-trash"></i>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    break;

                case "domains":
                    @if (_computer.Domain is null)
                    {
                        <div class="glping-config-placeholder">
                            <i class="ti ti-world-www"></i>
                            <p class="mb-0">@T("Aucun domaine remonté.")</p>
                        </div>
                    }
                    else
                    {
                        <div class="glping-fiche-block">
                            <div class="glping-fiche-block-title"><i class="ti ti-world-www"></i>@T("Domaines (1)")</div>
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("Nom")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>@_computer.Domain</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    break;

                case "importinfo":
                    @if (_computer.ImportHistories.Count == 0)
                    {
                        <div class="glping-config-placeholder">
                            <i class="ti ti-file-import"></i>
                            <p class="mb-0">@T("Aucun import d'inventaire enregistré.")</p>
                        </div>
                    }
                    else
                    {
                        <div class="glping-fiche-block">
                            <div class="glping-fiche-block-title">
                                <i class="ti ti-history"></i>@T("Historique des règles d'import ({0})", _importHistoryFiltered.Count)
                                <div class="glping-fiche-block-filter">
                                    <i class="ti ti-search"></i>
                                    <input type="text" placeholder="@(T("Filtrer..."))" value="@_importHistoryFilter" @oninput="OnImportHistoryFilterInput" />
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("Date")</th>
                                            <th>@T("Nom de la règle")</th>
                                            <th>@T("Agent")</th>
                                            <th>@T("Module")</th>
                                            <th>@T("Valeur d'entrée")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ComputerImportHistory entry in _importHistoryFiltered)
                                        {
                                            <tr>
                                                <td>@Display.DateTime(entry.OccurredAt)</td>
                                                <td>@entry.RuleName</td>
                                                <td>@(entry.AgentIdentifier ?? "—")</td>
                                                <td>@entry.Module</td>
                                                <td>@(entry.InputValue ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    break;

                case "history":
                    @if (_historySorted.Count == 0)
                    {
                        <div class="glping-config-placeholder">
                            <i class="ti ti-history"></i>
                            <p class="mb-0">@T("Aucune modification enregistrée.")</p>
                        </div>
                    }
                    else
                    {
                        <div class="glping-fiche-block">
                            <div class="glping-fiche-block-title">
                                <i class="ti ti-history"></i>@T("Historique ({0})", _historyFiltered.Count)
                                <div class="glping-fiche-block-filter">
                                    <i class="ti ti-search"></i>
                                    <input type="text" placeholder="@(T("Filtrer..."))" value="@_historyFilter" @oninput="OnHistoryFilterInput" />
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("ID")</th>
                                            <th>@T("Date")</th>
                                            <th>@T("Utilisateur")</th>
                                            <th>@T("Champ")</th>
                                            <th>@T("Mise à jour")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ComputerHistoryEntry entry in _historyPaged)
                                        {
                                            <tr>
                                                <td>@entry.Id</td>
                                                <td>@Display.DateTime(entry.OccurredAt)</td>
                                                <td>@entry.User</td>
                                                <td>@entry.Field</td>
                                                <td>@entry.Description</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (_historyFiltered.Count > HistoryPageSizeOptions[0])
                            {
                                <div class="card-footer d-flex align-items-center justify-content-between flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2 text-secondary">
                                        <span>@T("Éléments par page")</span>
                                        <select class="form-select form-select-sm w-auto" value="@_historyPageSize"
                                                @onchange="@((ChangeEventArgs e) => SetHistoryPageSize(int.Parse((string)e.Value!)))">
                                            @foreach (int size in HistoryPageSizeOptions)
                                            {
                                                <option value="@size">@size</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="text-secondary">
                                            @T("{0}–{1} sur {2}", (_historyPage - 1) * _historyPageSize + 1, Math.Min(_historyPage * _historyPageSize, _historyFiltered.Count), _historyFiltered.Count)
                                        </span>
                                        <ul class="pagination pagination-sm m-0">
                                            <li class="page-item @(_historyPage <= 1 ? "disabled" : "")">
                                                <button type="button" class="page-link" @onclick="() => GoToHistoryPage(_historyPage - 1)" disabled="@(_historyPage <= 1)">
                                                    <i class="ti ti-chevron-left"></i>
                                                </button>
                                            </li>
                                            <li class="page-item disabled">
                                                <span class="page-link">@T("Page {0} / {1}", _historyPage, HistoryTotalPages)</span>
                                            </li>
                                            <li class="page-item @(_historyPage >= HistoryTotalPages ? "disabled" : "")">
                                                <button type="button" class="page-link" @onclick="() => GoToHistoryPage(_historyPage + 1)" disabled="@(_historyPage >= HistoryTotalPages)">
                                                    <i class="ti ti-chevron-right"></i>
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    break;

                case "tasks":
                    @if (_deploymentTasksInfo is null)
                    {
                        <div class="glping-config-placeholder">
                            <i class="ti ti-checklist"></i>
                            <p class="mb-0">@T("Module de déploiement non disponible.")</p>
                        </div>
                    }
                    else if (_deploymentTasksInfo.Tasks.Count == 0 && _deploymentTasksInfo.Groups.Count == 0)
                    {
                        <div class="glping-config-placeholder">
                            <i class="ti ti-checklist"></i>
                            <p class="mb-0">@T("Aucune tâche de déploiement ni groupe pour ce poste.")</p>
                        </div>
                    }
                    else
                    {
                        @if (_deploymentTasksInfo.Tasks.Count > 0)
                        {
                            <div class="glping-fiche-block">
                                <div class="glping-fiche-block-title"><i class="ti ti-checklist"></i>@T("Tâches ({0})", _deploymentTasksInfo.Tasks.Count)</div>
                                <div class="table-responsive">
                                    <table class="table table-vcenter card-table mb-0">
                                        <thead>
                                            <tr>
                                                <th>@T("Tâche")</th>
                                                <th>@T("Activé")</th>
                                                <th>@T("Méthode")</th>
                                                <th>@T("Date")</th>
                                                <th>@T("Statut")</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (ComputerDeploymentTask task in _deploymentTasksInfo.Tasks)
                                            {
                                                <tr>
                                                    <td><a href="/tools/deployments/tasks/@task.TaskId">@task.Name</a></td>
                                                    <td><span class="badge @BoolBadgeCss(task.Active)">@BoolLabel(task.Active)</span></td>
                                                    <td>@task.MethodLabel</td>
                                                    <td colspan="3"></td>
                                                </tr>
                                                @foreach (ComputerDeploymentTaskExecution execution in task.Executions)
                                                {
                                                    <tr>
                                                        <td colspan="3" class="ps-4 text-secondary">
                                                            @if (execution.PackageName is not null)
                                                            {
                                                                <i class="ti ti-package me-1"></i>@execution.PackageName
                                                            }
                                                        </td>
                                                        <td>@(execution.DateUtc is { } date ? Display.DateTime(date) : "—")</td>
                                                        <td><span class="badge @execution.StatusBadgeCssClass">@execution.StatusLabel</span></td>
                                                        <td class="text-end">
                                                            @if (!string.IsNullOrWhiteSpace(execution.Log))
                                                            {
                                                                <button type="button" class="btn btn-sm" @onclick="() => ToggleTaskExecutionLog(execution.Key)">
                                                                    <i class="ti ti-file-text me-1"></i>@T("Journal")
                                                                </button>
                                                            }
                                                        </td>
                                                    </tr>
                                                    @if (_expandedTaskExecutionKey == execution.Key && !string.IsNullOrWhiteSpace(execution.Log))
                                                    {
                                                        <tr>
                                                            <td colspan="6">
                                                                <div class="glping-job-log">@RenderLog(execution.Log)</div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                        @if (_deploymentTasksInfo.Groups.Count > 0)
                        {
                            <div class="glping-fiche-block">
                                <div class="glping-fiche-block-title"><i class="ti ti-users-group"></i>@T("Groupes ({0})", _deploymentTasksInfo.Groups.Count)</div>
                                <div class="table-responsive">
                                    <table class="table table-vcenter card-table mb-0">
                                        <thead>
                                            <tr>
                                                <th>@T("Groupe")</th>
                                                <th>@T("Type")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (ComputerDeploymentGroup group in _deploymentTasksInfo.Groups)
                                            {
                                                <tr>
                                                    <td><a href="/tools/deployments/computer-groups/@group.GroupId">@group.Name</a></td>
                                                    <td>@T(group.TypeLabel)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }
                    break;

                case "deploy":
                    @if (DeploymentAssignmentService is null)
                    {
                        <div class="glping-config-placeholder">
                            <i class="ti ti-package"></i>
                            <p class="mb-0">@T("Module de déploiement non disponible.")</p>
                        </div>
                    }
                    else if (_computer.Agent is null)
                    {
                        <div class="glping-config-placeholder">
                            <i class="ti ti-package-off"></i>
                            <p class="mb-0">@T("Ce poste n'est associé à aucun agent GLPI-Agent : le déploiement de package n'est pas disponible.")</p>
                        </div>
                    }
                    else
                    {
                        <div class="glping-fiche-block">
                            <div class="glping-fiche-block-title"><i class="ti ti-package"></i>@T("Paquets assignés ({0})", _deploymentAssignments.Count)</div>

                            <div class="glping-fiche-block-body">
                                @if (_deploymentAssignments.Count > 0)
                                {
                                    <div class="table-responsive mb-3">
                                        <table class="table table-vcenter card-table mb-0">
                                            <thead>
                                                <tr>
                                                    <th>@T("Paquet")</th>
                                                    <th>@T("Statut")</th>
                                                    <th>@T("Créé le")</th>
                                                    <th>@T("Démarré le")</th>
                                                    <th>@T("Terminé le")</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (ComputerDeploymentAssignment assignment in _deploymentAssignments)
                                                {
                                                    <tr>
                                                        <td>
                                                            @if (assignment.TaskId is { } taskId)
                                                            {
                                                                <a href="/tools/deployments/tasks/@taskId">@assignment.PackageName</a>
                                                            }
                                                            else
                                                            {
                                                                @assignment.PackageName
                                                            }
                                                        </td>
                                                        <td><span class="badge @assignment.StatusBadgeCssClass">@assignment.StatusLabel</span></td>
                                                        <td>@Display.DateTime(assignment.CreatedAtUtc)</td>
                                                        <td>@(assignment.StartedAtUtc is { } started ? Display.DateTime(started) : "—")</td>
                                                        <td>@(assignment.CompletedAtUtc is { } completed ? Display.DateTime(completed) : "—")</td>
                                                        <td class="text-end">
                                                            <div class="btn-list justify-content-end flex-nowrap">
                                                                @if (!string.IsNullOrWhiteSpace(assignment.Log))
                                                                {
                                                                    <button type="button" class="btn btn-sm" @onclick="() => ToggleAssignmentLog(assignment.JobId)"
                                                                            title="@(IsInProgress(assignment) ? T("Journal mis à jour automatiquement") : null)">
                                                                        @if (IsInProgress(assignment))
                                                                        {
                                                                            <i class="ti ti-refresh glping-spin me-1"></i>
                                                                        }
                                                                        else
                                                                        {
                                                                            <i class="ti ti-file-text me-1"></i>
                                                                        }
                                                                        @T("Journal")
                                                                    </button>
                                                                }
                                                                @if (assignment.CanCancel)
                                                                {
                                                                    <button type="button" class="btn btn-sm btn-icon text-danger" title="@(T("Annuler cette assignation"))" @onclick="() => CancelAssignmentAsync(assignment.JobId)">
                                                                        <i class="ti ti-x"></i>
                                                                    </button>
                                                                }
                                                                @if (assignment.CanRetry)
                                                                {
                                                                    <button type="button" class="btn btn-sm px-3" title="@(T("Relancer cette assignation"))" disabled="@(_retryingJobId is not null)" @onclick="() => RetryAssignmentAsync(assignment.JobId)">
                                                                        <i class="ti ti-bolt @(_retryingJobId == assignment.JobId ? "glping-spin" : "")"></i>
                                                                    </button>
                                                                }
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    @if (_expandedAssignmentJobId == assignment.JobId && !string.IsNullOrWhiteSpace(assignment.Log))
                                                    {
                                                        <tr>
                                                            <td colspan="6">
                                                                <div class="glping-job-log" @ref="_expandedAssignmentLogRef">@RenderLog(assignment.Log)</div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-secondary small mb-3">@T("Aucun paquet assigné à ce poste pour le moment.")</p>
                                }

                                <div class="glping-fiche-add-row">
                                    <label class="form-label">@T("Sélectionner les paquets à installer")</label>
                                    <div class="glping-tag-select">
                                        @foreach (DeploymentPackageOption package in _selectedPackagesToAssign)
                                        {
                                            <span class="glping-tag">
                                                <button type="button" class="glping-tag-remove" title="@(T("Retirer"))" @onclick="() => RemovePackageToAssign(package.Id)">
                                                    <i class="ti ti-x"></i>
                                                </button>
                                                @package.Name
                                            </span>
                                        }
                                        @{
                                            var packagesLeftToAdd = _availablePackages.Where(p => !_selectedPackagesToAssign.Any(s => s.Id == p.Id)).ToList();
                                        }
                                        <select class="glping-tag-select-input" @key="_selectedPackagesToAssign.Count" disabled="@(packagesLeftToAdd.Count == 0)" @onchange="AddPackageToAssign">
                                            <option value="">@(packagesLeftToAdd.Count == 0 ? T("Aucun autre paquet disponible") : T("+ Ajouter un paquet…"))</option>
                                            @foreach (DeploymentPackageOption package in packagesLeftToAdd)
                                            {
                                                <option value="@package.Id">@package.Name</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="d-flex gap-2 mt-3">
                                        <button type="button" class="btn" disabled="@(_prepareInstallLoading || _selectedPackagesToAssign.Count == 0)" @onclick="PrepareInstallationAsync">
                                            <i class="ti ti-player-play @(_prepareInstallLoading ? "glping-spin" : "")"></i>
                                            @T("Préparer l'installation")
                                        </button>
                                        <div class="dropdown">
                                            <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                                @(_wakeMode switch
                                                {
                                                    DeploymentWakeMode.Local => T("Je suis sur cet ordinateur, faire un réveil local de l'agent"),
                                                    DeploymentWakeMode.Remote => T("Je ne suis pas sur cet ordinateur, faire un réveil de l'agent à distance"),
                                                    _ => T("Ne pas réveiller l'agent")
                                                })
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <button type="button" class="dropdown-item @(_wakeMode == DeploymentWakeMode.Local ? "active" : "")" @onclick="() => _wakeMode = DeploymentWakeMode.Local">
                                                        @T("Je suis sur cet ordinateur, faire un réveil local de l'agent")
                                                    </button>
                                                </li>
                                                <li>
                                                    <button type="button" class="dropdown-item @(_wakeMode == DeploymentWakeMode.Remote ? "active" : "")" @onclick="() => _wakeMode = DeploymentWakeMode.Remote">
                                                        @T("Je ne suis pas sur cet ordinateur, faire un réveil de l'agent à distance")
                                                    </button>
                                                </li>
                                                <li>
                                                    <button type="button" class="dropdown-item @(_wakeMode == DeploymentWakeMode.None ? "active" : "")" @onclick="() => _wakeMode = DeploymentWakeMode.None">
                                                        @T("Ne pas réveiller l'agent")
                                                    </button>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>

                                    @if (_prepareInstallError is { } error)
                                    {
                                        <div class="text-danger small mt-2"><i class="ti ti-alert-triangle me-1"></i>@error</div>
                                    }
                                    else if (_availablePackages.Count == 0)
                                    {
                                        @* Le catalogue peut être fourni sans qu'aucun paquet ne soit proposable ici :
                                           le libre-service s'active paquet par paquet, pour un groupe d'ordinateurs
                                           donné. Le dire, plutôt que de laisser croire qu'il n'existe aucun paquet. *@
                                        <div class="text-secondary small mt-2">
                                            @T("Aucun paquet en déploiement à la demande pour ce poste : le libre-service s'active sur la") <a href="/tools/deployments/packages">@T("fiche d'un paquet")</a>@T(", pour un groupe d'ordinateurs dont ce poste doit être membre.")
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    break;

                default:
                    var current = _tabs.First(t => t.Key == _activeTabKey);
                    <div class="glping-config-placeholder">
                        <i class="ti @current.Icon"></i>
                        <p class="mb-0">@T("L'onglet « {0} » n'est pas encore disponible.", current.Label)</p>
                    </div>
                    break;
            }
        </div>
    </div>
}
