@page "/parc/computer/{ComputerId:int}"
@using GlpiNg.Modules.Abstractions.Deployment
@using GlpiNg.Modules.Inventory.Models
@rendermode InteractiveServer

<PageTitle>GlpiNg — @(_computer?.Name ?? "Ordinateur")</PageTitle>

@if (_computer is null)
{
    <div class="text-center text-secondary py-5">
        <i class="ti ti-device-desktop-off fs-1"></i>
        <p class="mt-2">Ce poste est introuvable.</p>
    </div>
}
else
{
    <div class="glpi-fiche-topbar">
        <a class="glpi-fiche-pager-btn" href="@_listUrl" title="Retour à la liste">
            <i class="ti ti-list"></i>
        </a>
        <div class="glpi-fiche-crumb">
            <i class="ti ti-device-desktop"></i>
            <span>Ordinateur - @_computer.Name - ID @_computer.Id</span>
            <button type="button" class="glpi-fiche-favorite" title="Ajouter aux favoris">
                <i class="ti ti-star"></i>
            </button>
        </div>
        <div class="glpi-fiche-toolbar">
            <button type="button" class="glpi-fiche-pager-btn" title="Recharger les données" disabled="@_isReloading" @onclick="ReloadComputerAsync">
                <i class="ti ti-refresh @(_isReloading ? "glpi-spin" : "")"></i>
            </button>
            <div class="dropdown">
                <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ti ti-dots-vertical me-1"></i>Actions
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="#"><i class="ti ti-pencil me-1"></i>Modifier</a></li>
                    <li><a class="dropdown-item" href="#"><i class="ti ti-copy me-1"></i>Dupliquer</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item text-danger" href="#"><i class="ti ti-trash me-1"></i>Mettre à la corbeille</a></li>
                </ul>
            </div>
            @if (_total > 0)
            {
                <span class="glpi-fiche-pager-count">@_position/@_total</span>
                <a class="glpi-fiche-pager-btn @(_previousId is null ? "disabled" : "")" href="@(_previousId is { } prevId ? $"/parc/computer/{prevId}" : "#")">
                    <i class="ti ti-chevron-left"></i>
                </a>
                <a class="glpi-fiche-pager-btn @(_nextId is null ? "disabled" : "")" href="@(_nextId is { } nextId ? $"/parc/computer/{nextId}" : "#")">
                    <i class="ti ti-chevron-right"></i>
                </a>
            }
        </div>
    </div>

    <div class="glpi-fiche-layout">
        <aside class="glpi-fiche-sidebar">
            @foreach (var tab in _tabs)
            {
                <button type="button" class="glpi-fiche-tab-item @(_activeTabKey == tab.Key ? "active" : "")" @onclick="() => SetTab(tab.Key)">
                    <i class="ti @tab.Icon"></i>
                    <span>@tab.Label</span>
                    @if (tab.Count is { } count)
                    {
                        <span class="glpi-fiche-tab-count">@count</span>
                    }
                </button>
            }
        </aside>

        <div class="glpi-fiche-panel">
            @switch (_activeTabKey)
            {
                case "computer":
                    <div class="glpi-fiche-form">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="glpi-fiche-field">
                                    <label>Nom</label>
                                    <div class="glpi-fiche-value-box">@_computer.Name</div>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Emplacement</label>
                                    <div class="glpi-fiche-value-box">@(LocationLabel(_computer) ?? "—")</div>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Utilisateur assigné</label>
                                    <div class="glpi-fiche-value-box">@(_computer.AssignedUser ?? "—")</div>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Dernier utilisateur connecté</label>
                                    <div class="glpi-fiche-value-box">@(_computer.LastLoggedUser ?? "—")</div>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>UUID matériel</label>
                                    <div class="glpi-fiche-value-box"><code>@(_computer.HardwareUuid ?? "—")</code></div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="glpi-fiche-field">
                                    <label>Statut</label>
                                    <div class="glpi-fiche-value-box">
                                        <span class="badge @StatusCssClass(_computer.Status)">@StatusLabel(_computer.Status)</span>
                                    </div>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Type</label>
                                    <div class="glpi-fiche-value-box">@(_computer.ChassisType ?? "—")</div>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Fabricant</label>
                                    <div class="glpi-fiche-value-box">@(_computer.Manufacturer ?? "—")</div>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Modèle</label>
                                    <div class="glpi-fiche-value-box">@(_computer.Model ?? "—")</div>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>N° de série</label>
                                    <div class="glpi-fiche-value-box">@(_computer.SerialNumber ?? "—")</div>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Virtualisation</label>
                                    <div class="glpi-fiche-value-box">@(_computer.VmSystem is { Length: > 0 } vm && vm != "Physical" ? vm : "Machine physique")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (_computer.Agent is { } agent)
                    {
                        <div class="glpi-fiche-inventory-panel">
                            <div class="glpi-fiche-inventory-title"><i class="ti ti-cloud-upload"></i>Informations d'inventaire</div>
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="glpi-fiche-inventory-label">Agent</div>
                                    <div>
                                        @(agent.AgentName ?? agent.Hostname ?? agent.DeviceId ?? "—")
                                        @if (AgentWebUrl(agent, _computer) is { } agentWebUrl)
                                        {
                                            <a href="@agentWebUrl" target="_blank" rel="noopener noreferrer" title="Ouvrir la page web de l'agent" class="glpi-fiche-inventory-agent-link">
                                                <i class="ti ti-external-link"></i>
                                            </a>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="glpi-fiche-inventory-label">UserAgent</div>
                                    <div>@(agent.LastUserAgent ?? "—")</div>
                                </div>
                                <div class="col-md-4">
                                    <div class="glpi-fiche-inventory-label">Tag d'inventaire</div>
                                    <div>@(agent.Tag ?? "—")</div>
                                </div>
                                <div class="col-md-4">
                                    <div class="glpi-fiche-inventory-label">Adresse publique de contact</div>
                                    <div>@(agent.LastContactIp ?? "—")</div>
                                </div>
                                <div class="col-md-4">
                                    <div class="glpi-fiche-inventory-label">Dernier contact</div>
                                    <div>@agent.LastContactAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                                <div class="col-md-4">
                                    <div class="glpi-fiche-inventory-label">Dernière mise à jour de l'inventaire</div>
                                    <div>@LastInventoryLabel(_computer)</div>
                                </div>
                                <div class="col-md-4">
                                    <div class="glpi-fiche-inventory-label">
                                        Statut de l'agent
                                        <i class="ti ti-refresh @(_agentStatusLoading ? "glpi-spin" : "")" role="button" title="Interroger l'agent" @onclick="RefreshAgentStatusAsync"></i>
                                    </div>
                                    <div>@(_agentStatus ?? "Inconnu")</div>
                                </div>
                                <div class="col-md-4">
                                    <div class="glpi-fiche-inventory-label">
                                        Demander un inventaire
                                        <i class="ti ti-refresh @(_inventoryRequestLoading ? "glpi-spin" : "")" role="button" title="Demander un inventaire immédiat" @onclick="RequestInventoryAsync"></i>
                                    </div>
                                    <div>@(_inventoryRequestResult ?? "Inconnu")</div>
                                </div>
                            </div>
                            <div class="glpi-fiche-inventory-footer">
                                <span>Créé le @_computer.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                <span>Dernière mise à jour le @LastInventoryLabel(_computer)</span>
                            </div>
                        </div>
                    }
                    break;

                case "os":
                    <div class="glpi-fiche-form">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="glpi-fiche-field">
                                    <label>Système d'exploitation</label>
                                    <div class="glpi-fiche-value-box">@(_computer.OperatingSystem ?? "—")</div>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Version</label>
                                    <div class="glpi-fiche-value-box">@(_computer.OsVersion ?? "—")</div>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Version du noyau</label>
                                    <div class="glpi-fiche-value-box">@(_computer.OsKernelVersion ?? "—")</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="glpi-fiche-field">
                                    <label>Mémoire totale</label>
                                    <div class="glpi-fiche-value-box">@(_computer.TotalMemoryMb is { } mb ? $"{mb} Mo" : "—")</div>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Dernière remontée</label>
                                    <div class="glpi-fiche-value-box">@LastInventoryLabel(_computer)</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    break;

                case "components":
                    @if (_computer.Components.Count == 0)
                    {
                        <div class="glpi-config-placeholder">
                            <i class="ti ti-cpu-off"></i>
                            <p class="mb-0">Aucun composant remonté.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var group in ComponentGroups(_computer))
                        {
                            <div class="glpi-fiche-block">
                                <div class="glpi-fiche-block-title">
                                    <i class="ti @ComponentTypeIcon(group.Key)"></i>@ComponentTypeLabel(group.Key) (@group.Count())
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-vcenter card-table mb-0">
                                        <thead>
                                            <tr>
                                                <th>Désignation</th>
                                                <th>Capacité</th>
                                                <th>Numéro de série</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (ComputerComponent component in group)
                                            {
                                                <tr>
                                                    <td>@component.Designation</td>
                                                    <td>@(component.Capacity ?? "—")</td>
                                                    <td>@(component.Serial ?? "—")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }
                    break;

                case "batteries":
                    @if (_computer.Batteries.Count == 0)
                    {
                        <div class="glpi-config-placeholder">
                            <i class="ti ti-battery-off"></i>
                            <p class="mb-0">Aucune batterie remontée.</p>
                        </div>
                    }
                    else
                    {
                        <div class="glpi-fiche-block">
                            <div class="glpi-fiche-block-title"><i class="ti ti-battery"></i>Batteries (@_computer.Batteries.Count)</div>
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Nom</th>
                                            <th>Fabricant</th>
                                            <th>Type</th>
                                            <th>Tension</th>
                                            <th>Capacité</th>
                                            <th>Capacité réelle</th>
                                            <th>Numéro de série</th>
                                            <th>Date de fabrication</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ComputerBattery battery in _computer.Batteries)
                                        {
                                            int? wearPercent = WearPercent(battery.CapacityMwh, battery.RealCapacityMwh);
                                            <tr>
                                                <td>@battery.Name</td>
                                                <td>@(battery.Manufacturer ?? "—")</td>
                                                <td>@(battery.Chemistry ?? "—")</td>
                                                <td>@VoltageLabel(battery.VoltageMv)</td>
                                                <td>@CapacityLabel(battery.CapacityMwh)</td>
                                                <td>
                                                    @if (battery.RealCapacityMwh is null)
                                                    {
                                                        @:—
                                                    }
                                                    else
                                                    {
                                                        <span class="badge @WearBadgeCss(wearPercent)">
                                                            @RealCapacityLabel(battery.RealCapacityMwh)@(wearPercent is { } p ? $" ({p}%)" : "")
                                                        </span>
                                                    }
                                                </td>
                                                <td>@(battery.Serial ?? "—")</td>
                                                <td>@(battery.ManufactureDate ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    break;

                case "software":
                    @if (_computer.Softwares.Count == 0)
                    {
                        <div class="glpi-config-placeholder">
                            <i class="ti ti-apps-off"></i>
                            <p class="mb-0">Aucun logiciel remonté.</p>
                        </div>
                    }
                    else
                    {
                        <div class="glpi-fiche-block">
                            <div class="glpi-fiche-block-title"><i class="ti ti-apps"></i>Logiciels installés (@_softwareSorted.Count)</div>
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Nom</th>
                                            <th>Version</th>
                                            <th>Éditeur</th>
                                            <th>Date d'installation</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ComputerSoftware software in _softwarePaged)
                                        {
                                            <tr>
                                                <td>@software.Name</td>
                                                <td>@(software.Version ?? "—")</td>
                                                <td>@(software.Publisher ?? "—")</td>
                                                <td>@(software.InstallDate ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (_softwareSorted.Count > SoftwarePageSizeOptions[0])
                            {
                                <div class="card-footer d-flex align-items-center justify-content-between flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2 text-secondary">
                                        <span>Éléments par page</span>
                                        <select class="form-select form-select-sm w-auto" value="@_softwarePageSize"
                                                @onchange="@((ChangeEventArgs e) => SetSoftwarePageSize(int.Parse((string)e.Value!)))">
                                            @foreach (int size in SoftwarePageSizeOptions)
                                            {
                                                <option value="@size">@size</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="text-secondary">
                                            @((_softwarePage - 1) * _softwarePageSize + 1)–@(Math.Min(_softwarePage * _softwarePageSize, _softwareSorted.Count)) sur @_softwareSorted.Count
                                        </span>
                                        <ul class="pagination pagination-sm m-0">
                                            <li class="page-item @(_softwarePage <= 1 ? "disabled" : "")">
                                                <button type="button" class="page-link" @onclick="() => GoToSoftwarePage(_softwarePage - 1)" disabled="@(_softwarePage <= 1)">
                                                    <i class="ti ti-chevron-left"></i>
                                                </button>
                                            </li>
                                            <li class="page-item disabled">
                                                <span class="page-link">Page @_softwarePage / @SoftwareTotalPages</span>
                                            </li>
                                            <li class="page-item @(_softwarePage >= SoftwareTotalPages ? "disabled" : "")">
                                                <button type="button" class="page-link" @onclick="() => GoToSoftwarePage(_softwarePage + 1)" disabled="@(_softwarePage >= SoftwareTotalPages)">
                                                    <i class="ti ti-chevron-right"></i>
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    break;

                case "volumes":
                    @if (_computer.Volumes.Count == 0)
                    {
                        <div class="glpi-config-placeholder">
                            <i class="ti ti-server-off"></i>
                            <p class="mb-0">Aucun volume remonté.</p>
                        </div>
                    }
                    else
                    {
                        <div class="glpi-fiche-block">
                            <div class="glpi-fiche-block-title"><i class="ti ti-server-2"></i>Volumes (@_computer.Volumes.Count)</div>
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Nom</th>
                                            <th>Inventaire automatique</th>
                                            <th>Partition</th>
                                            <th>Point de montage</th>
                                            <th>Système de fichier</th>
                                            <th>Taille totale</th>
                                            <th>Espace disponible</th>
                                            <th>Taux d'utilisation</th>
                                            <th>Chiffrement</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ComputerVolume volume in _computer.Volumes)
                                        {
                                            <tr>
                                                <td>@volume.Name</td>
                                                <td>Oui</td>
                                                <td>@(volume.Partition ?? "—")</td>
                                                <td>@(volume.MountPoint ?? "—")</td>
                                                <td>@(volume.FileSystem ?? "—")</td>
                                                <td>@SizeLabel(volume.TotalSizeMb)</td>
                                                <td>@SizeLabel(volume.FreeSizeMb)</td>
                                                <td>
                                                    @if (UsagePercent(volume) is { } percent)
                                                    {
                                                        <div class="glpi-usage-bar">
                                                            <div class="glpi-usage-bar-fill" style="width: @(percent)%"></div>
                                                            <span>@percent %</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span>—</span>
                                                    }
                                                </td>
                                                <td>@(volume.Encryption ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    break;

                case "connections":
                    @if (_computer.Peripherals.Count == 0)
                    {
                        <div class="glpi-config-placeholder">
                            <i class="ti ti-device-tv-off"></i>
                            <p class="mb-0">Aucun périphérique connecté remonté.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var group in PeripheralGroups(_computer))
                        {
                            <div class="glpi-fiche-block">
                                <div class="glpi-fiche-block-title">
                                    <i class="ti @PeripheralKindIcon(group.Key)"></i>@PeripheralKindLabel(group.Key) (@group.Count())
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-vcenter card-table mb-0">
                                        <thead>
                                            <tr>
                                                <th>Désignation</th>
                                                <th>Fabricant</th>
                                                <th>Numéro de série</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (ComputerPeripheral peripheral in group)
                                            {
                                                <tr>
                                                    <td>
                                                        @if (peripheral.Kind == PeripheralKind.Monitor)
                                                        {
                                                            <a href="@($"/parc/monitors/{peripheral.Id}")" class="text-reset">@peripheral.Designation</a>
                                                        }
                                                        else
                                                        {
                                                            @peripheral.Designation
                                                        }
                                                    </td>
                                                    <td>@(peripheral.Manufacturer ?? "—")</td>
                                                    <td>@(peripheral.Serial ?? "—")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }
                    break;

                case "networkports":
                    @if (_computer.NetworkPorts.Count == 0)
                    {
                        <div class="glpi-config-placeholder">
                            <i class="ti ti-network-off"></i>
                            <p class="mb-0">Aucun port réseau remonté.</p>
                        </div>
                    }
                    else
                    {
                        <div class="glpi-fiche-block">
                            <div class="glpi-fiche-block-title"><i class="ti ti-network"></i>Ports réseau (@_computer.NetworkPorts.Count)</div>
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Nom</th>
                                            <th>Type</th>
                                            <th>Adresse MAC</th>
                                            <th>Adresse IP</th>
                                            <th>Masque</th>
                                            <th>Passerelle</th>
                                            <th>Sous-réseau</th>
                                            <th>DHCP</th>
                                            <th>MTU</th>
                                            <th>Vitesse</th>
                                            <th>Statut</th>
                                            <th>Virtuel</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ComputerNetworkPort port in _computer.NetworkPorts)
                                        {
                                            <tr>
                                                <td>@port.Designation</td>
                                                <td>@(port.Type ?? "—")</td>
                                                <td>@FormatMac(port.MacAddress)</td>
                                                <td>@(port.IpAddress ?? "—")</td>
                                                <td>@(port.IpMask ?? "—")</td>
                                                <td>@(port.IpGateway ?? "—")</td>
                                                <td>@(port.IpSubnet ?? "—")</td>
                                                <td>@DhcpLabel(port.IpDhcp)</td>
                                                <td>@(port.Mtu?.ToString() ?? "—")</td>
                                                <td>@SpeedLabel(port.SpeedMbps)</td>
                                                <td>@(port.Status ?? "—")</td>
                                                <td>@(port.IsVirtual ? "Oui" : "Non")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    break;

                case "antivirus":
                    @if (_computer.Antiviruses.Count == 0)
                    {
                        <div class="glpi-config-placeholder">
                            <i class="ti ti-shield-off"></i>
                            <p class="mb-0">Aucun antivirus remonté.</p>
                        </div>
                    }
                    else
                    {
                        <div class="glpi-fiche-block">
                            <div class="glpi-fiche-block-title"><i class="ti ti-shield-check"></i>Antivirus (@_computer.Antiviruses.Count)</div>
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Nom</th>
                                            <th>Éditeur</th>
                                            <th>Version</th>
                                            <th>Actif</th>
                                            <th>À jour</th>
                                            <th>Version de la base</th>
                                            <th>Date de la base</th>
                                            <th>Expiration</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ComputerAntivirus antivirus in _computer.Antiviruses)
                                        {
                                            <tr>
                                                <td>@antivirus.Name</td>
                                                <td>@(antivirus.Company ?? "—")</td>
                                                <td>@(antivirus.Version ?? "—")</td>
                                                <td><span class="badge @BoolBadgeCss(antivirus.Enabled)">@BoolLabel(antivirus.Enabled)</span></td>
                                                <td><span class="badge @BoolBadgeCss(antivirus.UpToDate)">@BoolLabel(antivirus.UpToDate)</span></td>
                                                <td>@(antivirus.BaseVersion ?? "—")</td>
                                                <td>@(antivirus.BaseCreationDate ?? "—")</td>
                                                <td>@(antivirus.Expiration ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    break;

                case "domains":
                    @if (_computer.Domain is null)
                    {
                        <div class="glpi-config-placeholder">
                            <i class="ti ti-world-www"></i>
                            <p class="mb-0">Aucun domaine remonté.</p>
                        </div>
                    }
                    else
                    {
                        <div class="glpi-fiche-block">
                            <div class="glpi-fiche-block-title"><i class="ti ti-world-www"></i>Domaines (1)</div>
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Nom</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>@_computer.Domain</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    break;

                case "importinfo":
                    @if (_computer.ImportHistories.Count == 0)
                    {
                        <div class="glpi-config-placeholder">
                            <i class="ti ti-file-import"></i>
                            <p class="mb-0">Aucun import d'inventaire enregistré.</p>
                        </div>
                    }
                    else
                    {
                        <div class="glpi-fiche-block">
                            <div class="glpi-fiche-block-title"><i class="ti ti-history"></i>Historique des règles d'import</div>
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Nom de la règle</th>
                                            <th>Agent</th>
                                            <th>Module</th>
                                            <th>Valeur d'entrée</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ComputerImportHistory entry in _computer.ImportHistories.OrderByDescending(e => e.OccurredAt))
                                        {
                                            <tr>
                                                <td>@entry.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                                <td>@entry.RuleName</td>
                                                <td>@(entry.AgentIdentifier ?? "—")</td>
                                                <td>@entry.Module</td>
                                                <td>@(entry.InputValue ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    break;

                case "history":
                    @if (_computer.HistoryEntries.Count == 0)
                    {
                        <div class="glpi-config-placeholder">
                            <i class="ti ti-history"></i>
                            <p class="mb-0">Aucune modification enregistrée.</p>
                        </div>
                    }
                    else
                    {
                        <div class="glpi-fiche-block">
                            <div class="glpi-fiche-block-title"><i class="ti ti-history"></i>Historique (@_computer.HistoryEntries.Count)</div>
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Date</th>
                                            <th>Utilisateur</th>
                                            <th>Champ</th>
                                            <th>Mise à jour</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ComputerHistoryEntry entry in _computer.HistoryEntries.OrderByDescending(e => e.OccurredAt).ThenByDescending(e => e.Id))
                                        {
                                            <tr>
                                                <td>@entry.Id</td>
                                                <td>@entry.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                                <td>@entry.User</td>
                                                <td>@entry.Field</td>
                                                <td>@entry.Description</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    break;

                case "tasks":
                    @if (_deploymentTasksInfo is null)
                    {
                        <div class="glpi-config-placeholder">
                            <i class="ti ti-checklist"></i>
                            <p class="mb-0">Module de déploiement non disponible.</p>
                        </div>
                    }
                    else if (_deploymentTasksInfo.Tasks.Count == 0 && _deploymentTasksInfo.Groups.Count == 0)
                    {
                        <div class="glpi-config-placeholder">
                            <i class="ti ti-checklist"></i>
                            <p class="mb-0">Aucune tâche de déploiement ni groupe pour ce poste.</p>
                        </div>
                    }
                    else
                    {
                        @if (_deploymentTasksInfo.Tasks.Count > 0)
                        {
                            <div class="glpi-fiche-block">
                                <div class="glpi-fiche-block-title"><i class="ti ti-checklist"></i>Tâches (@_deploymentTasksInfo.Tasks.Count)</div>
                                <div class="table-responsive">
                                    <table class="table table-vcenter card-table mb-0">
                                        <thead>
                                            <tr>
                                                <th>Tâche</th>
                                                <th>Activé</th>
                                                <th>Module method</th>
                                                <th>Date</th>
                                                <th>Statut</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (ComputerDeploymentTask task in _deploymentTasksInfo.Tasks)
                                            {
                                                <tr>
                                                    <td><a href="/tools/deployments/package/@task.PackageId">@task.Name</a></td>
                                                    <td><span class="badge @BoolBadgeCss(task.Active)">@BoolLabel(task.Active)</span></td>
                                                    <td>@task.MethodLabel</td>
                                                    <td colspan="2"></td>
                                                </tr>
                                                @foreach (ComputerDeploymentTaskExecution execution in task.Executions)
                                                {
                                                    <tr>
                                                        <td colspan="3"></td>
                                                        <td>@(execution.DateUtc is { } date ? date.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "—")</td>
                                                        <td><span class="badge @execution.StatusBadgeCssClass">@execution.StatusLabel</span></td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                        @if (_deploymentTasksInfo.Groups.Count > 0)
                        {
                            <div class="glpi-fiche-block">
                                <div class="glpi-fiche-block-title"><i class="ti ti-users-group"></i>Groupes (@_deploymentTasksInfo.Groups.Count)</div>
                                <div class="table-responsive">
                                    <table class="table table-vcenter card-table mb-0">
                                        <thead>
                                            <tr>
                                                <th>Groupe</th>
                                                <th>Type</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (ComputerDeploymentGroup group in _deploymentTasksInfo.Groups)
                                            {
                                                <tr>
                                                    <td><a href="/tools/deployments/computer-groups/@group.GroupId">@group.Name</a></td>
                                                    <td>@group.TypeLabel</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }
                    break;

                case "deploy":
                    @if (DeploymentAssignmentService is null)
                    {
                        <div class="glpi-config-placeholder">
                            <i class="ti ti-package"></i>
                            <p class="mb-0">Module de déploiement non disponible.</p>
                        </div>
                    }
                    else if (_computer.Agent is null)
                    {
                        <div class="glpi-config-placeholder">
                            <i class="ti ti-package-off"></i>
                            <p class="mb-0">Ce poste n'est associé à aucun agent GLPI-Agent : le déploiement de package n'est pas disponible.</p>
                        </div>
                    }
                    else
                    {
                        <div class="glpi-fiche-block">
                            <div class="glpi-fiche-block-title"><i class="ti ti-package"></i>Paquets assignés (@_deploymentAssignments.Count)</div>

                            <div class="glpi-fiche-block-body">
                                @if (_deploymentAssignments.Count > 0)
                                {
                                    <div class="table-responsive mb-3">
                                        <table class="table table-vcenter card-table mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Paquet</th>
                                                    <th>Statut</th>
                                                    <th>Créé le</th>
                                                    <th>Démarré le</th>
                                                    <th>Terminé le</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (ComputerDeploymentAssignment assignment in _deploymentAssignments)
                                                {
                                                    <tr>
                                                        <td><a href="/tools/deployments/package/@assignment.PackageId">@assignment.PackageName</a></td>
                                                        <td><span class="badge @assignment.StatusBadgeCssClass">@assignment.StatusLabel</span></td>
                                                        <td>@assignment.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                                        <td>@(assignment.StartedAtUtc is { } started ? started.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "—")</td>
                                                        <td>@(assignment.CompletedAtUtc is { } completed ? completed.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "—")</td>
                                                        <td class="text-end">
                                                            @if (assignment.CanCancel)
                                                            {
                                                                <button type="button" class="btn btn-sm btn-icon text-danger" title="Annuler cette assignation" @onclick="() => CancelAssignmentAsync(assignment.JobId)">
                                                                    <i class="ti ti-x"></i>
                                                                </button>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-secondary small mb-3">Aucun paquet assigné à ce poste pour le moment.</p>
                                }

                                <div class="glpi-fiche-add-row">
                                    <label class="form-label">Sélectionner les paquets à installer</label>
                                    <div class="glpi-tag-select">
                                        @foreach (DeploymentPackageOption package in _selectedPackagesToAssign)
                                        {
                                            <span class="glpi-tag">
                                                <button type="button" class="glpi-tag-remove" title="Retirer" @onclick="() => RemovePackageToAssign(package.Id)">
                                                    <i class="ti ti-x"></i>
                                                </button>
                                                @package.Name
                                            </span>
                                        }
                                        @{
                                            var packagesLeftToAdd = _availablePackages.Where(p => !_selectedPackagesToAssign.Any(s => s.Id == p.Id)).ToList();
                                        }
                                        <select class="glpi-tag-select-input" @key="_selectedPackagesToAssign.Count" disabled="@(packagesLeftToAdd.Count == 0)" @onchange="AddPackageToAssign">
                                            <option value="">@(packagesLeftToAdd.Count == 0 ? "Aucun autre paquet disponible" : "+ Ajouter un paquet…")</option>
                                            @foreach (DeploymentPackageOption package in packagesLeftToAdd)
                                            {
                                                <option value="@package.Id">@package.Name</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="d-flex gap-2 mt-3">
                                        <button type="button" class="btn" disabled="@(_prepareInstallLoading || _selectedPackagesToAssign.Count == 0)" @onclick="PrepareInstallationAsync">
                                            <i class="ti ti-player-play @(_prepareInstallLoading ? "glpi-spin" : "")"></i>
                                            Préparer l'installation
                                        </button>
                                        <div class="dropdown">
                                            <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                                @(_wakeMode == DeploymentWakeMode.Local ? "Je suis sur cet ordinateur, faire un réveil local de l'agent" : "Ne pas réveiller l'agent")
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <button type="button" class="dropdown-item @(_wakeMode == DeploymentWakeMode.Local ? "active" : "")" @onclick="() => _wakeMode = DeploymentWakeMode.Local">
                                                        Je suis sur cet ordinateur, faire un réveil local de l'agent
                                                    </button>
                                                </li>
                                                <li>
                                                    <button type="button" class="dropdown-item disabled" disabled title="Wake-on-LAN non disponible dans GlpiNg" aria-disabled="true">
                                                        Je ne suis pas sur cet ordinateur, faire un réveil de l'agent à distance
                                                    </button>
                                                </li>
                                                <li>
                                                    <button type="button" class="dropdown-item @(_wakeMode == DeploymentWakeMode.None ? "active" : "")" @onclick="() => _wakeMode = DeploymentWakeMode.None">
                                                        Ne pas réveiller l'agent
                                                    </button>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>

                                    @if (_prepareInstallError is { } error)
                                    {
                                        <div class="text-danger small mt-2"><i class="ti ti-alert-triangle me-1"></i>@error</div>
                                    }
                                    else if (_availablePackages.Count == 0)
                                    {
                                        <div class="text-secondary small mt-2">Aucun paquet de déploiement disponible. <a href="/tools/deployments/packages">Créer un paquet</a>.</div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    break;

                default:
                    var current = _tabs.First(t => t.Key == _activeTabKey);
                    <div class="glpi-config-placeholder">
                        <i class="ti @current.Icon"></i>
                        <p class="mb-0">L'onglet « @current.Label » n'est pas encore disponible.</p>
                    </div>
                    break;
            }
        </div>
    </div>
}
