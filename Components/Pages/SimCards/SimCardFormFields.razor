@using GlpiNg.Modules.Inventory.Models

<div class="row">
    <div class="col-md-6">
        <div class="glping-fiche-field">
            <label>Nom</label>
            <input class="form-control" @bind="Item.Name" @bind:event="oninput" @bind:after="NotifyChangedAsync" />
        </div>
        <div class="glping-fiche-field">
            <label>Statut</label>
            <select class="form-select" value="@(Item.StatusId?.ToString() ?? "")"
                    @onchange="@((ChangeEventArgs e) => Item.StatusId = string.IsNullOrEmpty((string?)e.Value) ? null : int.Parse((string)e.Value!))">
                <option value="">—</option>
                @foreach (DropdownItem status in StatusOptions)
                {
                    <option value="@status.Id">@status.Name</option>
                }
            </select>
        </div>
        <div class="glping-fiche-field">
            <label>Lieu</label>
            <select class="form-select" value="@(Item.LocationId?.ToString() ?? "")"
                    @onchange="@((ChangeEventArgs e) => Item.LocationId = string.IsNullOrEmpty((string?)e.Value) ? null : int.Parse((string)e.Value!))">
                <option value="">—</option>
                @foreach (DropdownItem location in LocationOptions)
                {
                    <option value="@location.Id">@location.Name</option>
                }
            </select>
        </div>
        <div class="glping-fiche-field">
            <label>Type</label>
            <input class="form-control" @bind="Item.Type" placeholder="mini / micro / nano" />
        </div>
        <div class="glping-fiche-field">
            <label>Opérateur</label>
            <input class="form-control" @bind="Item.Operator" />
        </div>
        <div class="glping-fiche-field">
            <label>ICCID (numéro de série)</label>
            <input class="form-control" @bind="Item.SerialNumber" />
        </div>
        <div class="glping-fiche-field">
            <label>Numéro d'inventaire</label>
            <input class="form-control" @bind="Item.InventoryNumber" />
        </div>
        <div class="glping-fiche-field">
            <label>Numéro de ligne</label>
            <input class="form-control" @bind="Item.PhoneNumber" />
        </div>
    </div>
    <div class="col-md-6">
        <div class="glping-fiche-field">
            <label>MSIN</label>
            <input class="form-control" @bind="Item.Msin" />
        </div>
        <div class="row">
            <div class="col-6">
                <div class="glping-fiche-field">
                    <label>PIN</label>
                    <input class="form-control" @bind="Item.Pin" />
                </div>
            </div>
            <div class="col-6">
                <div class="glping-fiche-field">
                    <label>PIN 2</label>
                    <input class="form-control" @bind="Item.Pin2" />
                </div>
            </div>
            <div class="col-6">
                <div class="glping-fiche-field">
                    <label>PUK</label>
                    <input class="form-control" @bind="Item.Puk" />
                </div>
            </div>
            <div class="col-6">
                <div class="glping-fiche-field">
                    <label>PUK 2</label>
                    <input class="form-control" @bind="Item.Puk2" />
                </div>
            </div>
        </div>
        <div class="glping-fiche-field">
            <label>Tension</label>
            <input class="form-control" @bind="Item.Voltage" placeholder="1,8 V / 3 V / 5 V" />
        </div>
        <div class="glping-fiche-field">
            <label>Pays</label>
            <input class="form-control" @bind="Item.Country" />
        </div>
        <div class="glping-fiche-field">
            <label class="form-check">
                <input class="form-check-input" type="checkbox" @bind="Item.AllowVoip" />
                <span class="form-check-label">Voix sur IP autorisée</span>
            </label>
        </div>
        <div class="glping-fiche-field">
            <label>Technicien responsable</label>
            <input class="form-control" @bind="Item.TechnicianInCharge" />
        </div>
        <div class="glping-fiche-field">
            <label>Utilisateur</label>
            <input class="form-control" @bind="Item.AssignedUser" />
        </div>
        <div class="glping-fiche-field">
            <label>Commentaires</label>
            <textarea class="form-control" rows="3" @bind="Item.Comment"></textarea>
        </div>
    </div>
</div>

<hr class="my-3" />

<EntityScopeFields Item="Item" />

@code {
    [Parameter, EditorRequired]
    public SimCard Item { get; set; } = null!;

    [Parameter, EditorRequired]
    public List<DropdownItem> StatusOptions { get; set; } = [];

    [Parameter, EditorRequired]
    public List<DropdownItem> LocationOptions { get; set; } = [];

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private Task NotifyChangedAsync() => OnChanged.InvokeAsync();
}
