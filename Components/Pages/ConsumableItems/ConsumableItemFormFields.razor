@using GlpiNg.Modules.Inventory.Models

<div class="row">
    <div class="col-md-6">
        <div class="glping-fiche-field">
            <label>@T("Nom")</label>
            <input class="form-control" @bind="Item.Name" @bind:event="oninput" @bind:after="NotifyChangedAsync" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Type")</label>
            <input class="form-control" @bind="Item.Type" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Référence")</label>
            <input class="form-control" @bind="Item.Reference" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Fabricant")</label>
            <input class="form-control" @bind="Item.Manufacturer" />
        </div>
    </div>
    <div class="col-md-6">
        <div class="glping-fiche-field">
            <label>@T("Lieu")</label>
            <select class="form-select" value="@(Item.LocationId?.ToString() ?? "")"
                    @onchange="@((ChangeEventArgs e) => Item.LocationId = string.IsNullOrEmpty((string?)e.Value) ? null : int.Parse((string)e.Value!))">
                <option value="">—</option>
                @foreach (DropdownItem location in LocationOptions)
                {
                    <option value="@location.Id">@location.Name</option>
                }
            </select>
        </div>
        <div class="glping-fiche-field">
            <label>@T("Technicien responsable")</label>
            <input class="form-control" @bind="Item.TechnicianInCharge" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Seuil d'alerte")</label>
            <input type="number" class="form-control" value="@Item.AlertThreshold"
                   @onchange="@((ChangeEventArgs e) => Item.AlertThreshold = int.Parse((string)e.Value!))" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Commentaires")</label>
            <textarea class="form-control" rows="3" @bind="Item.Comment"></textarea>
        </div>
    </div>
</div>

<hr class="my-3" />

<EntityScopeFields Item="Item" />

@code {
    [Parameter, EditorRequired]
    public ConsumableItem Item { get; set; } = null!;

    [Parameter, EditorRequired]
    public List<DropdownItem> LocationOptions { get; set; } = [];

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private Task NotifyChangedAsync() => OnChanged.InvokeAsync();
}
