@page "/parc/consumable-items/{ItemId:int}"
@using GlpiNg.Modules.Inventory.Models
@rendermode InteractiveServer

<PageTitle>@(_item?.Name ?? "Modèle de consommable") — GlpiNg</PageTitle>

@if (_item is null)
{
    <div class="text-center text-secondary py-5">
        <i class="ti ti-package-off fs-1"></i>
        <p class="mt-2">Ce modèle de consommable est introuvable.</p>
    </div>
}
else
{
    <div class="glpi-fiche-topbar">
        <div class="glpi-fiche-crumb">
            <i class="ti ti-package"></i>
            <span>Modèle de consommable - @_item.Name - ID @_item.Id</span>
        </div>
    </div>

    <div class="glpi-fiche-layout">
        <aside class="glpi-fiche-sidebar">
            <button type="button" class="glpi-fiche-tab-item @(_activeTabKey == "main" ? "active" : "")" @onclick='() => SetTab("main")'>
                <i class="ti ti-package"></i>
                <span>Modèle</span>
            </button>
            <button type="button" class="glpi-fiche-tab-item @(_activeTabKey == "stock" ? "active" : "")" @onclick='() => SetTab("stock")'>
                <i class="ti ti-stack-2"></i>
                <span>Stock</span>
                <span class="glpi-fiche-tab-count">@_item.Consumables.Count</span>
            </button>
            <button type="button" class="glpi-fiche-tab-item @(_activeTabKey == "history" ? "active" : "")" @onclick='() => SetTab("history")'>
                <i class="ti ti-history"></i>
                <span>Historique</span>
                <span class="glpi-fiche-tab-count">@_item.HistoryEntries.Count</span>
            </button>
        </aside>

        <div class="glpi-fiche-panel">
            @switch (_activeTabKey)
            {
                case "main":
                    <EditForm Model="_item" OnValidSubmit="SaveAsync">
                        <ConsumableItemFormFields Item="_item" LocationOptions="_locationOptions" />

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync">
                                <i class="ti ti-trash me-1"></i>Supprimer définitivement
                            </button>
                            <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? "Enregistrement…" : "Sauvegarder")
                            </button>
                        </div>
                    </EditForm>
                    break;

                case "stock":
                    int available = _item.Consumables.Count(c => c.DateOut is null);
                    int consumed = _item.Consumables.Count(c => c.DateOut is not null);
                    <div class="glpi-fiche-block">
                        <div class="glpi-fiche-block-title"><i class="ti ti-stack-2"></i>Stock</div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="text-secondary">Disponible</div>
                                <div class="fs-2 fw-bold @(available < _item.AlertThreshold ? "text-danger" : "")">@available</div>
                            </div>
                            <div class="col-md-6">
                                <div class="text-secondary">Consommées</div>
                                <div class="fs-2 fw-bold">@consumed</div>
                            </div>
                        </div>

                        <div class="d-flex align-items-end gap-2 mb-3">
                            <div>
                                <label class="form-label">Réceptionner</label>
                                <input type="number" min="1" class="form-control" style="width: 100px;" @bind="_receiveQuantity" />
                            </div>
                            <button type="button" class="btn btn-primary" @onclick="ReceiveStockAsync">
                                <i class="ti ti-plus me-1"></i>Ajouter au stock
                            </button>
                        </div>

                        @if (_item.Consumables.Count == 0)
                        {
                            <div class="glpi-config-placeholder">
                                <i class="ti ti-stack-2"></i>
                                <p class="mb-0">Aucune unité réceptionnée pour ce modèle.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Réceptionnée le</th>
                                            <th>Statut</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (Consumable consumable in _item.Consumables.OrderByDescending(c => c.DateIn))
                                        {
                                            <tr>
                                                <td>@consumable.Id</td>
                                                <td>@consumable.DateIn.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                                <td>
                                                    @if (consumable.DateOut is not null)
                                                    {
                                                        <span class="badge bg-secondary-lt">Consommée</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-green-lt">En stock</span>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    @if (consumable.DateOut is null)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ConsumeAsync(consumable)">
                                                            Consommer
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    break;

                case "history":
                    <div class="glpi-fiche-block">
                        <div class="glpi-fiche-block-title"><i class="ti ti-history"></i>Historique (@_item.HistoryEntries.Count)</div>
                        @if (_item.HistoryEntries.Count == 0)
                        {
                            <div class="glpi-config-placeholder">
                                <i class="ti ti-history"></i>
                                <p class="mb-0">Aucune modification enregistrée.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Date</th>
                                            <th>Utilisateur</th>
                                            <th>Champ</th>
                                            <th>Mise à jour</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ConsumableItemHistoryEntry entry in _item.HistoryEntries.OrderByDescending(e => e.OccurredAt).ThenByDescending(e => e.Id))
                                        {
                                            <tr>
                                                <td>@entry.Id</td>
                                                <td>@entry.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                                <td>@entry.User</td>
                                                <td>@entry.Field</td>
                                                <td>@entry.Description</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    break;
            }
        </div>
    </div>
}
