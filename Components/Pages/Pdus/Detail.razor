@page "/parc/pdus/{ItemId:int}"
@using GlpiNg.Modules.Inventory.Models
@using GlpiNg.Modules.Inventory.Services
@rendermode InteractiveServer

<PageTitle>@(_item?.Name ?? T("PDU")) — GlpiNg</PageTitle>

@if (_item is null)
{
    <div class="text-center text-secondary py-5">
        <i class="ti ti-plug-off fs-1"></i>
        <p class="mt-2">@T("Ce PDU est introuvable.")</p>
    </div>
}
else
{
    <div class="glping-fiche-topbar">
        <div class="glping-fiche-crumb">
            <i class="ti ti-plug"></i>
            <span>@T("PDU - {0} - ID {1}", _item.Name, _item.Id)</span>
        </div>
        <div class="glping-fiche-toolbar">
            @if (_total > 0)
            {
                <span class="glping-fiche-pager-count">@_position/@_total</span>
                <a class="glping-fiche-pager-btn @(_previousId is null ? "disabled" : "")" href="@(_previousId is { } prevId ? $"/parc/pdus/{prevId}" : "#")">
                    <i class="ti ti-chevron-left"></i>
                </a>
                <a class="glping-fiche-pager-btn @(_nextId is null ? "disabled" : "")" href="@(_nextId is { } nextId ? $"/parc/pdus/{nextId}" : "#")">
                    <i class="ti ti-chevron-right"></i>
                </a>
            }
        </div>
    </div>

    <div class="glping-fiche-layout">
        <aside class="glping-fiche-sidebar">
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "main" ? "active" : "")" @onclick='() => SetTab("main")'>
                <i class="ti ti-plug"></i>
                <span>@T("PDU")</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "history" ? "active" : "")" @onclick='() => SetTab("history")'>
                <i class="ti ti-history"></i>
                <span>@T("Historique")</span>
                <span class="glping-fiche-tab-count">@_item.HistoryEntries.Count</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "management" ? "active" : "")" @onclick='() => SetTab("management")'>
                <i class="ti ti-wallet"></i>
                <span>@T("Gestion")</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "certificates" ? "active" : "")" @onclick='() => SetTab("certificates")'>
                <i class="ti ti-certificate"></i>
                <span>@T("Certificats")</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "domains" ? "active" : "")" @onclick='() => SetTab("domains")'>
                <i class="ti ti-world-www"></i>
                <span>@T("Domaines")</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "applications" ? "active" : "")" @onclick='() => SetTab("applications")'>
                <i class="ti ti-apps"></i>
                <span>@T("Applicatifs")</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "projects" ? "active" : "")" @onclick='() => SetTab("projects")'>
                <i class="ti ti-clipboard-list"></i>
                <span>@T("Projets")</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "tickets" ? "active" : "")" @onclick='() => SetTab("tickets")'>
                <i class="ti ti-ticket"></i>
                <span>@T("Tickets")</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "problems" ? "active" : "")" @onclick='() => SetTab("problems")'>
                <i class="ti ti-alert-triangle"></i>
                <span>@T("Problèmes")</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "changes" ? "active" : "")" @onclick='() => SetTab("changes")'>
                <i class="ti ti-replace"></i>
                <span>@T("Changements")</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "knowbase" ? "active" : "")" @onclick='() => SetTab("knowbase")'>
                <i class="ti ti-book"></i>
                <span>@T("Base de connaissances")</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "impact" ? "active" : "")" @onclick='() => SetTab("impact")'>
                <i class="ti ti-affiliate"></i>
                <span>@T("Analyse d'impact")</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "elements" ? "active" : "")" @onclick='() => SetTab("elements")'>
                <i class="ti ti-device-desktop"></i>
                <span>@T("Éléments")</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "contracts" ? "active" : "")" @onclick='() => SetTab("contracts")'>
                <i class="ti ti-file-text"></i>
                <span>@T("Contrats")</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "documents" ? "active" : "")" @onclick='() => SetTab("documents")'>
                <i class="ti ti-file"></i>
                <span>@T("Documents")</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "notes" ? "active" : "")" @onclick='() => SetTab("notes")'>
                <i class="ti ti-notes"></i>
                <span>@T("Notes")</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "links" ? "active" : "")" @onclick='() => SetTab("links")'>
                <i class="ti ti-external-link"></i>
                <span>@T("Liens externes")</span>
            </button>
        </aside>

        <div class="glping-fiche-panel">
            @switch (_activeTabKey)
            {
                case "main":
                    <EditForm Model="_item" OnValidSubmit="SaveAsync">
                        <PduFormFields Item="_item" StatusOptions="_statusOptions" LocationOptions="_locationOptions" />

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync">
                                <i class="ti ti-trash me-1"></i>@T("Supprimer définitivement")
                            </button>
                            <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? T("Enregistrement…") : T("Sauvegarder"))
                            </button>
                        </div>
                    </EditForm>
                    break;

                case "history":
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-history"></i>@T("Historique ({0})", _item.HistoryEntries.Count)</div>
                        @if (_item.HistoryEntries.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-history"></i>
                                <p class="mb-0">@T("Aucune modification enregistrée.")</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("ID")</th>
                                            <th>@T("Date")</th>
                                            <th>@T("Utilisateur")</th>
                                            <th>@T("Champ")</th>
                                            <th>@T("Mise à jour")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (PduHistoryEntry entry in Display.Chronological(_item.HistoryEntries, e => e.OccurredAt))
                                        {
                                            <tr>
                                                <td>@entry.Id</td>
                                                <td>@Display.DateTime(entry.OccurredAt)</td>
                                                <td>@entry.User</td>
                                                <td>@entry.Field</td>
                                                <td>@entry.Description</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    break;

                case "management":
                    <ItemManagementTab ItemType="@GlpiNg.Modules.Abstractions.Items.ItemTypes.Pdu" ItemId="ItemId" />
                    break;

                case "certificates":
                    <ItemRelationsTab ItemType="@GlpiNg.Modules.Abstractions.Items.ItemTypes.Pdu" ItemId="ItemId" Relation="@GlpiNg.Modules.Abstractions.Items.ItemRelationKinds.Certificate" />
                    break;

                case "domains":
                    <ItemRelationsTab ItemType="@GlpiNg.Modules.Abstractions.Items.ItemTypes.Pdu" ItemId="ItemId" Relation="@GlpiNg.Modules.Abstractions.Items.ItemRelationKinds.Domain" />
                    break;

                case "applications":
                    <ItemRelationsTab ItemType="@GlpiNg.Modules.Abstractions.Items.ItemTypes.Pdu" ItemId="ItemId" Relation="@GlpiNg.Modules.Abstractions.Items.ItemRelationKinds.Appliance" />
                    break;

                case "projects":
                    <ItemRelationsTab ItemType="@GlpiNg.Modules.Abstractions.Items.ItemTypes.Pdu" ItemId="ItemId" Relation="@GlpiNg.Modules.Abstractions.Items.ItemRelationKinds.Project" />
                    break;

                case "tickets":
                    <ItemRelationsTab ItemType="@GlpiNg.Modules.Abstractions.Items.ItemTypes.Pdu" ItemId="ItemId" Relation="@GlpiNg.Modules.Abstractions.Items.ItemRelationKinds.Ticket" />
                    break;

                case "problems":
                    <ItemRelationsTab ItemType="@GlpiNg.Modules.Abstractions.Items.ItemTypes.Pdu" ItemId="ItemId" Relation="@GlpiNg.Modules.Abstractions.Items.ItemRelationKinds.Problem" />
                    break;

                case "changes":
                    <ItemRelationsTab ItemType="@GlpiNg.Modules.Abstractions.Items.ItemTypes.Pdu" ItemId="ItemId" Relation="@GlpiNg.Modules.Abstractions.Items.ItemRelationKinds.Change" />
                    break;

                case "knowbase":
                    <ItemRelationsTab ItemType="@GlpiNg.Modules.Abstractions.Items.ItemTypes.Pdu" ItemId="ItemId" Relation="@GlpiNg.Modules.Abstractions.Items.ItemRelationKinds.Knowledge" />
                    break;

                case "impact":
                    <ItemRelationsTab ItemType="@GlpiNg.Modules.Abstractions.Items.ItemTypes.Pdu" ItemId="ItemId" Relation="@GlpiNg.Modules.Abstractions.Items.ItemRelationKinds.Impact" />
                    break;

                case "elements":
                    <ItemAssetsTab ItemType="@GlpiNg.Modules.Abstractions.Items.ItemTypes.Pdu" ItemId="ItemId" Relation="@GlpiNg.Modules.Abstractions.Items.ItemRelationKinds.Pdu" />
                    break;

                case "contracts":
                    <ItemContractsTab ItemType="@GlpiNg.Modules.Abstractions.Items.ItemTypes.Pdu" ItemId="ItemId" />
                    break;

                case "documents":
                    <ItemDocumentsTab ItemType="@GlpiNg.Modules.Abstractions.Items.ItemTypes.Pdu" ItemId="ItemId" />
                    break;

                case "notes":
                    <ItemNotesTab ItemType="@GlpiNg.Modules.Abstractions.Items.ItemTypes.Pdu" ItemId="ItemId" />
                    break;

                case "links":
                    <ExternalLinksPanel ItemType="@ExternalLinkTagSource.PduItemType"
                                        Tags="@ExternalLinkTagSource.For(_item)" />
                    break;
            }
        </div>
    </div>
}
